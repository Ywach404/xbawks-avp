# Upstream checkout is untracked until the vendor/submodule decision in S1.
third_party/xemu/

# Xbox system files and media are user-supplied at runtime, never committed.
*.bin
*.rom
mcpx*
*bios*
*BIOS*
*.qcow2
*.img
*.iso
*.xiso
*.xbe
eeprom*

# The denylist above covers the extracted forms and missed the containers:
# a 7z of an HDD image and a zipped qcow2 both sailed straight past it.
# Nothing legitimate in this repo is an archive, so deny the shape outright.
*.7z
*.zip
*.rar
*.gz
*.xz
*.qcow2.*

# And the drop location itself, belt and braces, since the next thing
# arriving in it may be a shape nobody predicted.
/XEMU Essential/

# Build output
build/
build.log
.build-venv/
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Generated by XcodeGen from project.yml, which is the source of truth.
*.xcodeproj
build.log
build-xros/
build-app/
