+
+static void grab_frame(void)
+{
+    if (qatomic_read(&g_background) || qatomic_read(&g_metal_present)) {
+        return;
+    }
+    /*
+     * Only after the guest has flipped. Asking the NV2A for the surface
+     * forces a GPU to CPU download that stalls the render thread, and
+     * asking thirty times a second for a frame the guest has not changed
+     * is pure stall. The VGA fallback still gets a look once a second.
+     */
+    static int last_flip;
+    static int idle;
+    int flip = nv2a_get_frame_count();
+    if (flip == last_flip && ++idle < 30) {
+        return;
+    }
+    idle = 0;
+    last_flip = flip;
+    nv2a_get_framebuffer_surface();
+    NV2ACpuFramebuffer fb;
+    bool have = nv2a_get_cpu_framebuffer(&fb) && fb.width > 0 &&
+                fb.height > 0 && fb.data;
+    if (have) {
+        publish_frame(fb.data, fb.width, fb.height, fb.stride);
+        g_frames_nv2a++;
+    }
+    nv2a_release_framebuffer_surface();
+
+    if (!have && current_surface &&
+        surface_format(current_surface) == PIXMAN_x8r8g8b8) {
+        publish_frame(surface_data(current_surface),
+                      surface_width(current_surface),
+                      surface_height(current_surface),
+                      surface_stride(current_surface));
+        g_frames_vga++;
+    }
+}
+
+uint64_t xemu_host_frame_take(uint64_t last_seq, void **bgra, int *w, int *h)
+{
+    uint64_t seq = 0;
+    pthread_mutex_lock(&g_frame_lock);
+    if (g_frame_bgra && g_frame_seq != last_seq) {
+        size_t n = (size_t)g_frame_w * 4 * g_frame_h;
+        *bgra = malloc(n);
+        memcpy(*bgra, g_frame_bgra, n);
+        *w = g_frame_w;
+        *h = g_frame_h;
+        seq = g_frame_seq;
+    }
+    pthread_mutex_unlock(&g_frame_lock);
+    return seq;
+}
