+void xemu_host_start_with_disc(const char *filename)
+{
+    fprintf(stderr, "[host] disc chosen: %s\n",
+            filename && filename[0] ? filename : "(none, dashboard)");
+    fflush(stderr);
+    pthread_mutex_lock(&g_disc_mu);
+    g_free(g_selected_disc);
+    g_selected_disc = g_strdup(filename ? filename : "");
+    g_disc_chosen = true;
+    pthread_cond_signal(&g_disc_cv);
+    pthread_mutex_unlock(&g_disc_mu);
+}
