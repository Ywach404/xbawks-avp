+/*
+ * What the Swift entry point sees of the Objective-C shell. Kept to the
+ * two classes it wraps and the one function it calls first.
+ */
+#pragma once
+#import <UIKit/UIKit.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Output redirection, the crash handler, SDL's main-ready flag. Call once,
+ * before UIKit does anything. */
+void xemu_host_prepare(void);
+
+/* Pause the machine and the frame grabs while the app is not in front. */
+void xemu_host_set_background(bool background);
+
+/* Zero-copy presentation. present_frame copies the scanned-out surface
+ * into the Metal texture on the GPU: 1 copied, 0 nothing or size changed
+ * (ask present_size and rebuild), -1 unsupported (use the CPU path). */
+void xemu_host_set_metal_present(bool on);
+
+/* Disc selection. list returns a malloc'd newline separated list of the
+ * .iso/.xiso files in Documents (free it); start_with_disc hands the
+ * chosen filename (or NULL for the dashboard) to the waiting emulator
+ * thread; started says whether that handoff already happened. */
+char *xemu_host_list_discs(void);
