+                        (unsigned long)elapsed,
+                        flips - last_flips, (blocks - last_blocks) / 5,
+                        tcg_nb_tbs(), xemu_host_tb_flush_count(),
+                        (xemu_pusher_bytes - last_push_bytes) / 1024,
+                        (xemu_pusher_bytes - last_push_bytes) / 1024 / 5,
+                        (ts >= 0 && ts < 4) ? thermal[ts] : "?");
+                last_push_bytes = xemu_pusher_bytes;
+                last_flips = flips;
+                last_blocks = blocks;
+            }
+            {
+                /*
+                 * What the guest is reading. A vCPU that is "running" with
+                 * no new code and no frames is polling something; the
+                 * region table says which device, and the address table
+                 * says which register. Printed as deltas, biggest first,
+                 * so the poll target is the first entry.
+                 */
+                static unsigned long last_region[XEMU_IO_REGIONS];
+                static unsigned long last_addr[XEMU_IO_ADDRS];
+                unsigned long d_region[XEMU_IO_REGIONS];
+                unsigned long d_addr[XEMU_IO_ADDRS];
+                int nr = xemu_io_num_regions, na = xemu_io_num_addrs;
+                unsigned long total = 0;
+                for (int i = 0; i < nr; i++) {
+                    unsigned long c = xemu_io_regions[i].count;
+                    d_region[i] = c - last_region[i];
+                    last_region[i] = c;
+                    total += d_region[i];
+                }
+                for (int i = 0; i < na; i++) {
+                    unsigned long c = xemu_io_addrs[i].count;
+                    d_addr[i] = c - last_addr[i];
+                    last_addr[i] = c;
+                }
+                char line[400];
+                int n = 0;
+                for (int k = 0; k < 6; k++) {
+                    int best = -1;
+                    for (int i = 0; i < nr; i++) {
+                        if (d_region[i] && (best < 0 || d_region[i] > d_region[best])) {
+                            best = i;
+                        }
+                    }
+                    if (best < 0) {
+                        break;
+                    }
+                    n += snprintf(line + n, sizeof(line) - n, " %s=%lu",
+                                  xemu_io_regions[best].name, d_region[best]);
+                    d_region[best] = 0;
+                }
+                fprintf(stderr, "[host]   guest reads in 5 s: %lu%s\n",
+                        total, n ? line : " none");
+                n = 0;
+                for (int k = 0; k < 8; k++) {
+                    int best = -1;
+                    for (int i = 0; i < na; i++) {
+                        if (d_addr[i] && (best < 0 || d_addr[i] > d_addr[best])) {
+                            best = i;
+                        }
+                    }
+                    if (best < 0) {
+                        break;
+                    }
+                    n += snprintf(line + n, sizeof(line) - n, " %s+%llx=%lu",
+                                  xemu_io_addrs[best].name,
+                                  (unsigned long long)xemu_io_addrs[best].addr,
+                                  d_addr[best]);
+                    d_addr[best] = 0;
+                }
+                if (n) {
+                    fprintf(stderr, "[host]   top addresses:%s%s\n", line,
+                            xemu_io_addr_overflow ? " (table full)" : "");
+                }
+            }
+            {
+                /*
+                 * The two devices a loading title waits on besides the
+                 * GPU: the APU's frame clock, which every audio notifier
+                 * and FIFO cursor hangs off, and the disc. Both as deltas.
+                 */
+                extern unsigned long xemu_apu_frame_count(void);
+                static unsigned long last_apu;
+                static uint64_t last_cd_ops, last_cd_bytes, last_hd_ops;
+                unsigned long apu = xemu_apu_frame_count();
+                uint64_t cd_ops = 0, cd_bytes = 0, hd_ops = 0;
+                /*
+                 * The backend lookup walks a list that the main thread
+                 * owns and asserts the big lock. Once every five seconds
+                 * the lock is cheap; the pointers are then cached because
+                 * a disc swap replaces the medium, not the backend.
+                 */
+                static BlockBackend *cd, *hd;
+                if (!cd || !hd) {
+                    bql_lock();
+                    cd = blk_by_name("ide0-cd1");
+                    hd = blk_by_name("ide0-hd0");
+                    bql_unlock();
+                }
+                if (cd) {
+                    BlockAcctStats *st = blk_get_stats(cd);
+                    cd_ops = st->nr_ops[BLOCK_ACCT_READ];
+                    cd_bytes = st->nr_bytes[BLOCK_ACCT_READ];
+                }
+                if (hd) {
+                    BlockAcctStats *st = blk_get_stats(hd);
+                    hd_ops = st->nr_ops[BLOCK_ACCT_READ] + st->nr_ops[BLOCK_ACCT_WRITE];
+                }
+                fprintf(stderr, "[host]   apu frames in 5 s: %lu (%lu/s), "
+                                "dvd reads %llu (%llu KB), hdd ops %llu\n",
+                        apu - last_apu, (apu - last_apu) / 5,
+                        (unsigned long long)(cd_ops - last_cd_ops),
+                        (unsigned long long)((cd_bytes - last_cd_bytes) / 1024),
+                        (unsigned long long)(hd_ops - last_hd_ops));
+                {
+                    /*
+                     * Mean service time per command, guest command write to
+                     * completion IRQ, and how often the main loop slept with
+                     * a device timer under 1.25 ms away, and how many of
+                     * those sleeps an fd ended early.
+                     */
+                    extern unsigned long xemu_poll_blind_waits, xemu_poll_fd_wakes;
+                    static uint64_t lcdt, lcdn, lhdt, lhdn;
+                    static unsigned long lbw, lfw;
+                    uint64_t cdt = 0, cdn = 0, hdt = 0, hdn = 0;
+                    if (cd) {
+                        BlockAcctStats *st = blk_get_stats(cd);
+                        cdt = st->total_time_ns[BLOCK_ACCT_READ];
+                        cdn = st->nr_ops[BLOCK_ACCT_READ];
+                    }
+                    if (hd) {
+                        BlockAcctStats *st = blk_get_stats(hd);
+                        hdt = st->total_time_ns[BLOCK_ACCT_READ] + st->total_time_ns[BLOCK_ACCT_WRITE];
+                        hdn = st->nr_ops[BLOCK_ACCT_READ] + st->nr_ops[BLOCK_ACCT_WRITE];
+                    }
+                    fprintf(stderr, "[host]   drive service: dvd %llu us/op, hdd %llu us/op; "
+                                    "short sleeps %lu, ended by fd %lu\n",
+                            (unsigned long long)(cdn - lcdn ? (cdt - lcdt) / (cdn - lcdn) / 1000 : 0),
+                            (unsigned long long)(hdn - lhdn ? (hdt - lhdt) / (hdn - lhdn) / 1000 : 0),
+                            xemu_poll_blind_waits - lbw, xemu_poll_fd_wakes - lfw);
+                    lcdt = cdt; lcdn = cdn; lhdt = hdt; lhdn = hdn;
+                    lbw = xemu_poll_blind_waits; lfw = xemu_poll_fd_wakes;
+                }
+                last_apu = apu;
+                last_cd_ops = cd_ops;
+                last_cd_bytes = cd_bytes;
+                last_hd_ops = hd_ops;
+            }
+            {
+                /*
+                 * The two things that write into guest RAM for a waiting
+                 * guest to see, and the FIFO's own stall state. A spin on
+                 * RAM with both writers quiet and a stalled pusher is one
+                 * story; with the writers active it is another.
+                 */
+                extern unsigned long xemu_apu_notifies;
+                extern void pfifo_state_line(char *buf, size_t len);
+                static unsigned long last_notify;
+                char fifo[300];
+                pfifo_state_line(fifo, sizeof(fifo));
+                {
+                    /* New shaders and pipelines this window, with the time
+                     * the render thread spent building them, and the cache
+                     * on disk. */
+                    extern unsigned long xemu_vk_glsl_compiles, xemu_vk_glsl_ns;
+                    extern unsigned long xemu_vk_pipelines_built, xemu_vk_pipeline_ns;
+                    extern unsigned long xemu_vk_cache_saves, xemu_vk_cache_bytes;
+                    static unsigned long lg, lgn, lp, lpn;
+                    fprintf(stderr, "[host]   shaders in 5 s: %lu compiled (%lu ms), "
+                                    "pipelines %lu built (%lu ms); cache %lu KB, %lu saves\n",
+                            xemu_vk_glsl_compiles - lg, (xemu_vk_glsl_ns - lgn) / 1000000,
+                            xemu_vk_pipelines_built - lp, (xemu_vk_pipeline_ns - lpn) / 1000000,
+                            xemu_vk_cache_bytes / 1024, xemu_vk_cache_saves);
+                    lg = xemu_vk_glsl_compiles; lgn = xemu_vk_glsl_ns;
+                    lp = xemu_vk_pipelines_built; lpn = xemu_vk_pipeline_ns;
+                }
+                fprintf(stderr, "[host]   apu notifies in 5 s: %lu; fifo: %s\n",
+                        xemu_apu_notifies - last_notify, fifo);
+                last_notify = xemu_apu_notifies;
+            }
+            {
+                /*
+                 * The drives, the audio front end, and how often the vCPU
+                 * halted. An idle guest halts at its interrupt rate; a
+                 * guest waiting on a drive shows the command still posted.
+                 */
+                extern void xemu_ide_state_line(BlockBackend *blk, char *buf, size_t len);
+                extern void xemu_apu_state_line(char *buf, size_t len);
+                extern unsigned long xemu_halts;
+                static unsigned long last_halts;
+                char cdl[200] = "none", hdl[200] = "none", apul[200];
+                bql_lock();
+                BlockBackend *cd2 = blk_by_name("ide0-cd1");
+                BlockBackend *hd2 = blk_by_name("ide0-hd0");
+                if (cd2) {
+                    xemu_ide_state_line(cd2, cdl, sizeof(cdl));
+                }
+                if (hd2) {
+                    xemu_ide_state_line(hd2, hdl, sizeof(hdl));
+                }
+                /*
+                 * Per title report policy. Blinx reads its occlusion
+                 * results a few ms after issuing them, in the same frame,
+                 * without waiting for them; with x87 on host doubles that
+                 * gap is shorter than any idle rule can confirm, and its
+                 * enemies flicker. Halo goes idle at every queue depth
+                 * Blinx does (2 to 17+ against Blinx's 9 to 17+), so no
+                 * general rule separates them, and draining every idle
+                 * costs Halo most of its frame rate. Blinx alone drains
+                 * on every idle. Documents/report-always content 1 forces
+                 * it for every title.
+                 */
+                {
+                    extern bool xemu_report_always;
+                    static bool forced, checked;
+                    static uint32_t last_tid = 1;
+                    if (!checked) {
+                        g_autofree char *ap = g_strdup_printf(
+                            "%s/Documents/report-always", getenv("HOME"));
+                        g_autofree char *ac = NULL;
+                        forced = g_file_get_contents(ap, &ac, NULL, NULL) &&
+                                 ac[0] == '1';
+                        checked = true;
+                    }
+                    struct xbe *xbe = xemu_get_xbe_info();
+                    uint32_t tid = (xbe && xbe->cert) ?
+                        ldl_le_p(&xbe->cert->m_titleid) : 0;
+                    if (tid != last_tid) {
+                        char name[41] = "";
+                        if (xbe && xbe->cert) {
+                            g_autofree char *n = g_utf16_to_utf8(
+                                xbe->cert->m_title_name, 40, NULL, NULL, NULL);
+                            if (n) {
+                                g_strlcpy(name, n, sizeof(name));
+                            }
+                        }
+                        bool blinx = tid == 0x4d530013; /* "BLiNX: the time sweeper" */
+                        xemu_report_always = forced || blinx;
+                        fprintf(stderr, "[host] title %08x \"%s\": reports %s\n",
+                                tid, name, xemu_report_always
+                                ? "drain on every idle" : "waiting rule");
+                        last_tid = tid;
+                    }
+                }
+                bql_unlock();
+                xemu_apu_state_line(apul, sizeof(apul));
+                unsigned long ists_reads = 0, ien_reads = 0;
+                for (int i = 0; i < xemu_io_num_addrs; i++) {
+                    if (xemu_io_addrs[i].addr == 0xfe801000) {
+                        ists_reads = xemu_io_addrs[i].count;
+                    } else if (xemu_io_addrs[i].addr == 0xfe801004) {
+                        ien_reads = xemu_io_addrs[i].count;
+                    }
+                }
+                fprintf(stderr, "[host]   halts in 5 s: %lu; dvd: %s; hdd: %s\n",
+                        xemu_halts - last_halts, cdl, hdl);
+                fprintf(stderr, "[host]   apu: %s; ists reads total %lu, ien %lu\n",
+                        apul, ists_reads, ien_reads);
+                last_halts = xemu_halts;
+            }
+            {
+                /*
+                 * Where the guest was when interrupts arrived, hottest
+                 * first, with the code and registers at the hottest one.
+                 * During a spin the loop is at the top of this list.
+                 */
+                static unsigned long last_pc_count[XEMU_IRQ_PCS];
+                static uint32_t last_pc_key[XEMU_IRQ_PCS];
+                unsigned long d[XEMU_IRQ_PCS];
+                int n = xemu_irq_num_pcs;
+                for (int i = 0; i < n; i++) {
+                    unsigned long c = xemu_irq_pcs[i].count;
+                    uint32_t pc = xemu_irq_pcs[i].pc;
+                    d[i] = (last_pc_key[i] == pc) ? c - last_pc_count[i] : c;
+                    last_pc_count[i] = c;
+                    last_pc_key[i] = pc;
+                }
+                char line[400];
+                int o = 0, top = -1;
+                for (int k = 0; k < 5; k++) {
+                    int best = -1;
+                    for (int i = 0; i < n; i++) {
+                        if (d[i] && (best < 0 || d[i] > d[best])) {
+                            best = i;
+                        }
+                    }
+                    if (best < 0) {
+                        break;
+                    }
+                    if (top < 0) {
+                        top = best;
+                    }
+                    o += snprintf(line + o, sizeof(line) - o, " %08x=%lu",
+                                  xemu_irq_pcs[best].pc, d[best]);
+                    d[best] = 0;
+                }
+                fprintf(stderr, "[host]   interrupted at:%s\n", o ? line : " nothing");
+                if (top >= 0 && first_cpu) {
+                    uint8_t code[32];
+                    char hex[sizeof(code) * 2 + 1] = "unreadable";
+                    uint32_t pc = xemu_irq_pcs[top].pc;
+                    if (cpu_memory_rw_debug(first_cpu, pc, code, sizeof(code), false) == 0) {
+                        for (size_t i = 0; i < sizeof(code); i++) {
+                            snprintf(hex + i * 2, 3, "%02x", code[i]);
+                        }
+                    }
+                    const uint32_t *r = xemu_irq_pcs[top].regs;
+                    fprintf(stderr, "[host]   code at %08x: %s\n", pc, hex);
+                    /* And the 48 bytes before it: a loop's head is behind
+                     * the address interrupts land on. */
+                    uint8_t before[48];
+                    if (pc >= sizeof(before) &&
+                        cpu_memory_rw_debug(first_cpu, pc - sizeof(before), before, sizeof(before), false) == 0) {
+                        char bhex[sizeof(before) * 2 + 1];
+                        for (size_t i = 0; i < sizeof(before); i++) {
+                            snprintf(bhex + i * 2, 3, "%02x", before[i]);
+                        }
+                        fprintf(stderr, "[host]   code at %08x: %s\n", pc - (uint32_t)sizeof(before), bhex);
+                    }
+                    fprintf(stderr, "[host]   regs: eax=%08x ecx=%08x edx=%08x ebx=%08x "
+                                    "esp=%08x ebp=%08x esi=%08x edi=%08x\n",
+                            r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]);
+                }
+            }
+            {
+                /*
+                 * Guest memory on request. Documents/peek holds one
+                 * "hexaddr [bytes]" per line; each tick dumps them. The
+                 * file is pushed from the Mac, so a new address costs a
+                 * copy, not a build.
+                 */
+                g_autofree char *path = g_strdup_printf("%s/Documents/peek", getenv("HOME"));
+                g_autofree char *text = NULL;
+                if (first_cpu && g_file_get_contents(path, &text, NULL, NULL)) {
+                    char **lines = g_strsplit(text, "\n", -1);
+                    for (int li = 0; lines[li]; li++) {
+                        unsigned long long addr = 0;
+                        unsigned len = 64;
+                        if (sscanf(lines[li], "%llx %u", &addr, &len) < 1 || len == 0) {
+                            continue;
+                        }
+                        if (len > 256) {
+                            len = 256;
+                        }
+                        uint8_t buf[256];
+                        if (cpu_memory_rw_debug(first_cpu, addr, buf, len, false) != 0) {
+                            fprintf(stderr, "[host]   peek %08llx: unreadable\n", addr);
+                            continue;
+                        }
+                        char hex[256 * 2 + 1];
+                        for (unsigned i = 0; i < len; i++) {
+                            snprintf(hex + i * 2, 3, "%02x", buf[i]);
+                        }
+                        fprintf(stderr, "[host]   peek %08llx: %s\n", addr, hex);
+                    }
+                    g_strfreev(lines);
+                }
+            }
+            {
+                size_t where = 0;
+                int same = tcg_splitwx_views_match(64 * 1024, &where);
+                fprintf(stderr, "[host]   splitwx views: %s%s\n",
+                        same == 1 ? "MATCH" : same == 0 ? "DIVERGED" : "n/a",
+                        same == 0 ? "" : "");
+                if (same == 0) {
+                    fprintf(stderr, "[host]   first difference at byte %zu\n",
+                            where);
+                }
+            }
+        }
+
+        /*
+         * Take a frame from here, with no BQL, the way the desktop shell's
+         * window thread does. Get, copy the pixels out, release, and only
+         * then encode: the pointer is valid until the guest draws again,
+         * and a second get without a release trips an assert in pgraph
+         * (that was the signal 6 of 2026-10-26).
+         */
+        /*
+         * The thread dump and the execute probe that lived here at 20 to
+         * 23 seconds found the JIT answer and are retired: suspending
+         * every thread, the main one included, is also exactly when the
+         * immersive space was lost in two runs (2026-10-29).
+         */
+
+        if (shot && elapsed == after) {
+            nv2a_get_framebuffer_surface();
+            NV2ACpuFramebuffer fb;
+            bool have = nv2a_get_cpu_framebuffer(&fb);
+            uint8_t *copy = NULL;
+            if (have && fb.width > 0 && fb.height > 0 && fb.data) {
+                size_t row = (size_t)fb.width * 4;
+                copy = g_malloc(row * fb.height);
+                for (int y = 0; y < fb.height; y++) {
+                    memcpy(copy + y * row,
+                           (const uint8_t *)fb.data + (size_t)y * fb.stride,
+                           row);
+                }
+                fb.data = copy;
+                fb.stride = (int)row;
+            }
+            nv2a_release_framebuffer_surface();
+
+            if (!copy) {
+                fprintf(stderr, "[host] t=%3ds frame: nothing published\n",
+                        elapsed);
+            } else if (write_framebuffer_png(&fb, shot)) {
+                fprintf(stderr, "[host] t=%3ds frame: wrote %dx%d\n",
+                        elapsed, fb.width, fb.height);
+            } else {
+                fprintf(stderr, "[host] t=%3ds frame: %dx%d, PNG write "
+                                "FAILED\n", elapsed, fb.width, fb.height);
+            }
+            g_free(copy);
+        }
+    }
+
+    fprintf(stderr, "[host] xemu_host_run: loop ended, exiting=%d, "
+                    "joining qemu thread\n",
+            (int)qatomic_read(&qemu_exiting));
+    qemu_thread_join(&thread);
+    fprintf(stderr, "[host] xemu_host_run: qemu thread joined, status %d\n",
+            exit_status);
+    return exit_status;
+}
