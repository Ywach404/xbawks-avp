+
+/* ------------------------------------------------------------------ */
+/* Framebuffer out                                                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Writes a copy of whatever the guest last drew. The copy is the caller's,
+ * made while the NV2A held the surface for us, so nothing here touches the
+ * machine and nothing here blocks it.
+ */
+static bool write_framebuffer_png(const NV2ACpuFramebuffer *fb, const char *path)
+{
+    int w = fb->width;
+    int h = fb->height;
+    int stride = fb->stride;
+    const uint8_t *src = fb->data;
+    if (w <= 0 || h <= 0 || !src) {
+        return false;
+    }
+
+    /*
+     * The guest framebuffer is 32bpp little-endian x8r8g8b8, which is BGRA
+     * in memory order. Pack it down to tight RGB, which is what fpng wants
+     * and which also drops the stride padding.
+     */
+    uint8_t *rgb = g_malloc((size_t)3 * w * h);
+    for (int y = 0; y < h; y++) {
+        const uint8_t *p = src + (size_t)y * stride;
+        uint8_t *o = rgb + (size_t)3 * w * y;
+        for (int x = 0; x < w; x++) {
+            o[3 * x + 0] = p[4 * x + 2];
+            o[3 * x + 1] = p[4 * x + 1];
+            o[3 * x + 2] = p[4 * x + 0];
+        }
+    }
+
+    bool ok = xemu_host_write_png(path, rgb, w, h);
+    g_free(rgb);
+    if (!ok) {
+        return false;
+    }
+
+    fprintf(stderr, "[xemu-host] wrote %s (%dx%d)\n", path, w, h);
+    return true;
+}
