+/*
+ * Xbawks console editions: the looks the console in the room can wear.
+ *
+ * One entry per distinct look of the original Xbox chassis, stock and
+ * promotional. A look is the shell's colour, opacity and finish; editions
+ * that differ only by print, a signature or the jewel are folded into the
+ * look they share and named in its note. Printed and airbrushed one-offs
+ * are left out, because only colour, opacity, finish and glow can change,
+ * and so are the units that are not Xbox shaped (the Alpha towers, Big X).
+ *
+ * Colours are estimates from collector descriptions (consolevariations.com
+ * and others), not samples from photos.
+ *
+ * Foundation only, so the table and the classifiers below can be tested on
+ * the Mac: tests/xbawks/test_editions.swift.
+ */
+import Foundation
+
+enum EditionGroup: String, CaseIterable {
+    case retail, limited, promotional, developer
+
+    var title: String {
+        switch self {
+        case .retail: return "Retail"
+        case .limited: return "Limited"
+        case .promotional: return "Promotional"
+        case .developer: return "Developer"
+        }
+    }
+}
+
+enum Finish: Equatable {
+    case matte, gloss
+}
+
+struct Edition: Identifiable, Equatable {
+    let id: String
+    let name: String
+    let group: EditionGroup
+    let year: String
+    let note: String
+    let shell: UInt32
+    let opacity: Float
+    let finish: Finish
+    let jewel: UInt32
+    let ring: UInt32
+    let trim: UInt32
+    /// What shows inside a see-through shell under light; nil when opaque.
+    let glow: UInt32?
+
+    var seeThrough: Bool { opacity < 1 }
+}
+
