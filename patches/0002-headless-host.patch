+struct LauncherView: View {
+    @Environment(\.openImmersiveSpace) private var openImmersive
+    @Environment(\.dismissWindow) private var dismissWindow
+    @State private var status = ""
+    @State private var discs: [DiscEntry] = []
+    @State private var selected = 0
+    @State private var started = xemu_host_started()
+
+    var body: some View {
+        ZStack {
+            // Translucent green, over the system glass rather than instead of
+            // it, so the window still reads as a visionOS window.
+            XbawksTheme.deepGreen.opacity(0.55).ignoresSafeArea()
+
+            VStack(spacing: 18) {
+                Text("XBAWKS")
+                    .font(XbawksTheme.face(34, .bold))
+                    .foregroundStyle(XbawksTheme.green)
+                    .tracking(8)
+                    .shadow(color: XbawksTheme.green.opacity(0.5), radius: 12)
+
+                if started {
+                    /*
+                     * Summoned from the console mid session. The deck is
+                     * the same one, so a swap looks exactly like the first
+                     * choice did, and the screen is still running behind
+                     * this window the whole time.
+                     */
+                    Text(status).font(XbawksTheme.face(13))
+                        .foregroundStyle(.secondary)
+
+                    DiscCoverFlow(discs: discs, selectedIndex: $selected)
+
+                    HStack(spacing: 18) {
+                        Button {
+                            swap(discs.indices.contains(selected)
+                                 ? discs[selected] : nil)
+                        } label: {
+                            Text("SWAP DISC")
+                                .font(XbawksTheme.face(16, .bold))
+                                .tracking(3)
+                                .padding(.horizontal, 26).padding(.vertical, 6)
+                        }
+                        .tint(XbawksTheme.dimGreen)
+                        .disabled(discs.indices.contains(selected)
+                                  && discs[selected].isDashboard)
+
+                        Button {
+                            xemu_host_eject_disc()
+                            back()
+                        } label: {
+                            Text("EJECT")
+                                .font(XbawksTheme.face(16, .bold))
+                                .tracking(3)
+                                .padding(.horizontal, 26).padding(.vertical, 6)
+                        }
+                        .tint(XbawksTheme.dimGreen)
+                    }
+
+                    Text("Swapping resets the console, because it reads its "
+                         + "disc when it boots. Eject just opens the tray.")
+                        .font(XbawksTheme.face(11))
+                        .foregroundStyle(.secondary)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal, 40)
+
+                    Button(XemuHostApp.spaceIsOpen ? "Back to the game"
+                                                   : "Resume") {
+                        if XemuHostApp.spaceIsOpen {
+                            back()
+                        } else {
+                            Task { await open() }
+                        }
+                    }
+                    .font(XbawksTheme.face(11))
+                    .buttonStyle(.plain)
+                    .foregroundStyle(XbawksTheme.green.opacity(0.8))
+                } else {
+                    DiscCoverFlow(discs: discs, selectedIndex: $selected)
+
+                    Button {
+                        Task { await start(discs.indices.contains(selected)
+                                           ? discs[selected] : nil) }
+                    } label: {
+                        Text(discs.indices.contains(selected) && discs[selected].isDashboard
+                             ? "BOOT DASHBOARD" : "INSERT DISC")
+                            .font(XbawksTheme.face(16, .bold))
+                            .tracking(3)
+                            .padding(.horizontal, 26).padding(.vertical, 6)
+                    }
+                    .tint(XbawksTheme.dimGreen)
+                    .disabled(discs.isEmpty)
+
+                    Text("Discs go in Files, under XBAWKS then GAMES. "
+                         + "A .jpg or .png with the same name is its cover.")
+                        .font(XbawksTheme.face(11))
+                        .foregroundStyle(.secondary)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal, 40)
+
+                    Button("Rescan") { rescan() }
+                        .font(XbawksTheme.face(11))
+                        .buttonStyle(.plain)
+                        .foregroundStyle(XbawksTheme.green.opacity(0.8))
+                }
+            }
+            .padding(.vertical, 28)
+        }
+        .task {
+            rescan()
+            /*
+             * The screen opens straight away, so the console is in the
+             * room while a game is being chosen rather than appearing
+             * only once one has been. This window stays up on top of it,
+             * which is what we want during selection anyway: a controller
+             * belongs to the window being looked at.
+             *
+             * Not if it is already open. Summoned from the console mid
+             * session, opening it again either fails or dismisses the
+             * window that was just asked for.
+             */
+            if !XemuHostApp.spaceIsOpen {
+                let result = await openImmersive(id: "screen")
+                fputs("[host] launcher: screen \(result)\n", stderr)
+                fflush(stderr)
+            }
+        }
+    }
+
+    private func rescan() {
+        started = xemu_host_started()
+        discs = DiscLibrary.scan()
+        if selected >= discs.count { selected = max(0, discs.count - 1) }
+    }
+
+    @MainActor private func start(_ disc: DiscEntry?) async {
+        let name = (disc?.isDashboard ?? true) ? nil : disc?.id
+        fputs("[host] launcher: start requested, disc=\(name ?? "dashboard")\n",
+              stderr)
+        fflush(stderr)
+        // Explicit, rather than relying on Swift bridging an optional String
+        // into a const char *. If that bridge quietly produced NULL the app
+        // would sit forever on the picker with no sign of why, which is what
+        // it did.
+        if let name {
+            name.withCString { xemu_host_start_with_disc($0) }
+        } else {
+            xemu_host_start_with_disc(nil)
+        }
+        started = true
+        if XemuHostApp.spaceIsOpen {
+            dismissWindow(id: "launcher")
+        } else {
+            await open()
+        }
+    }
+
+    /// Hand the swap to C and get out of the way. The window has to go,
+    /// not just lose focus: a controller belongs to the app only while no
+    /// window of the app is being looked at.
+    @MainActor private func swap(_ disc: DiscEntry?) {
+        guard let disc, !disc.isDashboard else { return }
+        disc.id.withCString { xemu_host_load_disc($0) }
+        back()
+    }
+
+    @MainActor private func back() {
+        if XemuHostApp.spaceIsOpen {
+            dismissWindow(id: "launcher")
+        } else {
+            Task { await open() }
+        }
+    }
+
+    @MainActor private func open() async {
+        let result = await openImmersive(id: "screen")
+        fputs("[host] launcher: immersive space \(result)\n", stderr); fflush(stderr)
+        switch result {
+        case .opened: dismissWindow(id: "launcher")
+        default: status = "could not open the screen (\(result)); try Resume"
+        }
+    }
+}
