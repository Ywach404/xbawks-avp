                                         hwaddr addr,
                                         uint64_t *pval,
@@ -1482,6 +1538,13 @@ MemTxResult memory_region_dispatch_read(MemoryRegion *mr,
         return MEMTX_DECODE_ERROR;
     }
 
+    /*
+     * A sub-page region arrives twice on the TCG path: once as the page's
+     * subpage container, then again as the real region. Count the second.
+     */
+    if (!mr->subpage) {
+        xemu_io_note_read(mr, addr);
+    }
     r = memory_region_dispatch_read1(mr, addr, pval, size, attrs);
     adjust_endianness(mr, pval, op);
     return r;
