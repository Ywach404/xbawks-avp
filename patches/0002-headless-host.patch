-    /* Map the read-write portion via normal anon memory. */
+#if (TARGET_OS_VISION || TARGET_OS_IOS) && defined(__aarch64__)
+    /*
+     * UTM's order, exactly, because UTM's QEMU runs with JIT on this very
+     * headset: the base anonymous mapping is R+X, the remap is made and
+     * set R+X as upstream does, the debugger prepares the remap while no
+     * writable mapping of those pages exists, and only then is the base
+     * made writable. The rules from the people who found them: only a
+     * mapping that already allows execute, and that the debugger wrote to
+     * while attached, runs code; the app's own writable memory can never
+     * become executable; writable views of prepared memory can be made at
+     * any time. The upstream order starts from writable memory and on
+     * device parks the vCPU on the first prologue instruction forever
+     * (measured 2026-10-29).
+     */
