+// The entry point, and now the screen.
+//
+// Measured on 2026-10-29: a spatial controller (the PSVR2 Sense pair)
+// delivers buttons and sticks to an app only while an immersive space is
+// open, and only while the user is not looking at one of the app's
+// windows; gaze on a window turns the controller back into that window's
+// pointer. So there is no window. The app launches straight into a mixed
+// immersive space and the guest's frame is a plane in it, textured from
+// the same BGRA copies the sampler publishes. Everything else stays in
+// the Objective-C shell, reached through xemu-host-bridge.h.
+import SwiftUI
+import RealityKit
+import Metal
+
+@main struct XemuHostApp: App {
+    @UIApplicationDelegateAdaptor(XemuHostAppDelegate.self) var delegate
+
+    /// Reads the controllers on a display link. It is a view controller
+    /// because it was one when the frame lived in a window; its view is
+    /// never shown now and the display link does not care.
+    nonisolated(unsafe) static var ticker: XemuScreenViewController?
+
+    /*
+     * Whether the screen is up. The launcher is rebuilt from scratch every
+     * time it is summoned, so it cannot remember this itself, and it needs
+     * to know: reopening the window to swap a disc must not try to open a
+     * space that is already open.
+     */
+    @MainActor static var spaceIsOpen = false
+
+    init() {
+        xemu_host_prepare()
+        let vc = XemuScreenViewController()
+        vc.loadViewIfNeeded()
+        XemuHostApp.ticker = vc
+    }
+
+    var body: some SwiftUI.Scene {
+        /*
+         * The default scene, and the only window: a small launcher that
+         * opens the space and dismisses itself. It exists so the app has
+         * something the system can bring back when its icon is tapped
+         * after the space was dismissed (found by the owner: without it
+         * the app could not be reopened), and it is gone while playing so
+         * there is nothing of the app's to look at.
+         */
+        /*
+         * Window and not WindowGroup. A WindowGroup is a template the
+         * system will happily instantiate again every time openWindow is
+         * called, so pressing the console twice gave two decks, and ten
+         * times gave ten. Window is a single instance by definition: the
+         * second openWindow brings the existing one forward instead of
+         * making another. The framework enforces it, so no bookkeeping
+         * here can drift out of step with reality.
+         */
+        Window("XBAWKS", id: "launcher") {
+            LauncherView()
+        }
+        .defaultSize(width: 760, height: 620)
+
+        ImmersiveSpace(id: "screen") {
+            ScreenSpace()
+                .onAppear {
+                    XemuHostApp.spaceIsOpen = true
+                    fputs("[host] immersive space appeared\n", stderr); fflush(stderr)
+                }
+                .onDisappear {
+                    XemuHostApp.spaceIsOpen = false
+                    fputs("[host] immersive space disappeared\n", stderr); fflush(stderr)
+                }
+        }
+        .immersionStyle(selection: .constant(.mixed), in: .mixed)
+    }
+}
