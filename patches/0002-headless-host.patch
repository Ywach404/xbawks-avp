+/*
+ * xemu-host.c -- the emulator without a desktop.
+ *
+ * Copyright (C) 2026 A. Cervantez
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * This replaces ui/xemu.c (an SDL3 window, a GL context and an ImGui menu)
+ * and ui/xui/ (50 files of ImGui) with a display backend that keeps the
+ * framebuffer and hands it to whoever is hosting: a PNG on macOS today, a
+ * visionOS compositor later.
+ *
+ * It is deliberately small. Measuring the symbol boundary rather than
+ * guessing at it showed that the rest of the emulator asks only four things
+ * of the shell it is losing, so only four things are reimplemented here.
+ * Everything else under ui/ stays: QEMU's console, its input stack and its
+ * keymaps are not desktop code, and a host needs all of them.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "qemu/atomic.h"
+#include "qemu/rcu.h"
+#ifdef __APPLE__
+#include <mach/mach.h>
+#endif
+#include "system/system.h"
+#include "system/runstate.h"
+#include "ui/console.h"
+#include "ui/surface.h"
+#include "hw/xbox/nv2a/nv2a.h"
+#include "hw/core/cpu.h"
+#include "exec/cpu-common.h"
+#include "block/aio.h"
+#include "tcg/startup.h"
+
+#include "xemu-settings.h"
+#include "xemu-input.h"
+#include "xemu-version.h"
+#include "xemu-notifications.h"
+#include "xemu-snapshots.h"
+
+const char *xemu_host_bundle_path(void);
+extern int xemu_host_stage;
+int tcg_splitwx_views_match(size_t n, size_t *first_diff);
+/* ui/xemu-host-ios.m: every thread's stack, for a machine that is stuck. */
+void xemu_host_dump_threads(const char *why);
+void xemu_host_describe_page(const char *what, const void *addr);
+void xemu_host_exec_probe(void *rw, void *rx);
+int tcg_splitwx_scratch(void **rw, void **rx, size_t *len, void **rx_base);
+
+#include <locale.h>
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
+
+/* ui/xemu-host-png.cc, because fpng's API is C++ */
+bool xemu_host_write_png(const char *path, const void *rgb, int w, int h);
+
+/*
+ * Resident footprint, the number jetsam judges. The first guest block ran
+ * at 5119 MiB and the process died before the sixty-fifth, so where that
+ * memory comes from is the question, and these prints bisect startup.
+ */
+unsigned long long xemu_host_footprint_mib(void)
+{
+#ifdef __APPLE__
+    task_vm_info_data_t vm;
+    mach_msg_type_number_t cnt = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm, &cnt)
+        == KERN_SUCCESS) {
+        return vm.phys_footprint >> 20;
+    }
+#endif
+    return 0;
+}
+
+static void footprint(const char *where)
+{
+    fprintf(stderr, "[host] footprint %s: %llu MiB\n", where,
+            xemu_host_footprint_mib());
+    fflush(stderr);
+}
+
+/*
+ * A ticker, so the jump lines up against whatever device was printing
+ * at the time. Only speaks when the number moves by more than 16 MiB.
+ */
+static void *footprint_ticker(void *unused)
+{
+    (void)unused;
+    unsigned long long last = 0;
+    for (int i = 0; i < 40 * 4; i++) {
+        unsigned long long now = xemu_host_footprint_mib();
+        if (now > last + 16 || now + 16 < last) {
+            fprintf(stderr, "[host] fp t=%.2fs: %llu MiB\n", i * 0.25, now);
+            fflush(stderr);
+            last = now;
+        }
+        g_usleep(250 * 1000);
+    }
+    return NULL;
+}
+
+/*
+ * The latest frame, for whoever presents it. The sampler publishes a
+ * tightly packed BGRA copy thirty times a second; the UI takes a copy of
+ * that when the sequence number moves. Two copies per frame is nothing at
+ * 640x480 and it keeps every lock short.
+ */
+static DisplaySurface *current_surface;   /* set by host_gfx_switch below */
+uint64_t xemu_host_frame_take(uint64_t last_seq, void **bgra, int *w, int *h);
+void xemu_host_pad_set(uint16_t buttons, const int16_t axis[6]);
+void xemu_host_set_background(bool background);
+void xemu_host_set_metal_present(bool on);
+int xemu_host_present_frame(void *mtl_texture, int w, int h);
+bool xemu_host_present_size(int *w, int *h);
+int xemu_host_guest_flips(void);
+extern unsigned long xemu_host_blocks_executed;
+unsigned xemu_host_tb_flush_count(void);
+size_t tcg_nb_tbs(void);
+static pthread_mutex_t g_frame_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t *g_frame_bgra;
+static int g_frame_w, g_frame_h;
+static uint64_t g_frame_seq;
+static uint64_t g_frames_vga, g_frames_nv2a;
+
+static void publish_frame(const uint8_t *src, int w, int h, int stride)
+{
+    size_t row = (size_t)w * 4;
+    uint8_t *copy = g_malloc(row * h);
+    for (int y = 0; y < h; y++) {
+        memcpy(copy + y * row, src + (size_t)y * stride, row);
+    }
+    pthread_mutex_lock(&g_frame_lock);
+    g_free(g_frame_bgra);
+    g_frame_bgra = copy;
+    g_frame_w = w;
+    g_frame_h = h;
+    g_frame_seq++;
+    pthread_mutex_unlock(&g_frame_lock);
+}
+
+/*
+ * Ask the NV2A for the scanned-out surface, the way the desktop shell's
+ * window thread does every frame: get, copy, release. When nothing is in
+ * the surface cache (the guest is drawing with the CPU, or has not drawn
+ * yet) fall back to the VGA surface QEMU keeps for us.
+ */
+/*
+ * Foreground and background. A backgrounded app on this OS loses the GPU,
+ * and the renderer's next command buffer then fails with the device lost
+ * for good (measured 2026-10-29: VK_ERROR_DEVICE_LOST, "insufficient
+ * permission", then an assert in pgraph_vk_finish). So the machine is
+ * paused and the frame grabs stop the moment the system says the app is
+ * leaving, and both resume on return. The stop and start run on the main
+ * loop thread with the BQL, where they belong.
+ */
+static bool g_background;
+
+static void pause_bh(void *opaque)
+{
+    bool pause = (bool)(uintptr_t)opaque;
+    if (pause && runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+        fprintf(stderr, "[host] machine paused for the background\n");
+    } else if (!pause && !runstate_is_running()) {
+        vm_start();
+        fprintf(stderr, "[host] machine resumed\n");
+    }
+    fflush(stderr);
+}
+
+void xemu_host_set_background(bool background)
+{
+    qatomic_set(&g_background, background);
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), pause_bh,
+                            (void *)(uintptr_t)background);
+}
+
+static bool g_metal_present;
+
+/* The screen presents straight from the GPU; the CPU grab stands down. */
+void xemu_host_set_metal_present(bool on)
+{
+    qatomic_set(&g_metal_present, on);
+    fprintf(stderr, "[host] presentation: %s\n", on ? "zero-copy" : "CPU copy");
+    fflush(stderr);
+}
+
+int xemu_host_present_frame(void *mtl_texture, int w, int h)
+{
+    if (qatomic_read(&g_background)) {
+        return 0;
+    }
+    return nv2a_present_to_metal(mtl_texture, w, h);
+}
+
+bool xemu_host_present_size(int *w, int *h)
+{
+    return nv2a_present_size(w, h);
+}
+
+int xemu_host_guest_flips(void)
+{
+    return nv2a_get_frame_count();
+}
+
+static void grab_frame(void)
+{
+    if (qatomic_read(&g_background) || qatomic_read(&g_metal_present)) {
+        return;
+    }
+    /*
+     * Only after the guest has flipped. Asking the NV2A for the surface
+     * forces a GPU to CPU download that stalls the render thread, and
+     * asking thirty times a second for a frame the guest has not changed
+     * is pure stall. The VGA fallback still gets a look once a second.
+     */
+    static int last_flip;
+    static int idle;
+    int flip = nv2a_get_frame_count();
+    if (flip == last_flip && ++idle < 30) {
+        return;
+    }
+    idle = 0;
+    last_flip = flip;
+    nv2a_get_framebuffer_surface();
+    NV2ACpuFramebuffer fb;
+    bool have = nv2a_get_cpu_framebuffer(&fb) && fb.width > 0 &&
+                fb.height > 0 && fb.data;
+    if (have) {
+        publish_frame(fb.data, fb.width, fb.height, fb.stride);
+        g_frames_nv2a++;
+    }
+    nv2a_release_framebuffer_surface();
+
+    if (!have && current_surface &&
+        surface_format(current_surface) == PIXMAN_x8r8g8b8) {
+        publish_frame(surface_data(current_surface),
+                      surface_width(current_surface),
+                      surface_height(current_surface),
+                      surface_stride(current_surface));
+        g_frames_vga++;
+    }
+}
+
+uint64_t xemu_host_frame_take(uint64_t last_seq, void **bgra, int *w, int *h)
+{
+    uint64_t seq = 0;
+    pthread_mutex_lock(&g_frame_lock);
+    if (g_frame_bgra && g_frame_seq != last_seq) {
+        size_t n = (size_t)g_frame_w * 4 * g_frame_h;
+        *bgra = malloc(n);
+        memcpy(*bgra, g_frame_bgra, n);
+        *w = g_frame_w;
+        *h = g_frame_h;
+        seq = g_frame_seq;
+    }
+    pthread_mutex_unlock(&g_frame_lock);
+    return seq;
+}
+
+static ControllerState *g_host_pad;
+
+/* Called from the shell at display rate with the controller's state. */
+void xemu_host_pad_set(uint16_t buttons, const int16_t axis[6])
+{
+    ControllerState *pad = g_host_pad;
+    if (!pad) {
+        return;
+    }
+    pad->buttons = buttons;
+    for (int i = 0; i < 6; i++) {
+        pad->axis[i] = axis[i];
+    }
+}
+
+static int dump_ramblock(RAMBlock *rb, void *opaque)
+{
+    (void)opaque;
+    fprintf(stderr, "[host]   ramblock %-24s used %llu MiB max %llu MiB\n",
+            qemu_ram_get_idstr(rb),
+            (unsigned long long)(qemu_ram_get_used_length(rb) >> 20),
+            (unsigned long long)(qemu_ram_get_max_length(rb) >> 20));
+    return 0;
+}
+
+static int      g_argc;
+static char   **g_argv;
+static int      exit_status;
+static bool     qemu_exiting;
+
+static QemuSemaphore  display_init_sem;
+static DisplayChangeListener dcl;
+static DisplaySurface *current_surface;
+static uint64_t frame_count;
+
+/* ------------------------------------------------------------------ */
+/* The four symbols the rest of the tree needed from the deleted shell. */
+/* ------------------------------------------------------------------ */
+
+void xemu_queue_notification(const char *msg)
+{
+    fprintf(stderr, "[xemu] %s\n", msg);
+}
+
+void xemu_queue_error_message(const char *msg)
+{
+    fprintf(stderr, "[xemu] error: %s\n", msg);
+}
+
+/*
+ * Snapshot thumbnails were GL textures drawn into an ImGui panel. There is
+ * no panel now. Save states still work; they just carry no preview image.
+ */
+void *xemu_snapshots_create_framebuffer_thumbnail_png(size_t *size)
+{
+    *size = 0;
+    return NULL;
+}
+
+bool xemu_snapshots_load_png_to_texture(unsigned int tex, void *buf,
+                                        size_t size)
+{
+    return false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Framebuffer out                                                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Writes a copy of whatever the guest last drew. The copy is the caller's,
+ * made while the NV2A held the surface for us, so nothing here touches the
+ * machine and nothing here blocks it.
+ */
+static bool write_framebuffer_png(const NV2ACpuFramebuffer *fb, const char *path)
+{
+    int w = fb->width;
+    int h = fb->height;
+    int stride = fb->stride;
+    const uint8_t *src = fb->data;
+    if (w <= 0 || h <= 0 || !src) {
+        return false;
+    }
+
+    /*
+     * The guest framebuffer is 32bpp little-endian x8r8g8b8, which is BGRA
+     * in memory order. Pack it down to tight RGB, which is what fpng wants
+     * and which also drops the stride padding.
+     */
+    uint8_t *rgb = g_malloc((size_t)3 * w * h);
+    for (int y = 0; y < h; y++) {
+        const uint8_t *p = src + (size_t)y * stride;
+        uint8_t *o = rgb + (size_t)3 * w * y;
+        for (int x = 0; x < w; x++) {
+            o[3 * x + 0] = p[4 * x + 2];
+            o[3 * x + 1] = p[4 * x + 1];
+            o[3 * x + 2] = p[4 * x + 0];
+        }
+    }
+
+    bool ok = xemu_host_write_png(path, rgb, w, h);
+    g_free(rgb);
+    if (!ok) {
+        return false;
+    }
+
+    fprintf(stderr, "[xemu-host] wrote %s (%dx%d)\n", path, w, h);
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* The display backend                                                  */
+/* ------------------------------------------------------------------ */
+
+static void host_gfx_update(DisplayChangeListener *l, int x, int y,
+                            int w, int h)
+{
+    /*
+     * Count, and nothing else. This runs on the machine's thread with the
+     * BQL held, and the NV2A scan-out waits on the pgraph thread, which
+     * itself takes the BQL. Asking for the frame from here deadlocked the
+     * whole machine at frame 1 (measured 2026-10-28: the vCPU queued on the
+     * BQL in cpu_handle_interrupt and never retired an instruction). Every
+     * in-tree caller that waits on pgraph drops the BQL first; the desktop
+     * shell asks from its window thread. The sampler thread does the same.
+     */
+    frame_count++;
+}
+
+static void host_gfx_switch(DisplayChangeListener *l, DisplaySurface *s)
+{
+    current_surface = s;
+}
+
+static void host_refresh(DisplayChangeListener *l)
+{
+    graphic_hw_update(l->con);
+}
+
+static const DisplayChangeListenerOps host_ops = {
+    .dpy_name       = "xemu-host",
+    .dpy_gfx_update = host_gfx_update,
+    .dpy_gfx_switch = host_gfx_switch,
+    .dpy_refresh    = host_refresh,
+};
+
+static void display_early_init(DisplayOptions *o)
+{
+}
+
+static void display_init(DisplayState *ds, DisplayOptions *o)
+{
+    assert(o->type == DISPLAY_TYPE_XEMU);
+
+    dcl.con = qemu_console_lookup_by_index(0);
+    dcl.ops = &host_ops;
+    register_displaychangelistener(&dcl);
+
+    /* main() is blocked until this fires. */
+    qemu_sem_post(&display_init_sem);
+}
+
+static QemuDisplay qemu_display_xemu = {
+    .type       = DISPLAY_TYPE_XEMU,
+    .early_init = display_early_init,
+    .init       = display_init,
+};
+
+static void register_xemu_display(void)
+{
+    qemu_display_register(&qemu_display_xemu);
+}
+
+type_init(register_xemu_display);
+
+/* ------------------------------------------------------------------ */
+/* Entry                                                                */
+/* ------------------------------------------------------------------ */
+
+static void *qemu_main_thread(void *opaque)
+{
+    footprint("before qemu_init");
+    qemu_init(g_argc, g_argv);
+    footprint("after qemu_init");
+
+    /*
+     * One controller on port 1, filled by the shell. qemu_init returns
+     * with the BQL held on this thread, which is what plugging the USB
+     * devices needs.
+     */
+    g_host_pad = xemu_input_bind_host_pad(0, "Headset Gamepad");
+    fprintf(stderr, "[host] gamepad bound to port 1: %s\n",
+            g_host_pad && g_host_pad->device ? "ok" : "NO DEVICE");
+    fflush(stderr);
+    fprintf(stderr, "[host] ramblocks:\n");
+    qemu_ram_foreach_block(dump_ramblock, NULL);
+    fflush(stderr);
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    {
+        extern void xemu_host_dump_vm_regions(void);
+        xemu_host_dump_vm_regions();
+    }
+#endif
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    fprintf(stderr, "[host] qemu_init returned, stage %d\n", xemu_host_stage);
+    if (xemu_host_stage < 3) {
+        fprintf(stderr, "[host] stopping before qemu_main_loop\n");
+        return NULL;
+    }
+#endif
+
+    exit_status = qemu_main_loop();
+    qatomic_set(&qemu_exiting, true);
+    bql_unlock();
+    return NULL;
+}
+
+/*
+ * On macOS this is the entry point. On the iOS family main() belongs to
+ * UIKit, in xemu-host-ios.m, and it calls this from a worker thread once
+ * the app has checked in. A visionOS process that never reaches
+ * UIApplicationMain is killed before any of this runs, with no crash report
+ * and no output, which is worth stating because it looks exactly like a
+ * dyld failure from the outside.
+ */
+#if TARGET_OS_VISION || TARGET_OS_IOS
+int xemu_host_run(int argc, char **argv)
+#else
+int main(int argc, char **argv)
+#endif
+{
+    QemuThread thread;
+
+    setlocale(LC_NUMERIC, "C");
+    g_argc = argc;
+    g_argv = argv;
+
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "-config_path") && i + 1 < argc) {
+            xemu_settings_set_path(argv[i + 1]);
+            break;
+        }
+    }
+
+    footprint("at entry");
+    {
+        QemuThread ticker;
+        qemu_thread_create(&ticker, "footprint", footprint_ticker, NULL,
+                           QEMU_THREAD_DETACHED);
+    }
+    if (!xemu_settings_load()) {
+        fprintf(stderr, "%s", xemu_settings_get_error_message());
+        return 1;
+    }
+    atexit(xemu_settings_save);
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    /*
+     * There is no config file on a fresh install and nowhere obvious to put
+     * one, so point the machine at the media copied into the bundle. Only
+     * fills in what is empty, so a config written later still wins.
+     *
+     * The EEPROM goes in Documents rather than the bundle, because the
+     * bundle is read-only and xemu generates one if it is missing.
+     */
+    {
+        const char *bundle = xemu_host_bundle_path();
+        const char *home = getenv("HOME");
+
+        /*
+         * Set unconditionally, not just when empty. A saved config carries
+         * absolute paths with the container's UUID in them, and the
+         * container gets a NEW UUID on every reinstall, so yesterday's
+         * config points at a directory that no longer exists. The symptom
+         * is "Failed to generate EEPROM file" naming a path you have never
+         * seen.
+         */
+        xemu_settings_set_string(&g_config.sys.files.bootrom_path,
+            g_strdup_printf("%s/media/mcpx-1.0.bin", bundle));
+        xemu_settings_set_string(&g_config.sys.files.flashrom_path,
+            g_strdup_printf("%s/media/bios.bin", bundle));
+        /* A disc in the drive boots instead of the dashboard. Read-only
+         * is fine for a DVD, so it can stay in the bundle. */
+        {
+            g_autofree char *iso = g_strdup_printf("%s/media/game.iso", bundle);
+            if (g_file_test(iso, G_FILE_TEST_EXISTS)) {
+                xemu_settings_set_string(&g_config.sys.files.dvd_path, iso);
+                fprintf(stderr, "[host] dvd      %s\n", iso);
+            }
+        }
+        /*
+         * The hard disk has to live somewhere writable. An app bundle is
+         * read-only on this platform and QEMU opens a disk read-write, so
+         * pointing at the bundled copy fails with "Operation not
+         * permitted" before the machine ever starts.
+         *
+         * Copy it into the container once. It is 2 GB, so only if it is
+         * not already there. This is also the shape the real thing takes,
+         * where the user supplies media into the container rather than it
+         * riding along in the bundle.
+         */
+        if (home) {
+            g_autofree char *hdd_dst =
+                g_strdup_printf("%s/Documents/xbox_hdd.qcow2", home);
+            g_autofree char *hdd_src =
+                g_strdup_printf("%s/media/xbox_hdd.qcow2", bundle);
+
+            if (!g_file_test(hdd_dst, G_FILE_TEST_EXISTS) &&
+                g_file_test(hdd_src, G_FILE_TEST_EXISTS)) {
+                fprintf(stderr, "[host] copying hdd into the container, "
+                                "this takes a moment\n");
+                /*
+                 * Streamed in chunks, deliberately. g_file_get_contents()
+                 * reads the whole file into memory first, which for a
+                 * 1.9 GB disk image means a 1.9 GB peak on a device with a
+                 * jetsam limit. It completed and then the process died a
+                 * few hundred milliseconds later inside Vulkan init.
+                 */
+                FILE *in = fopen(hdd_src, "rb");
+                FILE *out = in ? fopen(hdd_dst, "wb") : NULL;
+                if (in && out) {
+                    enum { CHUNK = 4 * 1024 * 1024 };
+                    g_autofree char *buf = g_malloc(CHUNK);
+                    size_t n, total = 0;
+                    bool ok = true;
+                    while ((n = fread(buf, 1, CHUNK, in)) > 0) {
+                        if (fwrite(buf, 1, n, out) != n) { ok = false; break; }
+                        total += n;
+                    }
+                    ok = ok && (fflush(out) == 0);
+                    fprintf(stderr, "[host] hdd %s, %.1f MB\n",
+                            ok ? "copied" : "COPY FAILED", total / 1048576.0);
+                } else {
+                    fprintf(stderr, "[host] hdd copy could not open files\n");
+                }
+                if (out) fclose(out);
+                if (in) fclose(in);
+            }
+            if (g_file_test(hdd_dst, G_FILE_TEST_EXISTS)) {
+                footprint("after hdd copy");
+                xemu_settings_set_string(&g_config.sys.files.hdd_path,
+                                         g_strdup(hdd_dst));
+                fprintf(stderr, "[host] hdd      %s\n", hdd_dst);
+            }
+        }
+        if (home) {
+            xemu_settings_set_string(&g_config.sys.files.eeprom_path,
+                g_strdup_printf("%s/Documents/eeprom.bin", home));
+        }
+
+        /*
+         * The same trap that cost a boot on macOS: while show_welcome is
+         * true, system/vl.c skips adding -bios entirely and the machine
+         * starts with no BIOS, reporting a null filename while the path sits
+         * correctly in the config. There is no welcome screen here to dismiss.
+         */
+        g_config.general.show_welcome = false;
+
+        /*
+         * The config default is OPENGL, and there is no GL backend in this
+         * build, so a fresh install configures a renderer that does not
+         * exist. xemu logs "Configured renderer not available" and carries
+         * on with none, and the first thing NV2A asks of it ends the
+         * process with no message at all.
+         */
+        g_config.display.renderer = CONFIG_DISPLAY_RENDERER_VULKAN;
+        fprintf(stderr, "[host] renderer forced to Vulkan\n");
+        fprintf(stderr, "[host] bootrom  %s\n", g_config.sys.files.bootrom_path);
+        fprintf(stderr, "[host] flashrom %s\n", g_config.sys.files.flashrom_path);
+    }
+#endif
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    if (xemu_host_stage < 1) {
+        fprintf(stderr, "[host] stopping before qemu_init (stage %d)\n",
+                xemu_host_stage);
+        return 0;
+    }
+#endif
+
+    qemu_sem_init(&display_init_sem, 0);
+    qemu_thread_create(&thread, "qemu_main", qemu_main_thread, NULL,
+                       QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&display_init_sem);
+
+    /* Inherited from ui/xemu.c: this thread touches TCG and AIO state. */
+    tcg_register_init_ctx();
+    qemu_set_current_aio_context(qemu_get_aio_context());
+    /* On the headset this is a raw pthread, so nothing did this for us. */
+    rcu_register_thread();
+
+    /*
+     * Headless run: let the guest get somewhere, then write one frame out.
+     * XEMU_HOST_SHOT names the file and XEMU_HOST_SHOT_AFTER is how many
+     * seconds to wait first. Without the former this just runs.
+     */
+    const char *shot = getenv("XEMU_HOST_SHOT");
+
+    int after = getenv("XEMU_HOST_SHOT_AFTER")
+                    ? atoi(getenv("XEMU_HOST_SHOT_AFTER")) : 10;
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    /*
+     * Environment variables do not reach an app launched the ordinary way,
+     * so on the headset default to writing into the app's own Documents,
+     * which is where a Files-visible container puts things and where
+     * `devicectl device copy from` can fetch them.
+     */
+    g_autofree char *doc_shot = NULL;
+    if (!shot) {
+        const char *home = getenv("HOME");
+        doc_shot = g_strdup_printf("%s/Documents/frame.png", home ? home : ".");
+        shot = doc_shot;
+    }
+#endif
+
+    for (int elapsed = 0; !qatomic_read(&qemu_exiting); elapsed++) {
+        /* Thirty grabs a second; the bookkeeping below runs once a second. */
+        for (int i = 0; i < 30 && !qatomic_read(&qemu_exiting); i++) {
+            g_usleep(33 * 1000);
+            if (elapsed >= 2 && frame_count > 0) {
+                grab_frame();
+            }
+        }
+
+        /*
+         * Poll rather than ask once. Ten seconds was a guess, and a guess
+         * that fails tells you nothing about whether the machine is slow,
+         * stuck, or never going to scan out at all.
+         */
+        if (elapsed % 5 == 0) {
+            /*
+             * runstate is the cheapest honest signal about whether the
+             * machine is actually executing. "running" with no frames
+             * means a CPU that is advancing and not drawing; anything else
+             * means it never started or stopped itself.
+             */
+            /*
+             * runstate only says "not paused". A CPU spinning in a loop
+             * and a CPU halted waiting for an interrupt that never comes
+             * both report running, and they are different problems.
+             * halted distinguishes them, and it is a plain field read.
+             */
+            CPUState *cpu = first_cpu;
+            /*
+             * The PC is the one number that separates every remaining
+             * hypothesis. Changing: the guest advances and the problem is
+             * downstream. Constant: a tight poll, and the address says on
+             * what. Read racily from another thread, which is fine for a
+             * number printed every ten seconds.
+             */
+            vaddr pc = 0;
+            if (cpu && CPU_GET_CLASS(cpu)->get_pc) {
+                pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+            }
+            fprintf(stderr, "[host] t=%3ds, %" PRIu64 " guest frames "
+                            "(published nv2a %" PRIu64 " vga %" PRIu64 "), "
+                            "runstate %s, cpu %s%s, pc 0x%08" PRIx64
+                            ", exiting %d\n",
+                    elapsed, frame_count, g_frames_nv2a, g_frames_vga,
+                    RunState_str(runstate_get()),
+                    cpu ? (cpu->halted ? "HALTED" : "executing") : "none",
+                    cpu && cpu->stopped ? " stopped" : "",
+                    (uint64_t)pc, (int)qatomic_read(&qemu_exiting));
+            if (cpu) {
+                /*
+                 * running is true only while the vCPU is inside cpu_exec.
+                 * Not halted plus never running means the thread exists
+                 * and is not executing guest code, which is a lock or a
+                 * missing kick, not a guest problem.
+                 */
+                fprintf(stderr, "[host]   vcpu: created=%d running=%d "
+                                "thread=%d stop=%d exit_req=%d irq_req=0x%x, "
+                                "host holds bql=%d\n",
+                        (int)cpu->created, (int)cpu->running,
+                        cpu->thread_id, (int)cpu->stop,
+                        (int)qatomic_read(&cpu->exit_request),
+                        (unsigned)qatomic_read(&cpu->interrupt_request),
+                        (int)bql_locked());
+            }
+            {
+                /*
+                 * The guest's own speed. Presses reach its report and it
+                 * misses them unless they are held, which is what a guest
+                 * sampling input at a few frames a second would do.
+                 */
+                static int last_flips;
+                static unsigned long last_blocks;
+                int flips = nv2a_get_frame_count();
+                unsigned long blocks = xemu_host_blocks_executed;
+                fprintf(stderr, "[host]   guest: %d flips in 5 s, %lu blocks/s, "
+                                "%zu TBs, %u flushes\n",
+                        flips - last_flips, (blocks - last_blocks) / 5,
+                        tcg_nb_tbs(), xemu_host_tb_flush_count());
+                last_flips = flips;
+                last_blocks = blocks;
+            }
+            {
+                size_t where = 0;
+                int same = tcg_splitwx_views_match(64 * 1024, &where);
+                fprintf(stderr, "[host]   splitwx views: %s%s\n",
+                        same == 1 ? "MATCH" : same == 0 ? "DIVERGED" : "n/a",
+                        same == 0 ? "" : "");
+                if (same == 0) {
+                    fprintf(stderr, "[host]   first difference at byte %zu\n",
+                            where);
+                }
+            }
+        }
+
+        /*
+         * Take a frame from here, with no BQL, the way the desktop shell's
+         * window thread does. Get, copy the pixels out, release, and only
+         * then encode: the pointer is valid until the guest draws again,
+         * and a second get without a release trips an assert in pgraph
+         * (that was the signal 6 of 2026-10-26).
+         */
+        /*
+         * The thread dump and the execute probe that lived here at 20 to
+         * 23 seconds found the JIT answer and are retired: suspending
+         * every thread, the main one included, is also exactly when the
+         * immersive space was lost in two runs (2026-10-29).
+         */
+
+        if (shot && elapsed == after) {
+            nv2a_get_framebuffer_surface();
+            NV2ACpuFramebuffer fb;
+            bool have = nv2a_get_cpu_framebuffer(&fb);
+            uint8_t *copy = NULL;
+            if (have && fb.width > 0 && fb.height > 0 && fb.data) {
+                size_t row = (size_t)fb.width * 4;
+                copy = g_malloc(row * fb.height);
+                for (int y = 0; y < fb.height; y++) {
+                    memcpy(copy + y * row,
+                           (const uint8_t *)fb.data + (size_t)y * fb.stride,
+                           row);
+                }
+                fb.data = copy;
+                fb.stride = (int)row;
+            }
+            nv2a_release_framebuffer_surface();
+
+            if (!copy) {
+                fprintf(stderr, "[host] t=%3ds frame: nothing published\n",
+                        elapsed);
+            } else if (write_framebuffer_png(&fb, shot)) {
+                fprintf(stderr, "[host] t=%3ds frame: wrote %dx%d\n",
+                        elapsed, fb.width, fb.height);
+            } else {
+                fprintf(stderr, "[host] t=%3ds frame: %dx%d, PNG write "
+                                "FAILED\n", elapsed, fb.width, fb.height);
+            }
+            g_free(copy);
+        }
+    }
+
+    fprintf(stderr, "[host] xemu_host_run: loop ended, exiting=%d, "
+                    "joining qemu thread\n",
+            (int)qatomic_read(&qemu_exiting));
+    qemu_thread_join(&thread);
+    fprintf(stderr, "[host] xemu_host_run: qemu thread joined, status %d\n",
+            exit_status);
+    return exit_status;
+}
