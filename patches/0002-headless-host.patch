+/*
+ * xemu-host-png.cc -- C linkage over fpng.
+ *
+ * Copyright (C) 2026 A. Cervantez
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * libpng is not available in this build ("PNG support: NO"), and adding it
+ * would mean cross-compiling another library for visionOS later. fpng is
+ * already vendored under ui/thirdparty and already compiled, so the
+ * headless framebuffer dump goes through it. The only reason this file is
+ * C++ is that fpng's API is in a namespace.
+ */
+
+#include <cstdint>
+#include <fpng.h>
+
+extern "C" bool xemu_host_write_png(const char *path, const void *rgb,
+                                    int w, int h)
+{
+    static bool initialised;
+    if (!initialised) {
+        fpng::fpng_init();
+        initialised = true;
+    }
+    return fpng::fpng_encode_image_to_file(path, rgb, (uint32_t)w,
+                                           (uint32_t)h, 3, 0);
+}
diff --git a/ui/xemu-host.c b/ui/xemu-host.c
new file mode 100644
index 0000000..0b0f417
--- /dev/null
+++ b/ui/xemu-host.c
@@ -0,0 +1,1211 @@
+/*
+ * xemu-host.c -- the emulator without a desktop.
+ *
+ * Copyright (C) 2026 A. Cervantez
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * This replaces ui/xemu.c (an SDL3 window, a GL context and an ImGui menu)
+ * and ui/xui/ (50 files of ImGui) with a display backend that keeps the
+ * framebuffer and hands it to whoever is hosting: a PNG on macOS today, a
+ * visionOS compositor later.
+ *
+ * It is deliberately small. Measuring the symbol boundary rather than
+ * guessing at it showed that the rest of the emulator asks only four things
+ * of the shell it is losing, so only four things are reimplemented here.
+ * Everything else under ui/ stays: QEMU's console, its input stack and its
+ * keymaps are not desktop code, and a host needs all of them.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "qemu/atomic.h"
+#include "qemu/rcu.h"
+#include <pthread.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
+#endif
+#include "system/system.h"
+#include "system/runstate.h"
+#include "ui/console.h"
+#include "ui/surface.h"
+#include "hw/xbox/nv2a/nv2a.h"
+#include "hw/core/cpu.h"
+#include "exec/cpu-common.h"
+#include "block/aio.h"
+#include "tcg/startup.h"
+
+#include "xemu-settings.h"
+#include "xemu-input.h"
+#include "xemu-version.h"
+#include "xemu-notifications.h"
+#include "xemu-snapshots.h"
+#include "hw/xbox/smbus.h"
+#include "qapi/qapi-commands-block.h"
+#include "qapi/error.h"
+
+const char *xemu_host_bundle_path(void);
+extern int xemu_host_stage;
+int tcg_splitwx_views_match(size_t n, size_t *first_diff);
+/* ui/xemu-host-ios.m: every thread's stack, for a machine that is stuck. */
+void xemu_host_dump_threads(const char *why);
+void xemu_host_describe_page(const char *what, const void *addr);
+void xemu_host_exec_probe(void *rw, void *rx);
+int tcg_splitwx_scratch(void **rw, void **rx, size_t *len, void **rx_base);
+
+#include <locale.h>
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
+
+/* ui/xemu-host-png.cc, because fpng's API is C++ */
+bool xemu_host_write_png(const char *path, const void *rgb, int w, int h);
+
+/*
+ * Resident footprint, the number jetsam judges. The first guest block ran
+ * at 5119 MiB and the process died before the sixty-fifth, so where that
+ * memory comes from is the question, and these prints bisect startup.
+ */
+unsigned long long xemu_host_footprint_mib(void)
+{
+#ifdef __APPLE__
+    task_vm_info_data_t vm;
+    mach_msg_type_number_t cnt = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm, &cnt)
+        == KERN_SUCCESS) {
+        return vm.phys_footprint >> 20;
+    }
+#endif
+    return 0;
+}
+
+static void footprint(const char *where)
+{
+    fprintf(stderr, "[host] footprint %s: %llu MiB\n", where,
+            xemu_host_footprint_mib());
+    fflush(stderr);
+}
+
+/*
+ * A ticker, so the jump lines up against whatever device was printing
+ * at the time. Only speaks when the number moves by more than 16 MiB.
+ */
+static void *footprint_ticker(void *unused)
+{
+    (void)unused;
+    unsigned long long last = 0;
+    for (int i = 0; i < 40 * 4; i++) {
+        unsigned long long now = xemu_host_footprint_mib();
+        if (now > last + 16 || now + 16 < last) {
+            fprintf(stderr, "[host] fp t=%.2fs: %llu MiB\n", i * 0.25, now);
+            fflush(stderr);
+            last = now;
+        }
+        g_usleep(250 * 1000);
+    }
+    return NULL;
+}
+
+/*
+ * The latest frame, for whoever presents it. The sampler publishes a
+ * tightly packed BGRA copy thirty times a second; the UI takes a copy of
+ * that when the sequence number moves. Two copies per frame is nothing at
+ * 640x480 and it keeps every lock short.
+ */
+static DisplaySurface *current_surface;   /* set by host_gfx_switch below */
+uint64_t xemu_host_frame_take(uint64_t last_seq, void **bgra, int *w, int *h);
+void xemu_host_pad_set(uint16_t buttons, const int16_t axis[6]);
+void xemu_host_set_background(bool background);
+void xemu_host_set_metal_present(bool on);
+int xemu_host_present_frame(void *mtl_texture, int w, int h);
+bool xemu_host_present_size(int *w, int *h);
+int xemu_host_guest_flips(void);
+extern unsigned long xemu_host_blocks_executed;
+unsigned xemu_host_tb_flush_count(void);
+size_t tcg_nb_tbs(void);
+static pthread_mutex_t g_frame_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t *g_frame_bgra;
+static int g_frame_w, g_frame_h;
+static uint64_t g_frame_seq;
+static uint64_t g_frames_vga, g_frames_nv2a;
+
+static void publish_frame(const uint8_t *src, int w, int h, int stride)
+{
+    size_t row = (size_t)w * 4;
+    uint8_t *copy = g_malloc(row * h);
+    for (int y = 0; y < h; y++) {
+        memcpy(copy + y * row, src + (size_t)y * stride, row);
+    }
+    pthread_mutex_lock(&g_frame_lock);
+    g_free(g_frame_bgra);
+    g_frame_bgra = copy;
+    g_frame_w = w;
+    g_frame_h = h;
+    g_frame_seq++;
+    pthread_mutex_unlock(&g_frame_lock);
+}
+
+/*
+ * Ask the NV2A for the scanned-out surface, the way the desktop shell's
+ * window thread does every frame: get, copy, release. When nothing is in
+ * the surface cache (the guest is drawing with the CPU, or has not drawn
+ * yet) fall back to the VGA surface QEMU keeps for us.
+ */
+/*
+ * Foreground and background. A backgrounded app on this OS loses the GPU,
+ * and the renderer's next command buffer then fails with the device lost
+ * for good (measured 2026-10-29: VK_ERROR_DEVICE_LOST, "insufficient
+ * permission", then an assert in pgraph_vk_finish). So the machine is
+ * paused and the frame grabs stop the moment the system says the app is
+ * leaving, and both resume on return. The stop and start run on the main
+ * loop thread with the BQL, where they belong.
+ */
+static bool g_background;
+static bool g_qemu_ready;   /* qemu_init has returned; the AIO context exists */
+
+static void pause_bh(void *opaque)
+{
+    bool pause = (bool)(uintptr_t)opaque;
+    if (pause && runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+        fprintf(stderr, "[host] machine paused for the background\n");
+    } else if (!pause && !runstate_is_running()) {
+        vm_start();
+        fprintf(stderr, "[host] machine resumed\n");
+    }
+    fflush(stderr);
+}
