+/* The display backend                                                  */
+/* ------------------------------------------------------------------ */
+
+static void host_gfx_update(DisplayChangeListener *l, int x, int y,
+                            int w, int h)
+{
+    /*
+     * Count, and nothing else. This runs on the machine's thread with the
+     * BQL held, and the NV2A scan-out waits on the pgraph thread, which
+     * itself takes the BQL. Asking for the frame from here deadlocked the
+     * whole machine at frame 1 (measured 2026-10-28: the vCPU queued on the
+     * BQL in cpu_handle_interrupt and never retired an instruction). Every
+     * in-tree caller that waits on pgraph drops the BQL first; the desktop
+     * shell asks from its window thread. The sampler thread does the same.
+     */
+    frame_count++;
+}
