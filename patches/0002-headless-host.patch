+/*
+ * Swapping a disc without relaunching.
+ *
+ * Upstream has xemu_eject_disc and xemu_load_disc in ui/xemu.c, but that
+ * file is an SDL window and an ImGui menu bar and is not in this build,
+ * so this is the same sequence against the same primitives.
+ *
+ * Three things are not obvious and each one was a wrong first guess:
+ *
+ * 1. It runs in a bottom half. Every block layer call here asserts
+ *    GLOBAL_STATE_CODE(), which in this tree is an assert that the caller
+ *    holds the BQL, and asserts are compiled in. A bottom half on the main
+ *    AIO context runs on the main loop thread with the BQL already held,
+ *    which is the same reason pause_bh above exists. Calling this straight
+ *    from the SwiftUI thread aborts the process.
+ *
+ * 2. force is true. With force false a running title holds the tray shut,
+ *    because it issued ATAPI PREVENT ALLOW MEDIUM REMOVAL, and do_open_tray
+ *    returns EINPROGRESS after merely asking the guest to let go. The
+ *    medium does not change. That makes the first press look broken and the
+ *    second press work, which is upstream's behaviour and is not worth
+ *    reproducing: somebody pressing eject in this app has already decided.
+ *    The SMC button is pressed as well, so the guest still sees the event.
+ *
+ * 3. Changing the medium does not start the new game. The console reads its
+ *    disc when it boots, so a swap has to reset the machine afterwards or
+ *    the old title simply keeps running with a new disc under it. Eject on
+ *    its own does not reset, because that is a tray opening and nothing
+ *    more.
+ */
+typedef struct DiscRequest {
+    char *path;     /* NULL ejects */
+    bool reset;     /* reboot afterwards, so the new disc is what boots */
+} DiscRequest;
+
+static void disc_bh(void *opaque)
+{
+    DiscRequest *req = opaque;
+    Error *err = NULL;
+
+    /* The guest sees the physical button either way, because that is what
+     * the person did. */
+    xbox_smc_eject_button();
+
+    if (req->path) {
+        qmp_blockdev_change_medium("ide0-cd1", NULL, req->path, "raw",
+                                   true, true,   /* force the locked tray */
+                                   false, 0, &err);
+    } else {
+        qmp_eject("ide0-cd1", NULL, true, true, &err);
+    }
+
+    /*
+     * Unconditionally, and whether it worked or not, because this reads
+     * the drive's real state and writes it into the SMC register the Xbox
+     * kernel polls. Leaving it out means the guest's idea of the tray and
+     * the block layer's disagree, and on an eject the title keeps reading
+     * a drive with no disc in it. There is a FIXME upstream wishing this
+     * were a tray_moved callback; until it is, the caller does it.
+     */
+    xbox_smc_update_tray_state();
+
+    if (err) {
+        fprintf(stderr, "[host] disc: %s failed: %s\n",
+                req->path ? "load" : "eject", error_get_pretty(err));
+        error_free(err);
+    } else {
+        /*
+         * Only on success. Upstream blanks this before the eject it may
+         * refuse, which leaves the setting and the drive disagreeing, and
+         * the setting is what boots next time because it is saved at exit.
+         */
+        xemu_settings_set_string(&g_config.sys.files.dvd_path,
+                                 req->path ? req->path : "");
+        fprintf(stderr, "[host] disc: %s\n",
+                req->path ? req->path : "ejected");
+        if (req->reset) {
+            /*
+             * The reset is a request the main loop acts on later, while
+             * the medium already changed synchronously above, so the title
+             * gets an IDE media change error somewhere in between and
+             * handles it however it likes. Whether that lands on the new
+             * game or on the dashboard is worth knowing, so say what the
+             * machine was doing at the moment of asking.
+             */
+            fprintf(stderr, "[host] disc: resetting so it boots "
+                            "(runstate was %s)\n",
+                    runstate_is_running() ? "running" : "not running");
+            qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_UI);
+        }
+    }
+    fflush(stderr);
+
+    g_free(req->path);
+    g_free(req);
+}
+
+/* The bottom half outlives the caller's string, so it owns a copy. */
+static void schedule_disc(char *path, bool reset)
+{
+    if (!qatomic_read(&g_qemu_ready)) {
+        fprintf(stderr, "[host] disc: ignored, the machine is not up yet\n");
+        fflush(stderr);
+        g_free(path);
+        return;
+    }
+    DiscRequest *req = g_new0(DiscRequest, 1);
+    req->path = path;
+    req->reset = reset;
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), disc_bh, req);
+}
+
+void xemu_host_load_disc(const char *filename)
+{
+    const char *home = getenv("HOME");
+    if (!filename || !filename[0] || !home) {
+        return;
+    }
+    fprintf(stderr, "[host] disc: swapping to %s\n", filename);
+    fflush(stderr);
+    schedule_disc(g_strdup_printf("%s/Documents/GAMES/%s", home, filename),
+                  true);
+}
+
+void xemu_host_eject_disc(void)
+{
+    fprintf(stderr, "[host] disc: eject requested\n");
+    fflush(stderr);
+    schedule_disc(NULL, false);
+}
+
+/* Documents copy if one exists, else the bundle's. */
+static char *media_path(const char *home, const char *bundle, const char *file)
+{
+    char *doc = g_strdup_printf("%s/Documents/%s", home ? home : "", file);
+    if (home && g_file_test(doc, G_FILE_TEST_EXISTS)) {
+        return doc;
+    }
+    g_free(doc);
+    return g_strdup_printf("%s/media/%s", bundle, file);
+}
