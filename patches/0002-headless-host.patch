+# Dropped with the shell: imgui, implot, fa (Font Awesome), stb_image,
+# fpng, and crucially sdl and opengl. png stays, because the headless path
+# writes one. See system_ss.add(png) above.
+xemu_ss.add(fpng, json, fatx, tomlplusplus, genconfig)
+
+# The iOS-family entry point is a SwiftUI App (see xemu-host-app.swift for
+# why). swiftc produces one object; ld64 reads the autolink entries in it,
+# so the only extra link input is where the Swift stub libraries live.
+ios_family = host_os == 'darwin' and cc.compiles('''
+  #include <TargetConditionals.h>
+  #if !TARGET_OS_VISION && !TARGET_OS_IOS
+  #error not the iOS family
+  #endif
+  int x;''', name: 'iOS family host')
+if ios_family
+  xcrun = find_program('xcrun')
+  xros_sdk = run_command(xcrun, '-sdk', 'xros', '--show-sdk-path',
+                         check: true).stdout().strip()
+  swift_app = custom_target('xemu-host-app.o',
+    input: ['xemu-host-app.swift', 'xbawks-picker.swift',
+             'xbawks-console.swift'],
+    output: 'xemu-host-app.o',
+    depend_files: files('xemu-host-bridge.h'),
+    command: [xcrun, '-sdk', 'xros', 'swiftc',
+              '-target', 'arm64-apple-xros26.0', '-O', '-wmo', '-parse-as-library',
+              '-emit-object',
+              '-import-objc-header', meson.current_source_dir() / 'xemu-host-bridge.h',
+              '@INPUT@', '-o', '@OUTPUT@'])
+  xemu_ss.add(swift_app)
+  emulator_link_args += ['-L' + xros_sdk / 'usr/lib/swift']
+endif
+
 system_ss.add_all(xemu_ss)
 
 system_ss.add(when: pixman, if_true: files('console-vc.c'), if_false: files('console-vc-stubs.c'))
diff --git a/ui/xbawks-console.swift b/ui/xbawks-console.swift
new file mode 100644
index 0000000..896c313
--- /dev/null
+++ b/ui/xbawks-console.swift
@@ -0,0 +1,404 @@
+/*
+ * The console in the room, and the button that swaps a disc.
+ *
+ * There is no window while playing, because a spatial controller belongs
+ * to the app only while an immersive space is open and no window of the
+ * app is being gazed at. That rule is what made the first disc choice a
+ * startup step: pick a game, then the window goes away for good, and
+ * changing your mind meant relaunching the app, reattaching a debugger
+ * and often rebooting the headset.
+ *
+ * A RealityKit entity is not a window. So the console itself becomes the
+ * control: it sits in the room at true scale, and pressing it brings the
+ * deck back. Looking at a thing and pressing it is also what you would
+ * do to the real hardware, which is the whole reason it reads as obvious.
+ *
+ * The model is loaded at runtime from Documents and is not part of this
+ * app. It is somebody else's work with no licence attached to it, so it
+ * does not travel in the bundle or the repository. Without it the button
+ * is a plain box of the same dimensions and behaves identically.
+ */
+
+import ARKit
+import Foundation
+import RealityKit
+import SwiftUI
+import UIKit
+import simd
+
+/// Real console, measured: 320 x 91 to 100 x 260 mm. The model's own shell
+/// bounding box is 323.3 x 93.4 x 259.4 mm, so these are the fallback box
+/// and the sanity check for a model whose units did not survive export.
+enum ConsoleMetrics {
+    static let width: Float = 0.323
+    static let height: Float = 0.093
+    static let depth: Float = 0.259
+
+    /// On a low table, within arm's reach, slightly below the screen. Close
+    /// enough that gaze lands on it without hunting.
+    static let position = SIMD3<Float>(0, 0.72, -1.15)
+}
+
+/// A colourway is a set of part colours. The original hardware shipped in
+/// several and more exist as limited editions, so this is a table rather
+/// than constants: adding one is adding a case here.
+struct Colourway {
+    let name: String
+    let shell: UIColor
+    let jewel: UIColor
+    let trim: UIColor
+
+    static let matteBlack = Colourway(
+        name: "Matte Black",
+        shell: UIColor(white: 0.055, alpha: 1),
+        jewel: UIColor(red: 0.42, green: 0.80, blue: 0.11, alpha: 1),
+        trim: UIColor(white: 0.10, alpha: 1))
+}
+
+@MainActor
+enum XbawksConsole {
+    /// Where the model is looked for. Documents, beside the discs, because
+    /// that is where everything the app cannot redistribute already lives.
+    static var modelURL: URL? {
+        let docs = FileManager.default.urls(for: .documentDirectory,
+                                            in: .userDomainMask).first
+        guard let url = docs?.appendingPathComponent("xbox.usdz") else {
+            return nil
+        }
+        return FileManager.default.fileExists(atPath: url.path) ? url : nil
+    }
+
+    /// The tappable console. Returns the fallback box if there is no model,
+    /// so the disc swap works for anyone, with or without the asset.
+    static func make(_ way: Colourway = .matteBlack) async -> Entity {
+        let root = Entity()
+        root.name = "xbawks-console"
+        var hasModel = false
+
+        if let url = modelURL {
+            do {
+                let loaded = try await Entity(contentsOf: url)
+                paint(loaded, way)
+                normaliseScale(loaded)
+                /*
+                 * Centre the geometry on the root. A glTF export puts the
+                 * origin wherever the authoring scene had it, which for
+                 * this model is not the middle of the console, so the
+                 * collision shape and the thing you can see were in two
+                 * different places. That is why it had no collision from
+                 * the outside: you were poking next to it.
+                 */
+                let b = loaded.visualBounds(relativeTo: nil)
+                loaded.position = -b.center
+                fputs("[host] console: model extents \(b.extents) "
+                      + "centre \(b.center)\n", stderr)
+                root.addChild(loaded)
+                hasModel = true
+                fputs("[host] console: model loaded from Documents\n", stderr)
+            } catch {
+                fputs("[host] console: model failed to load (\(error)), "
+                      + "using the box\n", stderr)
+                root.addChild(fallbackBox(way))
+            }
+        } else {
+            fputs("[host] console: no Documents/xbox.usdz, using the box\n",
+                  stderr)
+            root.addChild(fallbackBox(way))
+        }
+        fflush(stderr)
+
+        root.position = ConsoleMetrics.position
+
+        /*
+         * Collision from the model's own geometry where there is a model,
+         * so a fingertip meets the shell where the shell actually is. A
+         * box around the whole console is easier to aim at but it also
+         * extends into the air above and beside it, which is what made a
+         * poke near the console register as a poke on it.
+         *
+         * The parts are individually hulled. That is fine: every gesture
+         * walks up to this root before acting, so hitting a fin and
+         * hitting the lid do the same thing.
+         */
+        /*
+         * One shape, measured from what is actually on screen rather than
+         * from the nominal dimensions, and sitting on the root now that
+         * the geometry is centred there. A console is very nearly a
+         * rectangular box, so a box is an honest fit; per part convex
+         * hulls were more faithful and also left the root with no shape of
+         * its own, which a physics body needs.
+         */
+        var extents = SIMD3<Float>(ConsoleMetrics.width,
+                                   ConsoleMetrics.height,
+                                   ConsoleMetrics.depth)
+        if hasModel {
+            let measured = root.visualBounds(relativeTo: root).extents
+            if measured.x > 0 && measured.y > 0 && measured.z > 0 {
+                extents = measured
+            }
+        }
+        root.components.set(CollisionComponent(
+            shapes: [ShapeResource.generateBox(size: extents)],
+            isStatic: true))
+        root.components.set(PhysicsBodyComponent(mode: .static))
+        root.components.set(InputTargetComponent())
+        root.components.set(HoverEffectComponent())
+        fputs("[host] console: collision box \(extents)\n", stderr)
+
+        return root
+    }
+
+    /// The model carries no materials at all: the project's website paints
+    /// it in the browser. Unpainted it renders as default white plastic,
+    /// which looks like a mistake rather than a console.
+    private static func paint(_ entity: Entity, _ way: Colourway) {
+        var shell = PhysicallyBasedMaterial()
+        shell.baseColor = .init(tint: way.shell)
+        shell.roughness = .init(floatLiteral: 0.65)
+        shell.metallic = .init(floatLiteral: 0.0)
+
+        var trim = PhysicallyBasedMaterial()
+        trim.baseColor = .init(tint: way.trim)
+        trim.roughness = .init(floatLiteral: 0.45)
+
+        var jewel = PhysicallyBasedMaterial()
+        jewel.baseColor = .init(tint: way.jewel)
+        jewel.roughness = .init(floatLiteral: 0.15)
+        jewel.emissiveColor = .init(color: way.jewel)
+        jewel.emissiveIntensity = 0.6
+
+        /*
+         * Lit, so the thing you press announces itself. This is the only
+         * reason the model's part names matter: the export kept them, so
+         * the ring can glow without touching the rest of the shell.
+         */
+        var ring = PhysicallyBasedMaterial()
+        ring.baseColor = .init(tint: way.jewel)
+        ring.emissiveColor = .init(color: way.jewel)
+        ring.emissiveIntensity = 2.0
+
+        func walk(_ e: Entity) {
+            if var model = e.components[ModelComponent.self] {
+                let n = e.name.lowercased()
+                let material: PhysicallyBasedMaterial
+                if n.contains("jewel") {
+                    material = jewel
+                } else if n.contains("ring_light") || n.contains("ringlight") {
+                    material = ring
+                } else if n.contains("button") || n.contains("port")
+                            || n.contains("fins") || n.contains("feet") {
+                    material = trim
+                } else {
+                    material = shell
+                }
+                model.materials = Array(repeating: material,
+                                        count: max(1, model.materials.count))
+                e.components.set(model)
+                /*
+                 * Per part, because a hover effect renders on the entity
+                 * that holds the mesh. On the bare root it had nothing to
+                 * draw, so looking at the console gave no sign that it
+                 * was a thing you could touch.
+                 */
+                e.components.set(HoverEffectComponent())
+            }
+            for child in e.children { walk(child) }
+        }
+        walk(entity)
+    }
+
+    /// The model is authored in metres, but a conversion that normalised
+    /// units would put a 32 cm console at 32 m and it would be invisible
+    /// from inside it. Measure and correct rather than trust.
+    private static func normaliseScale(_ entity: Entity) {
+        let extent = entity.visualBounds(relativeTo: nil).extents
+        let widest = max(extent.x, extent.z)
+        guard widest > 0 else { return }
+        let ratio = widest / ConsoleMetrics.width
+        if ratio < 0.8 || ratio > 1.25 {
+            entity.scale = .one / ratio
+            fputs("[host] console: model measured \(widest) m wide, "
+                  + "scaled by \(1 / ratio)\n", stderr)
+        }
+    }
+
+    private static func fallbackBox(_ way: Colourway) -> ModelEntity {
+        var shell = PhysicallyBasedMaterial()
+        shell.baseColor = .init(tint: way.shell)
+        shell.roughness = .init(floatLiteral: 0.65)
+
+        let mesh = MeshResource.generateBox(
+            width: ConsoleMetrics.width,
+            height: ConsoleMetrics.height,
+            depth: ConsoleMetrics.depth,
+            cornerRadius: 0.008)
+        let body = ModelEntity(mesh: mesh, materials: [shell])
+
+        /* A green jewel on the lid, so the box still reads as the console. */
+        var jewel = PhysicallyBasedMaterial()
+        jewel.baseColor = .init(tint: way.jewel)
+        jewel.emissiveColor = .init(color: way.jewel)
+        jewel.emissiveIntensity = 1.5
+        let disc = ModelEntity(
+            mesh: MeshResource.generateCylinder(height: 0.002, radius: 0.028),
+            materials: [jewel])
+        disc.position = [0, ConsoleMetrics.height / 2 + 0.001, 0]
+        body.addChild(disc)
+        return body
+    }
+}
+
+/*
+ * Where the console was left. Placement is only useful if it survives a
+ * relaunch, otherwise every launch puts it back in front of your knees.
+ */
+enum ConsolePlacement {
+    private static let posKey = "xbawks.console.position"
+    private static let rotKey = "xbawks.console.rotation"
+
+    static func loadPosition() -> SIMD3<Float> {
+        guard let a = UserDefaults.standard.array(forKey: posKey) as? [Double],
+              a.count == 3 else {
+            return ConsoleMetrics.position
+        }
+        return SIMD3<Float>(Float(a[0]), Float(a[1]), Float(a[2]))
+    }
+
+    static func loadRotation() -> simd_quatf {
+        guard let a = UserDefaults.standard.array(forKey: rotKey) as? [Double],
+              a.count == 4 else {
+            return simd_quatf(angle: 0, axis: [0, 1, 0])
+        }
+        let q = simd_quatf(ix: Float(a[0]), iy: Float(a[1]),
+                           iz: Float(a[2]), r: Float(a[3]))
+        /*
+         * Only the turn about vertical survives a reload. An earlier build
+         * allowed rotation about any axis, so a console saved while tipped
+         * would come back tipped forever with no way to level it. Taking
+         * the yaw out of whatever was stored fixes that in place.
+         */
+        let forward = q.act(SIMD3<Float>(0, 0, 1))
+        return simd_quatf(angle: atan2(forward.x, forward.z), axis: [0, 1, 0])
+    }
+
+    static func save(position p: SIMD3<Float>, rotation q: simd_quatf) {
+        UserDefaults.standard.set([Double(p.x), Double(p.y), Double(p.z)],
+                                  forKey: posKey)
+        UserDefaults.standard.set([Double(q.imag.x), Double(q.imag.y),
+                                   Double(q.imag.z), Double(q.real)],
+                                  forKey: rotKey)
+    }
+}
+
+/*
+ * Where the real surfaces are, so the console can be put down on a table
+ * rather than through it.
+ *
+ * Plane detection rather than scene reconstruction: a table is a
+ * horizontal plane with a known extent, which is exactly the question
+ * being asked, and the mesh would have to be raycast against for the same
+ * answer at more cost. Authorisation can be refused, and a refusal is not
+ * an error here: without it the console simply moves freely, which is how
+ * it behaved before any of this existed.
+ */
+@MainActor
+final class SurfaceFinder {
+    private struct Surface {
+        let y: Float
+        /// World to extent space. Used rather than a yaw angle because the
+        /// extent already carries its own rotation and inverting the
+        /// transform cannot get the convention wrong the way pulling an
+        /// angle out of it can.
+        let extentFromWorld: simd_float4x4
+        let halfWidth: Float
+        let halfDepth: Float
+
+        func contains(_ x: Float, _ z: Float) -> Bool {
+            let local = extentFromWorld * SIMD4<Float>(x, y, z, 1)
+            return abs(local.x) <= halfWidth && abs(local.z) <= halfDepth
+        }
+    }
+
+    private var surfaces: [UUID: Surface] = [:]
+    private var session: ARKitSession?
+    private var misses = 0
+
+    func start() async {
+        let session = ARKitSession()
+        self.session = session
+
+        let result = await session.requestAuthorization(for: [.worldSensing])
+        guard result[.worldSensing] == .allowed else {
+            fputs("[host] surfaces: world sensing refused, the console will "
+                  + "move freely\n", stderr)
+            fflush(stderr)
+            return
+        }
+
+        let provider = PlaneDetectionProvider(alignments: [.horizontal])
+        do {
+            try await session.run([provider])
+        } catch {
+            fputs("[host] surfaces: plane detection failed (\(error))\n",
+                  stderr)
+            fflush(stderr)
+            return
+        }
+        fputs("[host] surfaces: looking for tables and floors\n", stderr)
+        fflush(stderr)
+
+        for await update in provider.anchorUpdates {
+            let a = update.anchor
+            switch update.event {
+            case .removed:
+                surfaces.removeValue(forKey: a.id)
+            case .added, .updated:
+                /*
+                 * The extent has its own transform within the anchor, so
+                 * the surface's real centre and rotation are the product
+                 * of the two, not the anchor alone.
+                 */
+                let worldFromExtent = a.originFromAnchorTransform
+                                      * a.geometry.extent.anchorFromExtentTransform
+                surfaces[a.id] = Surface(
+                    y: worldFromExtent.columns.3.y,
+                    extentFromWorld: worldFromExtent.inverse,
+                    halfWidth: a.geometry.extent.width / 2,
+                    halfDepth: a.geometry.extent.height / 2)
+            }
+        }
+    }
+
+    /// The height to rest an object of this height at, given where it is
+    /// being dragged to. Picks the highest surface that is under the
+    /// object and actually beneath the drag, so lifting it over a table
+    /// puts it on the table and dragging it off the edge drops it to the
+    /// floor. Returns nil when nothing is under it.
+    func restingY(x: Float, z: Float, draggedTo y: Float,
+                  objectHeight: Float) -> Float? {
+        var best: Float?
+        for s in surfaces.values where s.contains(x, z) {
+            /*
+             * Only surfaces at or below where the hand is, plus a little.
+             * Without that margin a table found slightly above the drag
+             * would snatch the console upward the moment it passed
+             * underneath, which feels like the object fighting back.
+             */
+            guard s.y <= y + 0.12 else { continue }
+            if best == nil || s.y > best! { best = s.y }
+        }
+        guard let top = best else {
+            /* Logged once in a while, because a silent nil here is
+             * indistinguishable from the feature not being built. */
+            misses += 1
+            if misses == 1 || misses % 500 == 0 {
+                fputs("[host] surfaces: nothing under the console "
+                      + "(\(surfaces.count) known, miss \(misses))\n",
+                      stderr)
+                fflush(stderr)
+            }
+            return nil
+        }
+        return top + objectHeight / 2
+    }
+}
diff --git a/ui/xbawks-picker.swift b/ui/xbawks-picker.swift
new file mode 100644
index 0000000..1ae2184
--- /dev/null
+++ b/ui/xbawks-picker.swift
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026 A. Cervantez
+//
+//  xbawks-picker.swift
+//
+//  Discs as a Cover Flow deck. Ported from SaveCoverFlow in the Quake port,
+//  which took it from swiftui-gallery-seed. The three things that are not
+//  obvious are carried over verbatim rather than rediscovered:
+//
+//  1. `.contentMargins(..., for: .scrollContent)` is LOAD-BEARING and is not
+//     centring. Insetting by half a column less half a card shrinks the
+//     measured region to exactly one card, so only the centred card reaches
+//     `.identity` and every other card gets a tilt. Remove it as redundant
+//     and several cards sit flat in the middle with no Cover Flow at all.
+//  2. `ScrollTransitionPhase` gives three keyframes (-1, 0, +1), not a
+//     continuous value. No easing can live in that closure; the constants
+//     below are the entire design surface.
+//  3. `rotation3DEffect`'s `perspective:` label chooses the overload. With it
+//     you get the flat projection; without it Swift resolves to the
+//     RotationAxis3D overload, a true depth rotation that the window's depth
+//     budget may clip. Keeping the flat one.
+//
+//  Changed from the Quake deck, deliberately: the cards are PORTRAIT, because
+//  an Xbox case is portrait and a game cover is not a screenshot. The deck is
+//  Xbox green rather than neutral.
+//
+import SwiftUI
+
+enum XbawksTheme {
+    /// The dashboard's green, sampled from the jewel rather than the logo.
+    static let green      = Color(red: 0.42, green: 0.80, blue: 0.11)
+    static let deepGreen  = Color(red: 0.05, green: 0.16, blue: 0.03)
+    static let dimGreen   = Color(red: 0.16, green: 0.34, blue: 0.08)
+
+    static func face(_ size: CGFloat, _ weight: Font.Weight = .regular) -> Font {
+        let name: String
+        switch weight {
+        case .bold:      name = "Oxanium-Bold"
+        case .semibold:  name = "Oxanium-SemiBold"
+        case .medium:    name = "Oxanium-Medium"
+        default:         name = "Oxanium-Regular"
+        }
+        return .custom(name, size: size)
+    }
+}
+
+enum DeckMetrics {
+    /// Portrait, because a game cover is a box. 2:3 is close to a DVD case.
+    static let cardWidth: CGFloat  = 190
+    static let cardHeight: CGFloat = 275
+    static let tiltDegrees: CGFloat = 55
+    /// How much the flankers overlap each other: the negative stack spacing.
+    static let flankerOverlapFraction: CGFloat = 0.32
+    /// How far an off-centre card is pushed AWAY from the hero. Positive means
+    /// away; negative looks plausible in a still and collapses it in motion.
+    static let flankerPushAwayFraction: CGFloat = 0.30
+
+    /// A tilted card is TALLER than its flat self, because the near edge is
+    /// magnified toward the viewer. Give the container exactly cardHeight and
+    /// that is where the corners get cut. Headroom is the fix; the multiplier
+    /// is empirical because the magnification depends on `perspective`.
+    static var deckHeight: CGFloat { cardHeight * 1.35 }
+
+    static func contentMargin(forWidth width: CGFloat) -> CGFloat {
+        max(0, (width - cardWidth) / 2)
+    }
+}
+
+struct DiscEntry: Identifiable, Hashable {
+    let id: String          // the filename, which is also the id
+    var title: String       // without the extension
+    var coverURL: URL?      // <same name>.jpg or .png beside the disc
+    var isDashboard: Bool = false
+}
+
+/// What is in Documents/GAMES, with each disc's cover if one sits beside
+/// it. Shared, because the deck is shown in two places now: the launcher
+/// window on a cold start, and the panel above the console mid session.
+enum DiscLibrary {
+    static func scan() -> [DiscEntry] {
+        var found: [DiscEntry] = []
+        if let c = xemu_host_list_discs() {
+            defer { free(c) }
+            let home = ProcessInfo.processInfo.environment["HOME"] ?? ""
+            let dir = URL(fileURLWithPath: home)
+                .appendingPathComponent("Documents/GAMES")
+            for name in String(cString: c).split(separator: "\n")
+                            .map(String.init).sorted() {
+                let stem = (name as NSString).deletingPathExtension
+                var cover: URL? = nil
+                for ext in ["jpg", "jpeg", "png"] {
+                    let u = dir.appendingPathComponent(stem)
+                              .appendingPathExtension(ext)
+                    if FileManager.default.fileExists(atPath: u.path) {
+                        cover = u
+                        break
+                    }
+                }
+                found.append(DiscEntry(id: name, title: stem, coverURL: cover))
+            }
+        }
+        found.append(DiscEntry(id: "__dashboard__", title: "Dashboard",
+                               coverURL: nil, isDashboard: true))
+        return found
+    }
+}
+
+struct DiscCoverFlow: View {
+    let discs: [DiscEntry]
+    @Binding var selectedIndex: Int
+    @State private var scrollID: Int?
+
+    private var revision: [String] { discs.map(\.id) }
+
+    var body: some View {
+        GeometryReader { geo in
+            ScrollView(.horizontal) {
+                LazyHStack(spacing: -DeckMetrics.cardWidth
+                                    * DeckMetrics.flankerOverlapFraction) {
+                    ForEach(Array(discs.enumerated()), id: \.element.id) { index, disc in
+                        card(disc, at: index).id(index)
+                    }
+                }
+                .scrollTargetLayout()
+            }
+            .scrollTargetBehavior(.viewAligned)
+            .scrollPosition(id: $scrollID)
+            .scrollIndicators(.hidden)
+            // Not centring. See note 1 at the top.
+            .contentMargins(.horizontal,
+                            DeckMetrics.contentMargin(forWidth: geo.size.width),
+                            for: .scrollContent)
+            // No scrollClipDisabled, deliberately: it lets the deck spill
+            // across the whole window. The mask is what stops the clip being
+            // visible, by fading cards to nothing before the boundary.
+            .id(revision)
+        }
+        .frame(height: DeckMetrics.deckHeight)
+        .mask {
+            LinearGradient(stops: [.init(color: .clear, location: 0),
+                                   .init(color: .black, location: 0.06),
+                                   .init(color: .black, location: 0.94),
+                                   .init(color: .clear, location: 1)],
+                           startPoint: .leading, endPoint: .trailing)
+        }
+        .onChange(of: selectedIndex, initial: true) { _, index in
+            guard scrollID != index else { return }
+            withAnimation(.snappy(duration: 0.28)) { scrollID = index }
+        }
+        .onChange(of: scrollID) { _, id in
+            guard let id, id != selectedIndex else { return }
+            selectedIndex = id
+        }
+    }
+
+    private func card(_ disc: DiscEntry, at index: Int) -> some View {
+        let isCentre = index == selectedIndex
+        return face(disc, isCentre: isCentre)
+            .frame(width: DeckMetrics.cardWidth, height: DeckMetrics.cardHeight)
+            // Before the transform, so the gaze highlight follows the rotated
+            // geometry rather than an untilted rectangle.
+            .contentShape(.hoverEffect, RoundedRectangle(cornerRadius: 12))
+            .hoverEffect()
+            .zIndex(Double(discs.count - abs(index - selectedIndex)))
+            .scrollTransition(.interactive, axis: .horizontal) { content, phase in
+                content
+                    .rotation3DEffect(.degrees(phase.value * -DeckMetrics.tiltDegrees),
+                                      axis: (x: 0, y: 1, z: 0), perspective: 0.7)
+                    .scaleEffect(phase.isIdentity ? 1 : 0.78)
+                    .offset(x: phase.value * DeckMetrics.cardWidth
+                               * DeckMetrics.flankerPushAwayFraction)
+                    .opacity(1 - 0.25 * abs(phase.value))
+            }
+            // SELECTS, never loads. In the Quake deck a tap that loaded fired
+            // by accident, because the gesture that summons the window
+            // releases over the window the instant it appears. Loading gets
+            // its own button.
+            .onTapGesture { selectedIndex = index }
+            .accessibilityLabel(disc.title)
+    }
+
+    private func face(_ disc: DiscEntry, isCentre: Bool) -> some View {
+        ZStack(alignment: .bottom) {
+            // A solid, not a material: material is near-invisible against
+            // visionOS glass. Drawn under the cover too, so a cover that
+            // fails to decode shows the plain card rather than a hole.
+            RoundedRectangle(cornerRadius: 12)
+                .fill(LinearGradient(colors: [XbawksTheme.deepGreen,
+                                              Color(white: 0.04)],
+                                     startPoint: .topLeading,
+                                     endPoint: .bottomTrailing))
+
+            if disc.isDashboard {
+                VStack(spacing: 10) {
+                    Image(systemName: "house.fill")
+                        .font(.system(size: 44))
+                        .foregroundStyle(XbawksTheme.green)
+                    Text("DASHBOARD")
+                        .font(XbawksTheme.face(13, .bold))
+                        .foregroundStyle(XbawksTheme.green)
+                        .tracking(2)
+                }
+                .frame(maxHeight: .infinity)
+            } else if let cover = disc.coverURL,
+                      let image = UIImage(contentsOfFile: cover.path) {
+                Image(uiImage: image)
+                    .resizable()
+                    .aspectRatio(contentMode: .fill)
+                    // Pinned and cropped, so the PICTURE cannot decide how big
+                    // the CARD is. `.fill` may report a size larger than it
+                    // was offered and a ZStack takes its largest child.
+                    .frame(width: DeckMetrics.cardWidth,
+                           height: DeckMetrics.cardHeight)
+                    .clipped()
+            } else {
+                // No cover: the title, large, on the green.
+                Text(disc.title)
+                    .font(XbawksTheme.face(20, .bold))
+                    .foregroundStyle(XbawksTheme.green.opacity(0.9))
+                    .multilineTextAlignment(.center)
+                    .padding(16)
+                    .frame(maxHeight: .infinity)
+            }
+
+            caption(disc)
+        }
+        .clipShape(RoundedRectangle(cornerRadius: 12))
+        // An OVERLAY, not another ZStack child: a child sized to .infinity
+        // makes the stack as large as it is allowed to be.
+        .overlay {
+            RoundedRectangle(cornerRadius: 12)
+                .strokeBorder(isCentre ? XbawksTheme.green.opacity(0.75)
+                                       : .white.opacity(0.12),
+                              lineWidth: isCentre ? 2 : 1)
+        }
+        .shadow(color: isCentre ? XbawksTheme.green.opacity(0.35)
+                                : .black.opacity(0.3),
+                radius: isCentre ? 14 : 4, y: isCentre ? 6 : 2)
+    }
+
+    private func caption(_ disc: DiscEntry) -> some View {
+        Text(disc.isDashboard ? "No disc" : disc.title)
+            .font(XbawksTheme.face(12, .semibold))
+            .lineLimit(2)
+            .foregroundStyle(.white)
+            .padding(8)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(
+                LinearGradient(colors: [.black.opacity(0.0), .black.opacity(0.88)],
+                               startPoint: .top, endPoint: .bottom))
+    }
+}
