+                note: "The paler clear-green debug kit, 5,000 to 10,000",
+                shell: 0x7FC48A, opacity: 0.35, finish: .gloss,
+                jewel: greenJewel, ring: ring, trim: 0x5FA86A, glow: 0xB8F0B8),
+    ]
+
+    /// The edition with this id; Standard Black for nil or an id no longer
+    /// in the table (a renamed look must not leave a console unpainted).
+    static func named(_ id: String?) -> Edition {
+        all.first { $0.id == id } ?? standardBlack
+    }
+
+    static let savedKey = "xbawks.console.edition"
+
+    static var saved: Edition {
+        get { named(UserDefaults.standard.string(forKey: savedKey)) }
+        set { UserDefaults.standard.set(newValue.id, forKey: savedKey) }
+    }
+}
+
+/// The parts of the console model that are painted separately.
+enum ConsolePart: Equatable {
+    case shell, jewel, ring, trim, interior
+}
+
+/*
+ * Which part a mesh belongs to, from its own name and its ancestors'
+ * (first the mesh, then outward). The model's named parts ("Jewel Gloss --
+ * Opaque", "Eject Button Ring Light", "Rear Long Fins") are parents of
+ * meshes called "Cylinder.004" and the like, so matching the mesh alone
+ * painted everything as shell, black. The first name that is not shell
+ * decides; the ring is checked before "button" because it is the eject
+ * button's ring.
+ */
+func consolePart(names: [String]) -> ConsolePart {
+    for raw in names {
+        let n = raw.lowercased()
+        if n.contains("ring light") || n.contains("ring_light")
+            || n.contains("ringlight") {
+            return .ring
+        }
+        if n.contains("jewel") {
+            return .jewel
+        }
+        if n.contains("internal shield") || n.contains("internal_shield") {
+            return .interior
+        }
+        if n.contains("button") || n.contains("port") || n.contains("fins")
+            || n.contains("feet") || n.contains("rj45") {
+            return .trim
+        }
+    }
+    return .shell
+}
+
+/*
+ * The kind of controller, for the picker's choice. Every PSVR2 Sense name
+ * is one kind, "sense": the pair arrives as one combined "(L/R)" device
+ * when both are on before launch and as separate hands afterwards, and a
+ * saved choice has to match either. Anything else is its own name.
+ */
+func controllerKind(vendorName: String) -> String {
+    vendorName.contains("Sense Controller") ? "sense" : vendorName
+}
diff --git a/ui/xbawks-picker.swift b/ui/xbawks-picker.swift
new file mode 100644
index 0000000..7941af4
--- /dev/null
+++ b/ui/xbawks-picker.swift
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026 A. Cervantez
+//
+//  xbawks-picker.swift
+//
+//  Discs as a Cover Flow deck. Ported from SaveCoverFlow in the Quake port,
+//  which took it from swiftui-gallery-seed. The three things that are not
+//  obvious are carried over verbatim rather than rediscovered:
+//
+//  1. `.contentMargins(..., for: .scrollContent)` is LOAD-BEARING and is not
+//     centring. Insetting by half a column less half a card shrinks the
+//     measured region to exactly one card, so only the centred card reaches
+//     `.identity` and every other card gets a tilt. Remove it as redundant
+//     and several cards sit flat in the middle with no Cover Flow at all.
+//  2. `ScrollTransitionPhase` gives three keyframes (-1, 0, +1), not a
+//     continuous value. No easing can live in that closure; the constants
+//     below are the entire design surface.
+//  3. `rotation3DEffect`'s `perspective:` label chooses the overload. With it
+//     you get the flat projection; without it Swift resolves to the
+//     RotationAxis3D overload, a true depth rotation that the window's depth
+//     budget may clip. Keeping the flat one.
+//
+//  Changed from the Quake deck, deliberately: the cards are PORTRAIT, because
+//  an Xbox case is portrait and a game cover is not a screenshot. The deck is
+//  Xbox green rather than neutral.
+//
+import SwiftUI
+
+enum XbawksTheme {
+    /// The dashboard's green, sampled from the jewel rather than the logo.
+    static let green      = Color(red: 0.42, green: 0.80, blue: 0.11)
+    static let deepGreen  = Color(red: 0.05, green: 0.16, blue: 0.03)
+    static let dimGreen   = Color(red: 0.16, green: 0.34, blue: 0.08)
+
+    static func face(_ size: CGFloat, _ weight: Font.Weight = .regular) -> Font {
+        let name: String
+        switch weight {
+        case .bold:      name = "Oxanium-Bold"
+        case .semibold:  name = "Oxanium-SemiBold"
+        case .medium:    name = "Oxanium-Medium"
+        default:         name = "Oxanium-Regular"
+        }
+        return .custom(name, size: size)
+    }
+}
+
+enum DeckMetrics {
+    /// Portrait, because a game cover is a box. 2:3 is close to a DVD case.
+    static let cardWidth: CGFloat  = 190
+    static let cardHeight: CGFloat = 275
+    static let tiltDegrees: CGFloat = 55
+    /// How much the flankers overlap each other: the negative stack spacing.
+    static let flankerOverlapFraction: CGFloat = 0.32
+    /// How far an off-centre card is pushed AWAY from the hero. Positive means
+    /// away; negative looks plausible in a still and collapses it in motion.
+    static let flankerPushAwayFraction: CGFloat = 0.30
+
+    /// A tilted card is TALLER than its flat self, because the near edge is
+    /// magnified toward the viewer. Give the container exactly cardHeight and
+    /// that is where the corners get cut. Headroom is the fix; the multiplier
+    /// is empirical because the magnification depends on `perspective`.
+    static var deckHeight: CGFloat { cardHeight * 1.35 }
+
+    static func contentMargin(forWidth width: CGFloat) -> CGFloat {
+        max(0, (width - cardWidth) / 2)
+    }
+}
+
+struct DiscEntry: Identifiable, Hashable {
+    let id: String          // the filename, which is also the id
+    var title: String       // without the extension
+    var coverURL: URL?      // <same name>.jpg or .png beside the disc
+    var isDashboard: Bool = false
+}
+
+/// What is in Documents/GAMES, with each disc's cover if one sits beside
+/// it. Shared, because the deck is shown in two places now: the launcher
+/// window on a cold start, and the panel above the console mid session.
+enum DiscLibrary {
+    static func scan() -> [DiscEntry] {
+        var found: [DiscEntry] = []
+        if let c = xemu_host_list_discs() {
+            defer { free(c) }
+            let home = ProcessInfo.processInfo.environment["HOME"] ?? ""
+            let dir = URL(fileURLWithPath: home)
+                .appendingPathComponent("Documents/GAMES")
+            for name in String(cString: c).split(separator: "\n")
+                            .map(String.init).sorted() {
+                let stem = (name as NSString).deletingPathExtension
+                var cover: URL? = nil
+                for ext in ["jpg", "jpeg", "png"] {
+                    let u = dir.appendingPathComponent(stem)
+                              .appendingPathExtension(ext)
+                    if FileManager.default.fileExists(atPath: u.path) {
+                        cover = u
+                        break
+                    }
+                }
+                found.append(DiscEntry(id: name, title: stem, coverURL: cover))
+            }
+        }
+        found.append(DiscEntry(id: "__dashboard__", title: "Dashboard",
+                               coverURL: nil, isDashboard: true))
+        return found
+    }
+}
+
+struct DiscCoverFlow: View {
+    let discs: [DiscEntry]
+    @Binding var selectedIndex: Int
+    @State private var scrollID: Int?
+
+    private var revision: [String] { discs.map(\.id) }
+
+    var body: some View {
+        GeometryReader { geo in
+            ScrollView(.horizontal) {
+                LazyHStack(spacing: -DeckMetrics.cardWidth
+                                    * DeckMetrics.flankerOverlapFraction) {
+                    ForEach(Array(discs.enumerated()), id: \.element.id) { index, disc in
+                        card(disc, at: index).id(index)
+                    }
+                }
+                .scrollTargetLayout()
+            }
+            .scrollTargetBehavior(.viewAligned)
+            /*
+             * Centre anchored, so the snap grid is "a card's centre on the
+             * deck's centre" by construction. With the default leading
+             * anchor the grid is "a card's leading edge on the leading
+             * margin", which is only centred if the margin below was
+             * computed from the width the scroll view really has; after
+             * the cold-launch rebuild it was not, and cards rested a
+             * fraction of a stride off, at angles that never settled
+             * (2026-11-15).
+             */
+            .scrollPosition(id: $scrollID, anchor: .center)
+            .scrollIndicators(.hidden)
+            // Not centring. See note 1 at the top.
+            .contentMargins(.horizontal,
+                            DeckMetrics.contentMargin(forWidth: geo.size.width),
+                            for: .scrollContent)
+            // No scrollClipDisabled, deliberately: it lets the deck spill
+            // across the whole window. The mask is what stops the clip being
+            // visible, by fading cards to nothing before the boundary.
+            .id(revision)
+            .onScrollPhaseChange { _, phase, context in
+                /* Where the deck came to rest, in strides. A whole number
+                 * is a card on the centre; anything else is the bug. */
+                guard phase == .idle else { return }
+                let stride = DeckMetrics.cardWidth
+                    * (1 - DeckMetrics.flankerOverlapFraction)
+                let g = context.geometry
+                let inset = g.contentInsets.leading
+                let strides = (g.contentOffset.x + inset) / stride
+                fputs("[host] deck rest: offset \(Int(g.contentOffset.x)) "
+                      + "inset \(Int(inset)) visible \(Int(g.visibleRect.width)) "
+                      + "geo \(Int(geo.size.width)) = \(String(format: "%.2f", strides)) "
+                      + "strides, selected \(selectedIndex), id \(String(describing: scrollID))\n",
+                      stderr)
+            }
+        }
+        .frame(height: DeckMetrics.deckHeight)
+        .mask {
+            LinearGradient(stops: [.init(color: .clear, location: 0),
+                                   .init(color: .black, location: 0.06),
+                                   .init(color: .black, location: 0.94),
+                                   .init(color: .clear, location: 1)],
+                           startPoint: .leading, endPoint: .trailing)
+        }
+        .onChange(of: selectedIndex, initial: true) { _, index in
+            guard scrollID != index else { return }
+            withAnimation(.snappy(duration: 0.28)) { scrollID = index }
+        }
+        .onChange(of: scrollID) { _, id in
+            guard let id, id != selectedIndex else { return }
+            selectedIndex = id
+        }
+    }
+
+    private func card(_ disc: DiscEntry, at index: Int) -> some View {
+        let isCentre = index == selectedIndex
+        return face(disc, isCentre: isCentre)
+            .frame(width: DeckMetrics.cardWidth, height: DeckMetrics.cardHeight)
+            // Before the transform, so the gaze highlight follows the rotated
+            // geometry rather than an untilted rectangle.
+            .contentShape(.hoverEffect, RoundedRectangle(cornerRadius: 12))
+            .hoverEffect()
+            .zIndex(Double(discs.count - abs(index - selectedIndex)))
+            /*
+             * Each card's look comes from its own distance to the centre of
+             * the visible deck, measured here, not from the scroll
+             * transition's phase. The phase is derived from a region the
+             * content margins are supposed to narrow to one card, and after
+             * the empty-then-populated rebuild on a cold launch that region
+             * came out two cards wide: two flat, full-size cards sat on top
+             * of each other and no amount of scrolling separated them
+             * (2026-11-15). Card centres are a fixed stride apart, so at most
+             * one card can be within half a stride of the centre.
+             */
+            .visualEffect { content, proxy in
+                let visible = proxy.bounds(of: .scrollView)
+                    ?? CGRect(origin: .zero, size: proxy.size)
+                let distance = proxy.size.width / 2 - visible.midX
+                let stride = DeckMetrics.cardWidth
+                    * (1 - DeckMetrics.flankerOverlapFraction)
+                let phase = max(-1, min(1, distance / stride))
+                let centred = abs(distance) < stride / 2
+                return content
+                    .rotation3DEffect(.degrees(phase * -DeckMetrics.tiltDegrees),
+                                      axis: (x: 0, y: 1, z: 0), perspective: 0.7)
+                    .scaleEffect(centred ? 1 : 0.78)
+                    .offset(x: phase * DeckMetrics.cardWidth
+                               * DeckMetrics.flankerPushAwayFraction)
+                    .opacity(1 - 0.25 * abs(phase))
+            }
+            // SELECTS, never loads. In the Quake deck a tap that loaded fired
+            // by accident, because the gesture that summons the window
+            // releases over the window the instant it appears. Loading gets
+            // its own button.
+            .onTapGesture { selectedIndex = index }
+            .accessibilityLabel(disc.title)
+    }
+
+    private func face(_ disc: DiscEntry, isCentre: Bool) -> some View {
+        ZStack(alignment: .bottom) {
+            // A solid, not a material: material is near-invisible against
+            // visionOS glass. Drawn under the cover too, so a cover that
+            // fails to decode shows the plain card rather than a hole.
+            RoundedRectangle(cornerRadius: 12)
+                .fill(LinearGradient(colors: [XbawksTheme.deepGreen,
+                                              Color(white: 0.04)],
+                                     startPoint: .topLeading,
+                                     endPoint: .bottomTrailing))
+
+            if disc.isDashboard {
+                VStack(spacing: 10) {
+                    Image(systemName: "house.fill")
+                        .font(.system(size: 44))
+                        .foregroundStyle(XbawksTheme.green)
+                    Text("DASHBOARD")
+                        .font(XbawksTheme.face(13, .bold))
+                        .foregroundStyle(XbawksTheme.green)
+                        .tracking(2)
+                }
+                .frame(maxHeight: .infinity)
+            } else if let cover = disc.coverURL,
+                      let image = UIImage(contentsOfFile: cover.path) {
+                Image(uiImage: image)
+                    .resizable()
+                    .aspectRatio(contentMode: .fill)
+                    // Pinned and cropped, so the PICTURE cannot decide how big
+                    // the CARD is. `.fill` may report a size larger than it
+                    // was offered and a ZStack takes its largest child.
+                    .frame(width: DeckMetrics.cardWidth,
+                           height: DeckMetrics.cardHeight)
+                    .clipped()
+            } else {
+                // No cover: the title, large, on the green.
+                Text(disc.title)
+                    .font(XbawksTheme.face(20, .bold))
+                    .foregroundStyle(XbawksTheme.green.opacity(0.9))
+                    .multilineTextAlignment(.center)
+                    .padding(16)
+                    .frame(maxHeight: .infinity)
+            }
+
+            caption(disc)
+        }
+        .clipShape(RoundedRectangle(cornerRadius: 12))
+        // An OVERLAY, not another ZStack child: a child sized to .infinity
+        // makes the stack as large as it is allowed to be.
+        .overlay {
+            RoundedRectangle(cornerRadius: 12)
+                .strokeBorder(isCentre ? XbawksTheme.green.opacity(0.75)
+                                       : .white.opacity(0.12),
+                              lineWidth: isCentre ? 2 : 1)
+        }
+        .shadow(color: isCentre ? XbawksTheme.green.opacity(0.35)
+                                : .black.opacity(0.3),
+                radius: isCentre ? 14 : 4, y: isCentre ? 6 : 2)
+    }
+
+    private func caption(_ disc: DiscEntry) -> some View {
+        Text(disc.isDashboard ? "No disc" : disc.title)
+            .font(XbawksTheme.face(12, .semibold))
+            .lineLimit(2)
+            .foregroundStyle(.white)
+            .padding(8)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(
+                LinearGradient(colors: [.black.opacity(0.0), .black.opacity(0.88)],
+                               startPoint: .top, endPoint: .bottom))
+    }
+}
diff --git a/ui/xemu-host-app.swift b/ui/xemu-host-app.swift
new file mode 100644
index 0000000..e294825
--- /dev/null
+++ b/ui/xemu-host-app.swift
@@ -0,0 +1,839 @@
+// The entry point, and now the screen.
+//
+// Measured on 2026-10-29: a spatial controller (the PSVR2 Sense pair)
+// delivers buttons and sticks to an app only while an immersive space is
+// open, and only while the user is not looking at one of the app's
+// windows; gaze on a window turns the controller back into that window's
+// pointer. So there is no window. The app launches straight into a mixed
+// immersive space and the guest's frame is a plane in it, textured from
+// the same BGRA copies the sampler publishes. Everything else stays in
+// the Objective-C shell, reached through xemu-host-bridge.h.
+import SwiftUI
+import RealityKit
+import Metal
+import UIKit
+
+@main struct XbawksApp: App {
+    @UIApplicationDelegateAdaptor(XbawksAppDelegate.self) var delegate
+
+    /// Reads the controllers on a display link. It is a view controller
+    /// because it was one when the frame lived in a window; its view is
+    /// never shown now and the display link does not care.
+    nonisolated(unsafe) static var ticker: XemuScreenViewController?
+
+    /// Wall clock from app start, so the boot sequence can be timed rather
+    /// than guessed at. Startup frame rate has now been blamed on two
+    /// different things without either being measured.
+    nonisolated(unsafe) static let launchedAt = Date()
+
+    static func sinceLaunch() -> String {
+        String(format: "%.2fs", Date().timeIntervalSince(launchedAt))
+    }
+
+    /*
+     * Whether the screen is up. The launcher is rebuilt from scratch every
+     * time it is summoned, so it cannot remember this itself, and it needs
+     * to know: reopening the window to swap a disc must not try to open a
+     * space that is already open.
+     */
+    @MainActor static var spaceIsOpen = false
+
+    init() {
+        xemu_host_prepare()
+        let vc = XemuScreenViewController()
+        vc.loadViewIfNeeded()
+        XbawksApp.ticker = vc
+    }
+
+    var body: some SwiftUI.Scene {
+        /*
+         * The default scene, and the only window: a small launcher that
+         * opens the space and dismisses itself. It exists so the app has
+         * something the system can bring back when its icon is tapped
+         * after the space was dismissed (found by the owner: without it
+         * the app could not be reopened), and it is gone while playing so
+         * there is nothing of the app's to look at.
+         */
+        /*
+         * A WindowGroup, with a guard. This was a Window, the single
+         * instance kind, so that pressing the console twice could not give
+         * two decks; the deck has since moved into the immersive space and
+         * nothing in the app opens this window any more. But visionOS keeps
+         * scene sessions for the app and reconnects them at launch, and
+         * when it handed over a second launcher scene SwiftUI ended the
+         * process ("the matching Window in your app body is already
+         * connected"), which Apparition saw as brk #0x1 before the JIT
+         * request. Every such crash left another stale session, so it got
+         * more likely each time. A WindowGroup accepts the extra scene; the
+         * launcher that goes active (the one actually on screen) stays and
+         * the others close, and stale sessions are destroyed at launch so
+         * they stop accumulating. Keeping the first or the newest arrival
+         * each kept an invisible stale one in some launch.
+         */
+        WindowGroup("XBAWKS", id: "launcher") {
+            LauncherView()
+        }
+        /*
+         * Sized by its content, not a fixed 760 by 620: the notices (no
+         * Apparition, one controller) add lines, and a fixed height cut off
+         * the title, ended the notices in an ellipsis and dropped Rescan.
+         */
+        .windowResizability(.contentSize)
+        .restorationBehavior(.disabled)
+
+        ImmersiveSpace(id: "screen") {
+            ScreenSpace()
+                .onAppear {
+                    XbawksApp.spaceIsOpen = true
+                    fputs("[host] boot \(XbawksApp.sinceLaunch()): "
+                          + "screen appeared\n", stderr)
+                    fputs("[host] immersive space appeared\n", stderr); fflush(stderr)
+                }
+                .onDisappear {
+                    XbawksApp.spaceIsOpen = false
+                    fputs("[host] immersive space disappeared\n", stderr); fflush(stderr)
+                }
+        }
+        .immersionStyle(selection: .constant(.mixed), in: .mixed)
+    }
+}
+
+struct LauncherView: View {
+    @Environment(\.openImmersiveSpace) private var openImmersive
+    @Environment(\.dismissWindow) private var dismissWindow
+    @Environment(\.dismiss) private var dismissThis
+    @Environment(\.scenePhase) private var phase
+    /// Each launcher scene takes a number as it appears. The one that goes
+    /// active is the window on screen and stays; any other launcher closes.
+    /// Neither the first nor the newest to arrive is reliably the visible
+    /// one: visionOS reconnects stale sessions in either order and leaves
+    /// them in the background.
+    @MainActor static var count = 0
+    @State private var mine = 0
+    @State private var status = ""
+    @State private var discs: [DiscEntry] = []
+    @State private var selected = 0
+    @State private var started = xemu_host_started()
+    /// The JIT cannot start without a debugger attached. Checked before a
+    /// disc is chosen, and again every second while the picker is up, so
+    /// the reason is on the screen instead of only in the log.
+    @State private var traced = xemu_host_debugger_attached()
+    /// One Sense hand on its own: the other was turned on after launch.
+    @State private var oneHand = xemu_host_one_sense_hand()
+
+    var body: some View {
+        ZStack {
+            // Translucent green, over the system glass rather than instead of
+            // it, so the window still reads as a visionOS window.
+            XbawksTheme.deepGreen.opacity(0.55).ignoresSafeArea()
+
+            VStack(spacing: 18) {
+                Text("XBAWKS")
+                    .font(XbawksTheme.face(34, .bold))
+                    .foregroundStyle(XbawksTheme.green)
+                    .tracking(8)
+                    .shadow(color: XbawksTheme.green.opacity(0.5), radius: 12)
+
+                if started {
+                    /*
+                     * Summoned from the console mid session. The deck is
+                     * the same one, so a swap looks exactly like the first
+                     * choice did, and the screen is still running behind
+                     * this window the whole time.
+                     */
+                    Text(status).font(XbawksTheme.face(13))
+                        .foregroundStyle(.secondary)
+
+                    DiscCoverFlow(discs: discs, selectedIndex: $selected)
+
+                    HStack(spacing: 18) {
+                        Button {
+                            swap(discs.indices.contains(selected)
+                                 ? discs[selected] : nil)
+                        } label: {
+                            Text("SWAP DISC")
+                                .font(XbawksTheme.face(16, .bold))
+                                .tracking(3)
+                                .padding(.horizontal, 26).padding(.vertical, 6)
+                        }
+                        .tint(XbawksTheme.dimGreen)
+                        .disabled(discs.indices.contains(selected)
+                                  && discs[selected].isDashboard)
+
+                        Button {
+                            xemu_host_eject_disc()
+                            back()
+                        } label: {
+                            Text("EJECT")
+                                .font(XbawksTheme.face(16, .bold))
+                                .tracking(3)
+                                .padding(.horizontal, 26).padding(.vertical, 6)
+                        }
+                        .tint(XbawksTheme.dimGreen)
+                    }
+
+                    Text("Swapping resets the console, because it reads its "
+                         + "disc when it boots. Eject just opens the tray.")
+                        .font(XbawksTheme.face(11))
+                        .foregroundStyle(.secondary)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal, 40)
+
+                    Button(XbawksApp.spaceIsOpen ? "Back to the game"
+                                                   : "Resume") {
+                        if XbawksApp.spaceIsOpen {
+                            back()
+                        } else {
+                            Task { await open() }
+                        }
+                    }
+                    .font(XbawksTheme.face(11))
+                    .buttonStyle(.plain)
+                    .foregroundStyle(XbawksTheme.green.opacity(0.8))
+                } else {
+                    DiscCoverFlow(discs: discs, selectedIndex: $selected)
+
+                    if oneHand {
+                        VStack(spacing: 4) {
+                            Text("ONE CONTROLLER")
+                                .font(XbawksTheme.face(12, .bold))
+                                .tracking(3)
+                                .foregroundStyle(.orange)
+                            Text("Only one Sense controller reached Xbawks, so it will "
+                                 + "drive both sticks. Turn both controllers on, then "
+                                 + "quit and relaunch: visionOS only hands over the pair "
+                                 + "when both are on before the app starts.")
+                                .font(XbawksTheme.face(11))
+                                .foregroundStyle(.secondary)
+                                .multilineTextAlignment(.center)
+                                .padding(.horizontal, 40)
+                        }
+                        .padding(.vertical, 6)
+                    }
+
+                    if !traced {
+                        VStack(spacing: 4) {
+                            Text("NEEDS APPARITION")
+                                .font(XbawksTheme.face(12, .bold))
+                                .tracking(3)
+                                .foregroundStyle(.orange)
+                            Text("visionOS will not let an app make memory executable, "
+                                 + "so the emulator cannot start on its own. Quit this, "
+                                 + "then launch Xbawks from Apparition on a Mac on this "
+                                 + "network. It attaches for a moment and the JIT comes up.")
+                                .font(XbawksTheme.face(11))
+                                .foregroundStyle(.secondary)
+                                .multilineTextAlignment(.center)
+                                .padding(.horizontal, 40)
+                        }
+                        .padding(.vertical, 6)
+                    }
+
+                    Button {
+                        Task { await start(discs.indices.contains(selected)
+                                           ? discs[selected] : nil) }
+                    } label: {
+                        Text(discs.indices.contains(selected) && discs[selected].isDashboard
+                             ? "BOOT DASHBOARD" : "INSERT DISC")
+                            .font(XbawksTheme.face(16, .bold))
+                            .tracking(3)
+                            .padding(.horizontal, 26).padding(.vertical, 6)
+                    }
+                    .tint(XbawksTheme.dimGreen)
+                    .disabled(discs.isEmpty || !traced)
+
+                    Text("Discs go in Files, under XBAWKS then GAMES. "
+                         + "A .jpg or .png with the same name is its cover.")
+                        .font(XbawksTheme.face(11))
+                        .foregroundStyle(.secondary)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal, 40)
+
+                    Button("Rescan") { rescan() }
+                        .font(XbawksTheme.face(11))
+                        .buttonStyle(.plain)
+                        .foregroundStyle(XbawksTheme.green.opacity(0.8))
+                }
+            }
+            .padding(.vertical, 28)
+            /* Every line at its full height; the window grows to fit. */
+            .frame(width: 760)
+            .fixedSize(horizontal: false, vertical: true)
+        }
+        /* The width the launcher always had. The deck's horizontal scroller
+         * has no natural width, so without this the window sized to fit
+         * took it as a reason to go very wide. */
+        .frame(width: 760)
+        .onAppear {
+            LauncherView.count += 1
+            mine = LauncherView.count
+            if mine == 1 {
+                /* After launch has settled: a session still unconnected
+                 * then is stale, but at first appear the real window's
+                 * session may not have connected yet. */
+                Task { @MainActor in
+                    try? await Task.sleep(for: .seconds(5))
+                    LauncherView.dropStaleSessions()
+                }
+            }
+            if phase == .active {
+                claimScreen()
+            }
+        }
+        .onChange(of: phase) { _, now in
+            if now == .active {
+                claimScreen()
+            }
+        }
+        .onReceive(NotificationCenter.default.publisher(for: .xbawksLauncherSuperseded)) { n in
+            if let by = n.userInfo?["by"] as? Int, by != mine, phase != .active {
+                fputs("[host] launcher: scene \(mine) closing, scene \(by) is on screen\n", stderr)
+                fflush(stderr)
+                dismissThis()
+            }
+        }
+        .task {
+            /* Re-check the debugger and the controllers once a second until
+             * a game starts; either can change after the window is up. */
+            while !started {
+                let hand = xemu_host_one_sense_hand()
+                if hand != oneHand {
+                    oneHand = hand
+                    fputs("[host] launcher: one Sense hand only: \(hand)\n", stderr)
+                    fflush(stderr)
+                }
+                let now = xemu_host_debugger_attached()
+                if now != traced {
+                    traced = now
+                    fputs("[host] launcher: debugger \(now ? "attached" : "absent")\n", stderr)
+                    fflush(stderr)
+                }
+                try? await Task.sleep(for: .seconds(1))
+            }
+        }
+        .task {
+            rescan()
+            /*
+             * The screen opens straight away, so the console is in the
+             * room while a game is being chosen rather than appearing
+             * only once one has been. This window stays up on top of it,
+             * which is what we want during selection anyway: a controller
+             * belongs to the window being looked at.
+             *
+             * Not if it is already open. Summoned from the console mid
+             * session, opening it again either fails or dismisses the
+             * window that was just asked for.
+             */
+            if !XbawksApp.spaceIsOpen {
+                let result = await openImmersive(id: "screen")
+                fputs("[host] launcher: screen \(result)\n", stderr)
+                fflush(stderr)
+            }
+        }
+    }
+
+    /// This launcher is the one on screen: the others close.
+    @MainActor private func claimScreen() {
+        fputs("[host] launcher: scene \(mine) is on screen\n", stderr)
+        fflush(stderr)
+        NotificationCenter.default.post(name: .xbawksLauncherSuperseded,
+                                        object: nil, userInfo: ["by": mine])
+    }
+
+    /// Scene sessions visionOS is holding for windows that are not
+    /// connected are the stale launchers it would otherwise reconnect at
+    /// the next launch; ask for them to be destroyed so they stop piling
+    /// up. Immersive space sessions are left alone.
+    @MainActor static func dropStaleSessions() {
+        var dropped = 0
+        for session in UIApplication.shared.openSessions
+            where session.scene == nil && session.role == .windowApplication {
+            UIApplication.shared.requestSceneSessionDestruction(session,
+                                                                options: nil,
+                                                                errorHandler: nil)
+            dropped += 1
+        }
+        fputs("[host] launcher: \(UIApplication.shared.openSessions.count) scene sessions, "
+              + "\(dropped) stale dropped\n", stderr)
+        fflush(stderr)
+    }
+
+    private func rescan() {
+        started = xemu_host_started()
+        discs = DiscLibrary.scan()
+        if selected >= discs.count { selected = max(0, discs.count - 1) }
+    }
+
+    @MainActor private func start(_ disc: DiscEntry?) async {
+        let name = (disc?.isDashboard ?? true) ? nil : disc?.id
+        fputs("[host] launcher: start requested, disc=\(name ?? "dashboard")\n",
+              stderr)
+        fflush(stderr)
+        // Explicit, rather than relying on Swift bridging an optional String
+        // into a const char *. If that bridge quietly produced NULL the app
+        // would sit forever on the picker with no sign of why, which is what
+        // it did.
+        if let name {
+            name.withCString { xemu_host_start_with_disc($0) }
+        } else {
+            xemu_host_start_with_disc(nil)
+        }
+        started = true
+        if XbawksApp.spaceIsOpen {
+            dismissWindow(id: "launcher")
+        } else {
+            await open()
+        }
+    }
+
+    /// Hand the swap to C and get out of the way. The window has to go,
+    /// not just lose focus: a controller belongs to the app only while no
+    /// window of the app is being looked at.
+    @MainActor private func swap(_ disc: DiscEntry?) {
+        guard let disc, !disc.isDashboard else { return }
+        disc.id.withCString { xemu_host_load_disc($0) }
+        back()
+    }
+
+    @MainActor private func back() {
+        if XbawksApp.spaceIsOpen {
+            dismissWindow(id: "launcher")
+        } else {
+            Task { await open() }
+        }
+    }
+
+    @MainActor private func open() async {
+        let result = await openImmersive(id: "screen")
+        fputs("[host] launcher: immersive space \(result)\n", stderr); fflush(stderr)
+        switch result {
+        case .opened: dismissWindow(id: "launcher")
+        default: status = "could not open the screen (\(result)); try Resume"
+        }
+    }
+}
+
+/// A 4:3 screen two and a half metres ahead at eye height, two metres
+/// wide, fed thirty times a second from the published frame.
+struct ScreenSpace: View {
+    @State private var screen = GuestScreen()
+    @State private var surfaces = SurfaceFinder()
+
+    @State private var discs: [DiscEntry] = []
+    @State private var selected = 0
+    @State private var showPanel = false
+    @State private var panelOffset = ConsolePlacement.loadPanelOffset()
+    @State private var nudgeBase: SIMD2<Float>?
+
+    /*
+     * Which gesture owns the console. A two handed turn also drives the
+     * drag, which would then set the position from where that drag began,
+     * so the console snapped back to its last placed spot every time it
+     * was rotated. One claim at a time.
+     */
+    private enum Claim { case moving, turning }
+    @State private var claim: Claim?
+    @State private var pressBegan: Date?
+    /// When a move or turn last reported. A claim older than this with no
+    /// end in between belongs to a gesture the system cancelled, and
+    /// cancelled gestures never call onEnded.
+    @State private var claimTouched = Date.distantPast
+    private static let claimStale = 0.75
+    @State private var dragOrigin: SIMD3<Float>?
+    @State private var spinOrigin: simd_quatf?
+
+    /// Long enough that a quick flick is not a move.
+    private static let holdToAdjust = 0.25
+
+    private static let consoleName = "xbawks-console"
+    private static let panelID = "swap-panel"
+
+    var body: some View {
+        RealityView { content, attachments in
+            if let entity = screen.makeEntity() {
+                content.add(entity)
+            }
+            let t0 = Date()
+            let console = await XbawksConsole.make()
+            console.position = ConsolePlacement.loadPosition()
+            console.orientation = ConsolePlacement.loadRotation()
+            content.add(console)
+            fputs("[host] boot \(XbawksApp.sinceLaunch()): console ready "
+                  + "(\(String(format: "%.2fs", -t0.timeIntervalSinceNow)) "
+                  + "to build it)\n", stderr)
+            fflush(stderr)
+
+            if let panel = attachments.entity(for: Self.panelID) {
+                panel.name = Self.panelID
+                panel.position = Self.panelPosition(panelOffset)
+                /* Faces whoever is looking at it, so turning the console
+                 * does not swing the deck away. */
+                panel.components.set(BillboardComponent())
+                panel.isEnabled = false
+                console.addChild(panel)
+            }
+
+            screen.start()
+        } update: { _, attachments in
+            guard let panel = attachments.entity(for: Self.panelID) else {
+                return
+            }
+            panel.isEnabled = showPanel
+            panel.position = Self.panelPosition(panelOffset)
+        } attachments: {
+            Attachment(id: Self.panelID) {
+                SwapPanel(selected: $selected,
+                          discs: discs,
+                          onSwap: { disc in
+                              /*
+                               * Before anything has booted there is nothing
+                               * to swap: this is the first choice, so start
+                               * the machine with it, as the launcher does.
+                               * With the launcher window closed (or a
+                               * duplicate of it closed on arrival) the deck
+                               * in the room is where that choice is made.
+                               */
+                              if !xemu_host_started() {
+                                  if disc.isDashboard {
+                                      xemu_host_start_with_disc(nil)
+                                  } else {
+                                      disc.id.withCString { xemu_host_start_with_disc($0) }
+                                  }
+                              } else {
+                                  disc.id.withCString { xemu_host_load_disc($0) }
+                              }
+                              showPanel = false
+                          },
+                          onEject: {
+                              xemu_host_eject_disc()
+                              showPanel = false
+                          },
+                          onClose: { showPanel = false },
+                          onNudge: { translation, done in
+                              /*
+                               * The drag reports its total travel on every
+                               * event, so add it to where the panel was when
+                               * the drag began, not to where it is now.
+                               * Compounding it moved the panel 126 metres
+                               * under the floor and saved that (2026-11-15).
+                               */
+                              if nudgeBase == nil { nudgeBase = panelOffset }
+                              let o = ConsolePlacement.clampPanelOffset(
+                                  nudgeBase! + translation * 0.001)
+                              panelOffset = o
+                              if done {
+                                  nudgeBase = nil
+                                  ConsolePlacement.savePanelOffset(o)
+                              }
+                          })
+            }
+        }
+        /*
+         * Three separate recognisers, which is the shape Apple's own
+         * samples use for tap plus drag on an entity. The version before
+         * this put a long press in front of the drag and killed both the
+         * move and the turn outright; the version before that ran a zero
+         * distance drag alongside the tap, which competed for the same
+         * pinch and made tapping take several goes. A plain DragGesture
+         * has a 10 point minimum of its own, so a stationary pinch never
+         * starts it and the tap gets it cleanly.
+         */
+        .gesture(
+            SpatialTapGesture()
+                .targetedToAnyEntity()
+                .onEnded { value in
+                    guard Self.console(of: value.entity) != nil else { return }
+                    if let c = claim {
+                        /*
+                         * A drag or turn that was cancelled mid air leaves
+                         * its claim set, and every tap after that died
+                         * here in silence (2026-11-15: the panel could be
+                         * closed and never reopened). A claim nobody has
+                         * touched for a moment is not a live gesture.
+                         */
+                        let idle = Date().timeIntervalSince(claimTouched)
+                        guard idle > Self.claimStale else {
+                            fputs("[host] console tap ignored: \(c) in progress\n",
+                                  stderr)
+                            return
+                        }
+                        fputs("[host] console tap: stale \(c) claim cleared "
+                              + "after \(idle)s\n", stderr)
+                        claim = nil
+                        pressBegan = nil
+                        dragOrigin = nil
+                        spinOrigin = nil
+                    }
+                    discs = DiscLibrary.scan()
+                    if selected >= discs.count {
+                        selected = max(0, discs.count - 1)
+                    }
+                    showPanel.toggle()
+                    fputs("[host] console tapped, deck \(showPanel)\n",
+                          stderr)
+                    fflush(stderr)
+                }
+        )
+        .gesture(
+            DragGesture()
+                .targetedToAnyEntity()
+                .onChanged { value in
+                    guard claim != .turning,
+                          let console = Self.console(of: value.entity)
+                    else { return }
+                    /* A press start left over from a cancelled drag would
+                     * make the next pinch move the console at once. */
+                    if pressBegan == nil
+                        || value.time.timeIntervalSince(pressBegan!) > 2 {
+                        pressBegan = value.time
+                    }
+                    claimTouched = Date()
+                    if claim != .moving {
+                        guard value.time.timeIntervalSince(pressBegan!)
+                                >= Self.holdToAdjust else { return }
+                        claim = .moving
+                        dragOrigin = console.position
+                        Task { await surfaces.startIfNeeded() }
+                    }
+                    var p = dragOrigin! + value.convert(value.translation3D,
+                                                        from: .local,
+                                                        to: .scene)
+                    if let rest = surfaces.restingY(
+                            x: p.x, z: p.z, draggedTo: p.y,
+                            objectHeight: ConsoleMetrics.height) {
+                        p.y = max(p.y, rest)
+                    }
+                    console.position = p
+                }
+                .onEnded { value in
+                    defer { pressBegan = nil; dragOrigin = nil }
+                    guard claim == .moving,
+                          let console = Self.console(of: value.entity)
+                    else { return }
+                    claim = nil
+                    ConsolePlacement.save(position: console.position,
+                                          rotation: console.orientation)
+                    fputs("[host] console placed at \(console.position)\n",
+                          stderr)
+                    fflush(stderr)
+                }
+        )
+        .gesture(
+            /*
+             * Unconstrained, with the yaw taken out afterwards. Pinning
+             * the gesture to the vertical axis made it refuse most real
+             * two handed twists, which never line up exactly with an
+             * axis; it fired twice in a whole session. Accept any
+             * rotation, then use only the part that turns it on the spot.
+             */
+            RotateGesture3D()
+                .targetedToAnyEntity()
+                .onChanged { value in
+                    guard claim != .moving,
+                          let console = Self.console(of: value.entity)
+                    else { return }
+                    claim = .turning
+                    claimTouched = Date()
+                    if spinOrigin == nil { spinOrigin = console.orientation }
+                    /* Vertical only, so it turns on the spot. The axis
+                     * already carries the direction of the twist, so the
+                     * angle must not be negated on top of it. */
+                    /* Project the gesture onto vertical: the component
+                     * of its axis along Y, times its angle. */
+                    let r = value.rotation
+                    let yaw = Float(r.angle.radians) * Float(r.axis.y)
+                    console.orientation =
+                        simd_quatf(angle: yaw, axis: [0, 1, 0]) * spinOrigin!
+                }
+                .onEnded { value in
+                    defer { spinOrigin = nil }
+                    guard claim == .turning,
+                          let console = Self.console(of: value.entity)
+                    else { return }
+                    claim = nil
+                    ConsolePlacement.save(position: console.position,
+                                          rotation: console.orientation)
+                    fputs("[host] console turned\n", stderr); fflush(stderr)
+                }
+        )
+    }
+
+    /// 28 cm up and a little forward, plus whatever the bar was dragged
+    /// to, in the console's own frame so it travels with it.
+    private static func panelPosition(_ o: SIMD2<Float>) -> SIMD3<Float> {
+        [o.x, 0.28 + o.y, 0.04]
+    }
+
+    /// A gesture can land on any descendant, including one fin of the
+    /// model, so walk up to the thing that actually moves.
+    private static func console(of entity: Entity) -> Entity? {
+        var cur: Entity? = entity
+        while let c = cur {
+            if c.name == consoleName { return c }
+            cur = c.parent
+        }
+        return nil
+    }
+}
+
+final class GuestScreen {
+    private var queue: TextureResource.DrawableQueue?
+    private var texture: TextureResource?
+    private var width = 0
+    private var height = 0
+    private var lastSeq: UInt64 = 0
+    private var task: Task<Void, Never>?
+    private var entity: ModelEntity?
+    private var shown: UInt64 = 0
+
+    func makeEntity() -> ModelEntity? {
+        do {
+            try rebuild(width: 640, height: 480)
+        } catch {
+            fputs("[host] screen: texture setup failed: \(error)\n", stderr)
+            return nil
+        }
+        var material = UnlitMaterial()
+        material.color = .init(texture: .init(texture!))
+        /*
+         * 2.8 m wide at 2.6 m away, which is about 56 degrees across, so
+         * a cinema screen rather than a television. 4:3 because that is
+         * what the console outputs.
+         *
+         * This is free. What is not free is the pixels behind it: the
+         * guest renders 640x480 and that is what gets stretched here, so
+         * a larger plane is a larger soft image, not a sharper one. The
+         * lever for sharpness is the surface scale factor, which is 1 on
+         * this build and multiplies pixel work by its square.
+         */
+        let mesh = MeshResource.generatePlane(width: 2.8, height: 2.1)
+        let e = ModelEntity(mesh: mesh, materials: [material])
+        e.position = [0, 1.5, -2.6]
+        /*
+         * Hidden until the first frame. The space now opens before a game
+         * is chosen, and a 2.8 m black slab hanging in the room next to a
+         * console that has not booted looks like a fault rather than a
+         * screen that is off.
+         */
+        e.isEnabled = false
+        entity = e
+        return e
+    }
+
+    /// A texture of the given size, backed by a drawable queue so each
+    /// frame is a copy into the next drawable rather than a new resource.
+    private func rebuild(width w: Int, height h: Int) throws {
+        /* The guest's pixels are sRGB; declared linear they come out with
+         * crushed gradients and lifted blacks. */
+        let desc = TextureResource.DrawableQueue.Descriptor(
+            pixelFormat: .bgra8Unorm_srgb, width: w, height: h,
+            usage: [.shaderRead, .shaderWrite], mipmapsMode: .none)
+        let q = try TextureResource.DrawableQueue(desc)
+        let black = UIImage(color: .black, size: CGSize(width: w, height: h)).cgImage!
+        let t = try TextureResource(image: black, options: .init(semantic: .color))
+        t.replace(withDrawables: q)
+        queue = q
+        texture = t
+        width = w
+        height = h
+        if let e = entity {
+            var material = UnlitMaterial()
+            material.color = .init(texture: .init(t))
+            e.model?.materials = [material]
+        }
+        fputs("[host] screen: \(w)x\(h) texture ready\n", stderr); fflush(stderr)
+    }
+
+    func start() {
+        task?.cancel()
+        task = Task.detached(priority: .userInitiated) { [weak self] in
+            xemu_host_set_metal_present(true)
+            var flips: Int32 = -1
+            var zeroCopy = true
+            while !Task.isCancelled {
+                guard let self else { return }
+                if zeroCopy {
+                    let now = xemu_host_guest_flips()
+                    if now != flips {
+                        flips = now
+                        let r = await self.presentFromGPU()
+                        if r < 0 {
+                            zeroCopy = false
+                            xemu_host_set_metal_present(false)
+                        }
+                    }
+                    try? await Task.sleep(nanoseconds: 2_000_000)
+                } else {
+                    await self.pump()
+                    try? await Task.sleep(nanoseconds: 33_000_000)
+                }
+            }
+        }
+    }
+
+    /// One frame from the renderer into the next drawable, no CPU in the
+    /// way. Rebuilds the queue when the guest changes its scan-out size.
+    @MainActor private func presentFromGPU() async -> Int32 {
+        var w: Int32 = 0, h: Int32 = 0
+        guard xemu_host_present_size(&w, &h), w > 0, h > 0 else { return 0 }
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return 0 }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return 0 }
+        let tex = Unmanaged.passUnretained(drawable.texture).toOpaque()
+        let r = xemu_host_present_frame(tex, w, h)
+        if r == 1 {
+            drawable.present()
+            shown += 1
+            if shown == 1 {
+                entity?.isEnabled = true
+                fputs("[host] boot \(XbawksApp.sinceLaunch()): "
+                      + "first GPU frame\n", stderr)
+            }
+            if shown <= 3 || shown % 600 == 0 {
+                fputs("[host] screen: GPU frame \(shown) (\(w)x\(h))\n", stderr)
+                fflush(stderr)
+            }
+        }
+        return r
+    }
+
+    private func pump() {
+        var bgra: UnsafeMutableRawPointer?
+        var w: Int32 = 0, h: Int32 = 0
+        let seq = xemu_host_frame_take(lastSeq, &bgra, &w, &h)
+        guard seq != 0, let pixels = bgra else { return }
+        defer { free(pixels) }
+        lastSeq = seq
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return }
+        let region = MTLRegionMake2D(0, 0, Int(w), Int(h))
+        drawable.texture.replace(region: region, mipmapLevel: 0,
+                                 withBytes: pixels, bytesPerRow: Int(w) * 4)
+        drawable.present()
+        shown += 1
+        if shown == 1 { entity?.isEnabled = true }
+        if shown <= 3 || shown % 300 == 0 {
+            fputs("[host] screen: frame \(shown) (seq \(seq), \(w)x\(h))\n", stderr)
+            fflush(stderr)
+        }
+    }
+}
+
+private extension UIImage {
+    convenience init(color: UIColor, size: CGSize) {
+        let r = UIGraphicsImageRenderer(size: size)
+        let img = r.image { ctx in
+            color.setFill()
+            ctx.fill(CGRect(origin: .zero, size: size))
+        }
+        self.init(cgImage: img.cgImage!)
+    }
+}
+
+extension Notification.Name {
+    /// A newer launcher scene appeared; older ones close themselves.
+    static let xbawksLauncherSuperseded = Notification.Name("xbawksLauncherSuperseded")
+}
