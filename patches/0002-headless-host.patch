+/* ------------------------------------------------------------------ */
+/* Entry                                                                */
+/* ------------------------------------------------------------------ */
+
+static void *qemu_main_thread(void *opaque)
+{
+    footprint("before qemu_init");
+    qemu_init(g_argc, g_argv);
+    footprint("after qemu_init");
+    qatomic_set(&g_qemu_ready, true);
+
+    /*
+     * One controller on port 1, filled by the shell. qemu_init returns
+     * with the BQL held on this thread, which is what plugging the USB
+     * devices needs.
+     */
+    g_host_pad = xemu_input_bind_host_pad(0, "Headset Gamepad");
+    fprintf(stderr, "[host] gamepad bound to port 1: %s\n",
+            g_host_pad && g_host_pad->device ? "ok" : "NO DEVICE");
+    fflush(stderr);
+    fprintf(stderr, "[host] ramblocks:\n");
+    qemu_ram_foreach_block(dump_ramblock, NULL);
+    fflush(stderr);
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    {
+        extern void xemu_host_dump_vm_regions(void);
+        xemu_host_dump_vm_regions();
+    }
+#endif
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    fprintf(stderr, "[host] qemu_init returned, stage %d\n", xemu_host_stage);
+    if (xemu_host_stage < 3) {
+        fprintf(stderr, "[host] stopping before qemu_main_loop\n");
+        return NULL;
+    }
+#endif
+
+    exit_status = qemu_main_loop();
+    qatomic_set(&qemu_exiting, true);
+    bql_unlock();
+    return NULL;
+}
+
+/*
+ * On macOS this is the entry point. On the iOS family main() belongs to
+ * UIKit, in xemu-host-ios.m, and it calls this from a worker thread once
+ * the app has checked in. A visionOS process that never reaches
+ * UIApplicationMain is killed before any of this runs, with no crash report
+ * and no output, which is worth stating because it looks exactly like a
+ * dyld failure from the outside.
+ */
+#if TARGET_OS_VISION || TARGET_OS_IOS
+int xemu_host_run(int argc, char **argv)
+#else
+int main(int argc, char **argv)
+#endif
+{
+    QemuThread thread;
+
+    setlocale(LC_NUMERIC, "C");
+    g_argc = argc;
+    g_argv = argv;
+
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "-config_path") && i + 1 < argc) {
+            xemu_settings_set_path(argv[i + 1]);
+            break;
+        }
+    }
+
+    footprint("at entry");
+    {
+        QemuThread ticker;
+        qemu_thread_create(&ticker, "footprint", footprint_ticker, NULL,
+                           QEMU_THREAD_DETACHED);
+    }
+    if (!xemu_settings_load()) {
+        fprintf(stderr, "%s", xemu_settings_get_error_message());
+        return 1;
+    }
+    atexit(xemu_settings_save);
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    /*
+     * There is no config file on a fresh install and nowhere obvious to put
+     * one, so point the machine at the media copied into the bundle. Only
+     * fills in what is empty, so a config written later still wins.
+     *
+     * The EEPROM goes in Documents rather than the bundle, because the
+     * bundle is read-only and xemu generates one if it is missing.
+     */
+    {
+        const char *bundle = xemu_host_bundle_path();
+        const char *home = getenv("HOME");
+
+        /*
+         * Set unconditionally, not just when empty. A saved config carries
+         * absolute paths with the container's UUID in them, and the
+         * container gets a NEW UUID on every reinstall, so yesterday's
+         * config points at a directory that no longer exists. The symptom
+         * is "Failed to generate EEPROM file" naming a path you have never
+         * seen.
+         */
+        /*
+         * Every piece of media prefers a copy in Documents, so the bundle
+         * can ship without any of it and installs stop costing minutes.
+         */
+        xemu_settings_set_string(&g_config.sys.files.bootrom_path,
+            media_path(home, bundle, "mcpx-1.0.bin"));
+        xemu_settings_set_string(&g_config.sys.files.flashrom_path,
+            media_path(home, bundle, "bios.bin"));
+
+        /*
+         * The disc is chosen in the launcher window, from Documents. Wait
+         * for it. A disc baked into the bundle (a development build made
+         * with XEMU_GAME) skips the wait and keeps the old behaviour.
+         */
+        {
+            g_autofree char *baked =
+                g_strdup_printf("%s/media/game.iso", bundle);
+            if (g_file_test(baked, G_FILE_TEST_EXISTS)) {
+                xemu_settings_set_string(&g_config.sys.files.dvd_path,
+                                         g_strdup(baked));
+                fprintf(stderr, "[host] dvd      %s (baked in)\n", baked);
+            } else {
+                fprintf(stderr, "[host] waiting for a disc choice\n");
+                fflush(stderr);
+                pthread_mutex_lock(&g_disc_mu);
+                while (!g_disc_chosen) {
+                    pthread_cond_wait(&g_disc_cv, &g_disc_mu);
+                }
+                pthread_mutex_unlock(&g_disc_mu);
+                if (g_selected_disc && g_selected_disc[0] && home) {
+                    g_autofree char *iso = g_strdup_printf(
+                        "%s/Documents/GAMES/%s", home, g_selected_disc);
+                    xemu_settings_set_string(&g_config.sys.files.dvd_path,
+                                             g_strdup(iso));
+                    fprintf(stderr, "[host] dvd      %s\n", iso);
+                } else {
+                    fprintf(stderr, "[host] no disc, booting the dashboard\n");
+                }
+            }
+            qatomic_set(&g_emulator_started, true);
+        }
+        /*
+         * The hard disk has to live somewhere writable. An app bundle is
+         * read-only on this platform and QEMU opens a disk read-write, so
+         * pointing at the bundled copy fails with "Operation not
+         * permitted" before the machine ever starts.
+         *
+         * Copy it into the container once. It is 2 GB, so only if it is
+         * not already there. This is also the shape the real thing takes,
+         * where the user supplies media into the container rather than it
+         * riding along in the bundle.
+         */
+        if (home) {
+            g_autofree char *hdd_dst =
+                g_strdup_printf("%s/Documents/xbox_hdd.qcow2", home);
+            g_autofree char *hdd_src =
+                g_strdup_printf("%s/media/xbox_hdd.qcow2", bundle);
+
+            if (!g_file_test(hdd_dst, G_FILE_TEST_EXISTS) &&
+                g_file_test(hdd_src, G_FILE_TEST_EXISTS)) {
+                fprintf(stderr, "[host] copying hdd into the container, "
+                                "this takes a moment\n");
+                /*
+                 * Streamed in chunks, deliberately. g_file_get_contents()
+                 * reads the whole file into memory first, which for a
+                 * 1.9 GB disk image means a 1.9 GB peak on a device with a
+                 * jetsam limit. It completed and then the process died a
+                 * few hundred milliseconds later inside Vulkan init.
+                 */
+                FILE *in = fopen(hdd_src, "rb");
+                FILE *out = in ? fopen(hdd_dst, "wb") : NULL;
+                if (in && out) {
+                    enum { CHUNK = 4 * 1024 * 1024 };
+                    g_autofree char *buf = g_malloc(CHUNK);
+                    size_t n, total = 0;
+                    bool ok = true;
+                    while ((n = fread(buf, 1, CHUNK, in)) > 0) {
+                        if (fwrite(buf, 1, n, out) != n) { ok = false; break; }
+                        total += n;
+                    }
+                    ok = ok && (fflush(out) == 0);
+                    fprintf(stderr, "[host] hdd %s, %.1f MB\n",
+                            ok ? "copied" : "COPY FAILED", total / 1048576.0);
+                } else {
+                    fprintf(stderr, "[host] hdd copy could not open files\n");
+                }
+                if (out) fclose(out);
+                if (in) fclose(in);
+            }
+            if (g_file_test(hdd_dst, G_FILE_TEST_EXISTS)) {
+                footprint("after hdd copy");
+                xemu_settings_set_string(&g_config.sys.files.hdd_path,
+                                         g_strdup(hdd_dst));
+                fprintf(stderr, "[host] hdd      %s\n", hdd_dst);
+            }
+        }
+        if (home) {
+            xemu_settings_set_string(&g_config.sys.files.eeprom_path,
+                g_strdup_printf("%s/Documents/eeprom.bin", home));
+        }
+
+        /*
+         * The same trap that cost a boot on macOS: while show_welcome is
+         * true, system/vl.c skips adding -bios entirely and the machine
+         * starts with no BIOS, reporting a null filename while the path sits
+         * correctly in the config. There is no welcome screen here to dismiss.
+         */
+        g_config.general.show_welcome = false;
+
+        /*
+         * The config default is OPENGL, and there is no GL backend in this
+         * build, so a fresh install configures a renderer that does not
+         * exist. xemu logs "Configured renderer not available" and carries
+         * on with none, and the first thing NV2A asks of it ends the
+         * process with no message at all.
+         */
+        g_config.display.renderer = CONFIG_DISPLAY_RENDERER_VULKAN;
+        fprintf(stderr, "[host] renderer forced to Vulkan\n");
+        fprintf(stderr, "[host] bootrom  %s\n", g_config.sys.files.bootrom_path);
+        fprintf(stderr, "[host] flashrom %s\n", g_config.sys.files.flashrom_path);
+    }
+#endif
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    if (xemu_host_stage < 1) {
+        fprintf(stderr, "[host] stopping before qemu_init (stage %d)\n",
+                xemu_host_stage);
+        return 0;
+    }
+#endif
+
+    qemu_sem_init(&display_init_sem, 0);
+    qemu_thread_create(&thread, "qemu_main", qemu_main_thread, NULL,
+                       QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&display_init_sem);
+
+    /* Inherited from ui/xemu.c: this thread touches TCG and AIO state. */
+    tcg_register_init_ctx();
+    qemu_set_current_aio_context(qemu_get_aio_context());
+    /* On the headset this is a raw pthread, so nothing did this for us. */
+    rcu_register_thread();
+
+    /*
+     * Headless run: let the guest get somewhere, then write one frame out.
+     * XEMU_HOST_SHOT names the file and XEMU_HOST_SHOT_AFTER is how many
+     * seconds to wait first. Without the former this just runs.
+     */
+    const char *shot = getenv("XEMU_HOST_SHOT");
+
+    int after = getenv("XEMU_HOST_SHOT_AFTER")
+                    ? atoi(getenv("XEMU_HOST_SHOT_AFTER")) : 10;
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+    /*
+     * Environment variables do not reach an app launched the ordinary way,
+     * so on the headset default to writing into the app's own Documents,
+     * which is where a Files-visible container puts things and where
+     * `devicectl device copy from` can fetch them.
+     */
+    g_autofree char *doc_shot = NULL;
+    if (!shot) {
+        const char *home = getenv("HOME");
+        doc_shot = g_strdup_printf("%s/Documents/frame.png", home ? home : ".");
+        shot = doc_shot;
+    }
+#endif
+
+    for (int elapsed = 0; !qatomic_read(&qemu_exiting); elapsed++) {
+        /* Thirty grabs a second; the bookkeeping below runs once a second. */
+        for (int i = 0; i < 30 && !qatomic_read(&qemu_exiting); i++) {
+            g_usleep(33 * 1000);
+            if (elapsed >= 2 && frame_count > 0) {
+                grab_frame();
+            }
+        }
+
+        /*
+         * Poll rather than ask once. Ten seconds was a guess, and a guess
+         * that fails tells you nothing about whether the machine is slow,
+         * stuck, or never going to scan out at all.
+         */
+        if (elapsed % 5 == 0) {
+            /*
+             * runstate is the cheapest honest signal about whether the
+             * machine is actually executing. "running" with no frames
+             * means a CPU that is advancing and not drawing; anything else
+             * means it never started or stopped itself.
+             */
+            /*
+             * runstate only says "not paused". A CPU spinning in a loop
+             * and a CPU halted waiting for an interrupt that never comes
+             * both report running, and they are different problems.
+             * halted distinguishes them, and it is a plain field read.
+             */
+            CPUState *cpu = first_cpu;
+            /*
+             * The PC is the one number that separates every remaining
+             * hypothesis. Changing: the guest advances and the problem is
+             * downstream. Constant: a tight poll, and the address says on
+             * what. Read racily from another thread, which is fine for a
+             * number printed every ten seconds.
+             */
+            vaddr pc = 0;
+            if (cpu && CPU_GET_CLASS(cpu)->get_pc) {
+                pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+            }
+            fprintf(stderr, "[host] t=%3ds, %" PRIu64 " guest frames "
+                            "(published nv2a %" PRIu64 " vga %" PRIu64 "), "
+                            "runstate %s, cpu %s%s, pc 0x%08" PRIx64
+                            ", exiting %d\n",
+                    elapsed, frame_count, g_frames_nv2a, g_frames_vga,
+                    RunState_str(runstate_get()),
+                    cpu ? (cpu->halted ? "HALTED" : "executing") : "none",
+                    cpu && cpu->stopped ? " stopped" : "",
+                    (uint64_t)pc, (int)qatomic_read(&qemu_exiting));
+            if (cpu) {
+                /*
+                 * running is true only while the vCPU is inside cpu_exec.
+                 * Not halted plus never running means the thread exists
+                 * and is not executing guest code, which is a lock or a
+                 * missing kick, not a guest problem.
+                 */
+                fprintf(stderr, "[host]   vcpu: created=%d running=%d "
+                                "thread=%d stop=%d exit_req=%d irq_req=0x%x, "
+                                "host holds bql=%d\n",
+                        (int)cpu->created, (int)cpu->running,
+                        cpu->thread_id, (int)cpu->stop,
+                        (int)qatomic_read(&cpu->exit_request),
+                        (unsigned)qatomic_read(&cpu->interrupt_request),
+                        (int)bql_locked());
+            }
+            {
+                /*
+                 * Why the renderer stopped, and how often. A full GPU
+                 * drain per reason, as a delta over the last five
+                 * seconds, so walking from one level to another says in
+                 * numbers which reason is responsible.
+                 */
+                extern unsigned long xemu_vk_finish_counts[9];
+                static const char *names[9] = {
+                    "vtxbuf", "surf_create", "surf_down", "buf_space",
+                    "fb_dirty", "present", "flip_stall", "flush", "stalled"
+                };
+                static unsigned long last[9];
+                char line[320];
+                int n = 0;
+                unsigned long total = 0;
+                for (int i = 0; i < 9; i++) {
+                    unsigned long d = xemu_vk_finish_counts[i] - last[i];
+                    last[i] = xemu_vk_finish_counts[i];
+                    total += d;
+                    if (d) {
+                        n += snprintf(line + n, sizeof(line) - n, " %s=%lu",
+                                      names[i], d);
+                    }
+                }
+                fprintf(stderr, "[host]   gpu drains in 5 s: %lu%s\n",
+                        total, n ? line : " none");
+
+                /*
+                 * The same breakdown in milliseconds. This is the number
+                 * that decides anything: a reason can be the most frequent
+                 * and still cost nothing, if by the time it drains the GPU
+                 * has already gone idle.
+                 */
+                extern unsigned long long xemu_vk_finish_ns[9];
+                static unsigned long long last_ns[9];
+                char tline[320];
+                int tn = 0;
+                unsigned long long total_ns = 0;
+                for (int i = 0; i < 9; i++) {
+                    unsigned long long dn = xemu_vk_finish_ns[i] - last_ns[i];
+                    last_ns[i] = xemu_vk_finish_ns[i];
+                    total_ns += dn;
+                    if (dn >= 1000000) {
+                        tn += snprintf(tline + tn, sizeof(tline) - tn,
+                                       " %s=%llums", names[i], dn / 1000000);
+                    }
+                }
+                fprintf(stderr, "[host]   gpu stalled in 5 s: %llums of 5000"
+                                " (%.0f%%)%s\n",
+                        total_ns / 1000000,
+                        (double)total_ns / 5e9 * 100.0,
+                        tn ? tline : "");
+
+                /*
+                 * And specifically the occlusion drains: how many were
+                 * taken, how many the rate limit skipped, the average
+                 * report queue depth when draining, and how close the
+                 * fixed 1024 query pool came to overflowing.
+                 */
+                {
+                    extern void pgraph_vk_report_stats(NV2AState *d,
+                        unsigned long *, unsigned long *, unsigned long *,
+                        unsigned *);
+                    static unsigned long ld, ls, ldep;
+                    unsigned long dr = 0, sk = 0, dep = 0;
+                    unsigned qif = 0;
+                    pgraph_vk_report_stats(g_nv2a_for_stats(), &dr, &sk, &dep,
+                                           &qif);
+                    unsigned long d_dr = dr - ld, d_sk = sk - ls,
+                                  d_dep = dep - ldep;
+                    ld = dr; ls = sk; ldep = dep;
+                    fprintf(stderr, "[host]   reports: %lu drains, %lu "
+                                    "skipped, avg queue %.1f, %u queries in "
+                                    "flight of 1024\n",
+                            d_dr, d_sk, d_dr ? (double)d_dep / d_dr : 0.0,
+                            qif);
+                    extern void pgraph_vk_report_triggers(NV2AState *d,
+                        unsigned long *, unsigned long *, unsigned long *);
+                    static unsigned long lc, lq, lp;
+                    unsigned long c = 0, q = 0, po = 0;
+                    pgraph_vk_report_triggers(g_nv2a_for_stats(), &c, &q, &po);
+                    fprintf(stderr, "[host]   drain trigger: clock %lu, "
+                                    "queue %lu, pool %lu\n",
+                            c - lc, q - lq, po - lp);
+                    lc = c; lq = q; lp = po;
+
+                    extern void pgraph_vk_vertex_stats(NV2AState *d,
+                        unsigned long *, unsigned long *);
+                    static unsigned long lvr, lva;
+                    unsigned long vr = 0, va = 0;
+                    pgraph_vk_vertex_stats(g_nv2a_for_stats(), &vr, &va);
+                    fprintf(stderr, "[host]   vertex: %lu real flushes, %lu "
+                                    "avoided by byte range\n",
+                            vr - lvr, va - lva);
+                    lvr = vr; lva = va;
+
+                    extern void pgraph_vk_vertex_volume(NV2AState *d,
+                        unsigned long long *, unsigned long long *,
+                        unsigned long *, unsigned long *);
+                    static unsigned long long lbd, lbr;
+                    static unsigned long lvdraws, lvremap;
+                    unsigned long long bd = 0, br = 0;
+                    unsigned long vdraws = 0, vremap = 0;
+                    pgraph_vk_vertex_volume(g_nv2a_for_stats(), &bd, &br,
+                                            &vdraws, &vremap);
+                    unsigned long long d_dirty = bd - lbd;
+                    unsigned long long d_remap = br - lbr;
+                    fprintf(stderr, "[host]   vertex bytes in 5 s: dirty "
+                                    "%llu KiB, if remapped %llu KiB (%.1fx), "
+                                    "%lu draws of which %lu already remap\n",
+                            d_dirty >> 10, d_remap >> 10,
+                            d_dirty ? (double)d_remap / (double)d_dirty : 0.0,
+                            vdraws - lvdraws, vremap - lvremap);
+                    lbd = bd; lbr = br; lvdraws = vdraws; lvremap = vremap;
+
+                    extern void pgraph_vk_hazard_shape(NV2AState *d,
+                        unsigned long *, unsigned long *);
+                    static unsigned long lhy, lhn;
+                    unsigned long hy = 0, hn = 0;
+                    pgraph_vk_hazard_shape(g_nv2a_for_stats(), &hy, &hn);
+                    fprintf(stderr, "[host]   vertex hazards in 5 s: %lu "
+                                    "could use the ring, %lu could not\n",
+                            hy - lhy, hn - lhn);
+                    lhy = hy; lhn = hn;
+                }
+            }
+            {
+                /*
+                 * The guest's own speed. Presses reach its report and it
+                 * misses them unless they are held, which is what a guest
+                 * sampling input at a few frames a second would do.
+                 */
+                static int last_flips;
+                static unsigned long last_blocks;
+                int flips = nv2a_get_frame_count();
+                unsigned long blocks = xemu_host_blocks_executed;
+                fprintf(stderr, "[host]   guest: %d flips in 5 s, %lu blocks/s, "
+                                "%zu TBs, %u flushes\n",
+                        flips - last_flips, (blocks - last_blocks) / 5,
+                        tcg_nb_tbs(), xemu_host_tb_flush_count());
+                last_flips = flips;
+                last_blocks = blocks;
+            }
+            {
+                size_t where = 0;
+                int same = tcg_splitwx_views_match(64 * 1024, &where);
+                fprintf(stderr, "[host]   splitwx views: %s%s\n",
+                        same == 1 ? "MATCH" : same == 0 ? "DIVERGED" : "n/a",
+                        same == 0 ? "" : "");
+                if (same == 0) {
+                    fprintf(stderr, "[host]   first difference at byte %zu\n",
+                            where);
+                }
+            }
+        }
+
+        /*
+         * Take a frame from here, with no BQL, the way the desktop shell's
+         * window thread does. Get, copy the pixels out, release, and only
+         * then encode: the pointer is valid until the guest draws again,
+         * and a second get without a release trips an assert in pgraph
+         * (that was the signal 6 of 2026-10-26).
+         */
+        /*
+         * The thread dump and the execute probe that lived here at 20 to
+         * 23 seconds found the JIT answer and are retired: suspending
+         * every thread, the main one included, is also exactly when the
+         * immersive space was lost in two runs (2026-10-29).
+         */
+
+        if (shot && elapsed == after) {
+            nv2a_get_framebuffer_surface();
+            NV2ACpuFramebuffer fb;
+            bool have = nv2a_get_cpu_framebuffer(&fb);
+            uint8_t *copy = NULL;
+            if (have && fb.width > 0 && fb.height > 0 && fb.data) {
+                size_t row = (size_t)fb.width * 4;
+                copy = g_malloc(row * fb.height);
+                for (int y = 0; y < fb.height; y++) {
+                    memcpy(copy + y * row,
+                           (const uint8_t *)fb.data + (size_t)y * fb.stride,
+                           row);
+                }
+                fb.data = copy;
+                fb.stride = (int)row;
+            }
+            nv2a_release_framebuffer_surface();
+
+            if (!copy) {
+                fprintf(stderr, "[host] t=%3ds frame: nothing published\n",
+                        elapsed);
+            } else if (write_framebuffer_png(&fb, shot)) {
+                fprintf(stderr, "[host] t=%3ds frame: wrote %dx%d\n",
+                        elapsed, fb.width, fb.height);
+            } else {
+                fprintf(stderr, "[host] t=%3ds frame: %dx%d, PNG write "
+                                "FAILED\n", elapsed, fb.width, fb.height);
+            }
+            g_free(copy);
+        }
+    }
+
+    fprintf(stderr, "[host] xemu_host_run: loop ended, exiting=%d, "
+                    "joining qemu thread\n",
+            (int)qatomic_read(&qemu_exiting));
+    qemu_thread_join(&thread);
+    fprintf(stderr, "[host] xemu_host_run: qemu thread joined, status %d\n",
+            exit_status);
+    return exit_status;
+}
