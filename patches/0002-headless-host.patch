+/*
+ * Disc selection. The launcher window lists what is in Documents and the
+ * emulator thread waits here until something is chosen, so changing games
+ * is a tap rather than a 5 GB reinstall. Static initialisers, because the
+ * window can answer before the emulator thread reaches the wait.
+ */
+static pthread_mutex_t g_disc_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  g_disc_cv = PTHREAD_COND_INITIALIZER;
+static char *g_selected_disc;      /* filename in Documents, or "" for none */
+static bool  g_disc_chosen;
+static bool  g_emulator_started;
+
+char *xemu_host_list_discs(void)
+{
+    const char *home = getenv("HOME");
+    if (!home) {
+        return g_strdup("");
+    }
+    /*
+     * Games live in Documents/GAMES, created on first run so the folder is
+     * already there to drop discs into. In Files this reads as
+     * XBAWKS > GAMES, because the app's own container is already named
+     * after the app; an inner folder called XBAWKS gave XBAWKS > XBAWKS.
+     *
+     * Rename the old one in place if it is still there. A rename is
+     * instant whatever the folder holds, which matters when it holds five
+     * gigabytes of discs that took ten minutes to copy over.
+     */
+    g_autofree char *docs = g_strdup_printf("%s/Documents/GAMES", home);
+    g_autofree char *legacy = g_strdup_printf("%s/Documents/XBAWKS", home);
+    if (g_file_test(legacy, G_FILE_TEST_IS_DIR) &&
+        !g_file_test(docs, G_FILE_TEST_IS_DIR)) {
+        if (g_rename(legacy, docs) == 0) {
+            fprintf(stderr, "[host] moved Documents/XBAWKS to Documents/GAMES\n");
+        }
+    }
+    g_mkdir_with_parents(docs, 0755);
+    GDir *dir = g_dir_open(docs, 0, NULL);
+    if (!dir) {
+        return g_strdup("");
+    }
+    GString *out = g_string_new(NULL);
+    const char *name;
+    while ((name = g_dir_read_name(dir))) {
+        if (g_str_has_suffix(name, ".iso") || g_str_has_suffix(name, ".xiso")) {
+            g_string_append(out, name);
+            g_string_append_c(out, '\n');
+        }
+    }
+    g_dir_close(dir);
+    return g_string_free(out, FALSE);
+}
