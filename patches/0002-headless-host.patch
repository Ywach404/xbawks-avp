+     * widens its range; one that is not starts fresh. pgraph_vk_finish
+     * clears the bitmap, which is what invalidates these.
+     */
+    for (size_t p = start_bit; p < end_bit; p++) {
+        hwaddr page_start = (hwaddr)p * TARGET_PAGE_SIZE;
+        hwaddr w_lo = offset > page_start ? offset - page_start : 0;
+        hwaddr w_end = offset + size;
+        hwaddr w_hi = w_end < page_start + TARGET_PAGE_SIZE
+                          ? w_end - page_start : TARGET_PAGE_SIZE;
+        if (test_bit(p, r->uploaded_bitmap)) {
