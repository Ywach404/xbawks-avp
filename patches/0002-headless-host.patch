+/// A 4:3 screen two and a half metres ahead at eye height, two metres
+/// wide, fed thirty times a second from the published frame.
+struct ScreenSpace: View {
+    /*
+     * @State and not a let. A plain property is reinitialised on every
+     * re-evaluation of the view, and this view has state in it now, so it
+     * will be re-evaluated. That would build a second GuestScreen that
+     * nothing ever starts, while the frame pump kept feeding the first.
+     */
+    @State private var screen = GuestScreen()
+    @Environment(\.openWindow) private var openWindow
+
+    /*
+     * Placement is a held gesture, not a travelled one.
+     *
+     * It was decided by distance at first: move more than 20 mm and it is
+     * a move, less and it is a press. That reads badly in the hand,
+     * because poking a thing with a fingertip always travels, so every
+     * poke became a move. Time is the honest signal here. Nothing moves
+     * until the press has been held, so a poke and a quick pinch both
+     * mean "open", and only a deliberate hold picks the console up.
+     */
+    private static let holdToAdjust = 0.35   /* seconds */
+
+    @State private var pressBegan: Date?
+    @State private var adjusting = false
+    @State private var dragOrigin: SIMD3<Float>?
+    @State private var spinOrigin: simd_quatf?
+    @State private var surfaces = SurfaceFinder()
+
+    private static let consoleName = "xbawks-console"
+
+    var body: some View {
+        RealityView { content in
+            if let entity = screen.makeEntity() {
+                content.add(entity)
+            }
+            let console = await XbawksConsole.make()
+            console.position = ConsolePlacement.loadPosition()
+            console.orientation = ConsolePlacement.loadRotation()
+            content.add(console)
+            screen.start()
+            Task { await surfaces.start() }
+        }
+        /*
+         * Press or hold, one recogniser. Two of them cannot work: a drag
+         * that ends still looks like a tap to a tap recogniser, so the
+         * menu opened every time the console was repositioned.
+         */
+        .gesture(
+            DragGesture(minimumDistance: 0)
+                .targetedToAnyEntity()
+                .onChanged { value in
+                    guard let console = Self.console(of: value.entity) else {
+                        return
+                    }
+                    if pressBegan == nil { pressBegan = value.time }
+                    let held = value.time.timeIntervalSince(pressBegan!)
+                    if !adjusting {
+                        guard held >= Self.holdToAdjust else { return }
+                        /* Pick it up from where it is now, so it does not
+                         * jump by however far the hand drifted while the
+                         * hold was being counted. */
+                        adjusting = true
+                        dragOrigin = console.position
+                    }
+                    let move = value.convert(value.translation3D,
+                                             from: .local, to: .scene)
+                    var p = dragOrigin! + move
+                    /*
+                     * Put it down on whatever is really there. A console
+                     * sunk halfway into a table is the single thing that
+                     * most gives away that it is not an object, and it is
+                     * also just annoying to position.
+                     */
+                    if let rest = surfaces.restingY(
+                            x: p.x, z: p.z, draggedTo: p.y,
+                            objectHeight: ConsoleMetrics.height) {
+                        p.y = max(p.y, rest)
+                    }
+                    console.position = p
+                }
+                .onEnded { value in
+                    guard let console = Self.console(of: value.entity) else {
+                        return
+                    }
+                    let wasAdjusting = adjusting
+                    pressBegan = nil
+                    adjusting = false
+                    dragOrigin = nil
+
+                    if wasAdjusting {
+                        ConsolePlacement.save(position: console.position,
+                                              rotation: console.orientation)
+                        fputs("[host] console placed at \(console.position)\n",
+                              stderr)
+                    } else {
+                        /*
+                         * The window, not an in space panel. A window can
+                         * be grabbed and put where you want it, which is
+                         * the thing worth keeping; an attachment can only
+                         * sit where it is told. So the console summons the
+                         * window and the system places it, after which it
+                         * is yours to move.
+                         */
+                        openWindow(id: "launcher")
+                        fputs("[host] console pressed, deck requested\n",
+                              stderr)
+                    }
+                    fflush(stderr)
+                }
+        )
+        /* Turn it to face you. Persisted with the position, because a
+         * console pointing at the wall is no more use than one behind
+         * your knees. */
+        .simultaneousGesture(
+            RotateGesture3D(constrainedToAxis: .y)
+                .targetedToAnyEntity()
+                .onChanged { value in
+                    guard let console = Self.console(of: value.entity) else {
+                        return
+                    }
+                    if spinOrigin == nil { spinOrigin = console.orientation }
+                    /*
+                     * Turned on the spot, never tipped. An unconstrained
+                     * RotateGesture3D hands back a rotation about any
+                     * axis, so the console could end up on its side or
+                     * nose down, which a console on a shelf cannot do.
+                     * Constraining the gesture to vertical is half of
+                     * it. The sign is the other half and it took two
+                     * goes: the axis the gesture reports already carries
+                     * the direction of the twist, so negating the angle
+                     * on top of that turned it the wrong way.
+                     */
+                    let r = value.rotation
+                    let sign: Float = r.axis.y < 0 ? -1 : 1
+                    let yaw = simd_quatf(angle: Float(r.angle.radians) * sign,
+                                         axis: [0, 1, 0])
+                    console.orientation = yaw * spinOrigin!
+                }
+                .onEnded { value in
+                    guard let console = Self.console(of: value.entity) else {
+                        return
+                    }
+                    spinOrigin = nil
+                    ConsolePlacement.save(position: console.position,
+                                          rotation: console.orientation)
+                    fputs("[host] console turned\n", stderr); fflush(stderr)
+                }
+        )
+    }
+
+    /// The gesture can land on any descendant, including a single fin of
+    /// the model, so walk up to the thing that actually moves.
+    private static func console(of entity: Entity) -> Entity? {
+        var cur: Entity? = entity
+        while let c = cur {
+            if c.name == consoleName { return c }
+            cur = c.parent
+        }
+        return nil
+    }
+}
+
+final class GuestScreen {
+    private var queue: TextureResource.DrawableQueue?
+    private var texture: TextureResource?
+    private var width = 0
+    private var height = 0
+    private var lastSeq: UInt64 = 0
+    private var task: Task<Void, Never>?
+    private var entity: ModelEntity?
+    private var shown: UInt64 = 0
+
+    func makeEntity() -> ModelEntity? {
+        do {
+            try rebuild(width: 640, height: 480)
+        } catch {
+            fputs("[host] screen: texture setup failed: \(error)\n", stderr)
+            return nil
+        }
+        var material = UnlitMaterial()
+        material.color = .init(texture: .init(texture!))
+        /*
+         * 2.8 m wide at 2.6 m away, which is about 56 degrees across, so
+         * a cinema screen rather than a television. 4:3 because that is
+         * what the console outputs.
+         *
+         * This is free. What is not free is the pixels behind it: the
+         * guest renders 640x480 and that is what gets stretched here, so
+         * a larger plane is a larger soft image, not a sharper one. The
+         * lever for sharpness is the surface scale factor, which is 1 on
+         * this build and multiplies pixel work by its square.
+         */
+        let mesh = MeshResource.generatePlane(width: 2.8, height: 2.1)
+        let e = ModelEntity(mesh: mesh, materials: [material])
+        e.position = [0, 1.5, -2.6]
+        /*
+         * Hidden until the first frame. The space now opens before a game
+         * is chosen, and a 2.8 m black slab hanging in the room next to a
+         * console that has not booted looks like a fault rather than a
+         * screen that is off.
+         */
+        e.isEnabled = false
+        entity = e
+        return e
+    }
+
+    /// A texture of the given size, backed by a drawable queue so each
+    /// frame is a copy into the next drawable rather than a new resource.
+    private func rebuild(width w: Int, height h: Int) throws {
+        /* The guest's pixels are sRGB; declared linear they come out with
+         * crushed gradients and lifted blacks. */
+        let desc = TextureResource.DrawableQueue.Descriptor(
+            pixelFormat: .bgra8Unorm_srgb, width: w, height: h,
+            usage: [.shaderRead, .shaderWrite], mipmapsMode: .none)
+        let q = try TextureResource.DrawableQueue(desc)
+        let black = UIImage(color: .black, size: CGSize(width: w, height: h)).cgImage!
+        let t = try TextureResource(image: black, options: .init(semantic: .color))
+        t.replace(withDrawables: q)
+        queue = q
+        texture = t
+        width = w
+        height = h
+        if let e = entity {
+            var material = UnlitMaterial()
+            material.color = .init(texture: .init(t))
+            e.model?.materials = [material]
+        }
+        fputs("[host] screen: \(w)x\(h) texture ready\n", stderr); fflush(stderr)
+    }
+
+    func start() {
+        task?.cancel()
+        task = Task.detached(priority: .userInitiated) { [weak self] in
+            xemu_host_set_metal_present(true)
+            var flips: Int32 = -1
+            var zeroCopy = true
+            while !Task.isCancelled {
+                guard let self else { return }
+                if zeroCopy {
+                    let now = xemu_host_guest_flips()
+                    if now != flips {
+                        flips = now
+                        let r = await self.presentFromGPU()
+                        if r < 0 {
+                            zeroCopy = false
+                            xemu_host_set_metal_present(false)
+                        }
+                    }
+                    try? await Task.sleep(nanoseconds: 2_000_000)
+                } else {
+                    await self.pump()
+                    try? await Task.sleep(nanoseconds: 33_000_000)
+                }
+            }
+        }
+    }
+
+    /// One frame from the renderer into the next drawable, no CPU in the
+    /// way. Rebuilds the queue when the guest changes its scan-out size.
+    @MainActor private func presentFromGPU() async -> Int32 {
+        var w: Int32 = 0, h: Int32 = 0
+        guard xemu_host_present_size(&w, &h), w > 0, h > 0 else { return 0 }
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return 0 }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return 0 }
+        let tex = Unmanaged.passUnretained(drawable.texture).toOpaque()
+        let r = xemu_host_present_frame(tex, w, h)
+        if r == 1 {
+            drawable.present()
+            shown += 1
+            if shown == 1 { entity?.isEnabled = true }
+            if shown <= 3 || shown % 600 == 0 {
+                fputs("[host] screen: GPU frame \(shown) (\(w)x\(h))\n", stderr)
+                fflush(stderr)
+            }
+        }
+        return r
+    }
+
+    private func pump() {
+        var bgra: UnsafeMutableRawPointer?
+        var w: Int32 = 0, h: Int32 = 0
+        let seq = xemu_host_frame_take(lastSeq, &bgra, &w, &h)
+        guard seq != 0, let pixels = bgra else { return }
+        defer { free(pixels) }
+        lastSeq = seq
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return }
+        let region = MTLRegionMake2D(0, 0, Int(w), Int(h))
+        drawable.texture.replace(region: region, mipmapLevel: 0,
+                                 withBytes: pixels, bytesPerRow: Int(w) * 4)
+        drawable.present()
+        shown += 1
+        if shown == 1 { entity?.isEnabled = true }
+        if shown <= 3 || shown % 300 == 0 {
+            fputs("[host] screen: frame \(shown) (seq \(seq), \(w)x\(h))\n", stderr)
+            fflush(stderr)
+        }
+    }
+}
+
+private extension UIImage {
+    convenience init(color: UIColor, size: CGSize) {
+        let r = UIGraphicsImageRenderer(size: size)
+        let img = r.image { ctx in
+            color.setFill()
+            ctx.fill(CGRect(origin: .zero, size: size))
+        }
+        self.init(cgImage: img.cgImage!)
+    }
+}
