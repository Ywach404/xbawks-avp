+void xemu_guest_polling(void)
+{
+    NV2AState *d = g_nv2a;
+    if (!d || !qatomic_read(&d->pgraph.reports_deferred)) {
+        return;
+    }
+    int64_t now = get_clock();
+    if (now - qatomic_read(&xemu_guest_poll_ns) < 100000) {
+        return;   /* kicked within the last 100 us */
+    }
+    qatomic_set(&xemu_guest_poll_ns, now);
+    xemu_guest_poll_kicks++;
