+/*
+ * Whether a debugger is attached right now. On this platform the JIT's
+ * code buffer can only be prepared by one (see tcg/region.c), and the
+ * check there fails the boot with the reason in the log and nothing on
+ * screen. The picker asks this first so the reason is on screen instead,
+ * before a disc is chosen rather than after.
+ */
+bool xemu_host_debugger_attached(void)
+{
+    struct kinfo_proc info;
+    size_t len = sizeof(info);
+    int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid() };
+
+    info.kp_proc.p_flag = 0;
+    if (sysctl(mib, 4, &info, &len, NULL, 0) != 0) {
+        return false;
+    }
+    return (info.kp_proc.p_flag & P_TRACED) != 0;
+}
