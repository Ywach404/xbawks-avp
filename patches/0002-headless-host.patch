+/*
+ * JIT on the iOS family, the only way it is available.
+ *
+ * Measured on a Vision Pro running visionOS 27 (see DEVLOG, S0): an app
+ * cannot make its own memory executable. MAP_JIT returns EPERM and
+ * mprotect to R+X returns success and then faults on the first instruction
+ * fetch. What does work is a debugger writing to each page of an
+ * already-RX mapping, after which those pages execute for the life of the
+ * process, including after the debugger detaches.
+ *
+ * The request is a trap. The debugger reads x0 and x1, prepares that range
+ * and continues us. With nothing attached the trap is fatal, so it is
+ * gated on actually being traced.
+ */
+static bool debugger_is_attached(void)
+{
+    struct kinfo_proc info;
+    size_t len = sizeof(info);
+    int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid() };
+
+    info.kp_proc.p_flag = 0;
+    if (sysctl(mib, 4, &info, &len, NULL, 0) != 0) {
+        return false;
+    }
+    return (info.kp_proc.p_flag & P_TRACED) != 0;
+}
+
+/*
+ * Say which way the code buffer was obtained, and what the platform would
+ * allow today.
+ *
+ * The debugger path is 22 lines and the only one that works here as of
+ * 2026-11-01. The other two are Apple's own, and both are checked on every
+ * boot rather than only by the weekly SDK tripwire, so the app itself is
+ * the thing that notices the day the policy moves. A line reading ACCEPTED
+ * or RESOLVES means rerun probes/jit-probe on device: the attach may no
+ * longer be needed.
+ *
+ * It also catches the inverse. If this ever stops saying "debugger" on a
+ * build that used to work, the platform has closed rather than opened.
+ */
+static void log_jit_strategy(const char *chosen)
+{
+    bool map_jit = false;
+    void *probe = mmap(NULL, qemu_real_host_page_size(),
+                       PROT_READ | PROT_WRITE | PROT_EXEC,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT, -1, 0);
+    if (probe != MAP_FAILED) {
+        map_jit = true;
+        munmap(probe, qemu_real_host_page_size());
+    }
+    bool toggle = dlsym(RTLD_DEFAULT,
+                        "pthread_jit_write_protect_supported_np") != NULL;
+
+    fprintf(stderr, "[tcg] jit strategy: %s\n", chosen);
+    fprintf(stderr, "[tcg]   MAP_JIT: %s\n",
+            map_jit ? "ACCEPTED, first-party JIT may be available, rerun the probe"
+                    : "refused, as expected");
+    fprintf(stderr, "[tcg]   pthread_jit_write_protect_supported_np: %s\n",
+            toggle ? "RESOLVES, the platform has moved, rerun the probe"
+                   : "absent, as expected");
+    fflush(stderr);
+}
