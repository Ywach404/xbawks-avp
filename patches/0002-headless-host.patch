+#if (TARGET_OS_VISION || TARGET_OS_IOS) && defined(__aarch64__)
+#include "qemu/cacheflush.h"
+
+/*
+ * Diagnostic: run two instructions from the prepared buffer, and say so
+ * before doing it. A kill for executing a page the monitor rejects
+ * arrives as SIGKILL with nothing to catch, so the last of these lines in
+ * the log is the step that revoked execution. The slot is the last 64
+ * bytes below the guard page, which TB allocation never reaches.
+ */
+static uint8_t *selftest_rw;
+static uint8_t *selftest_rx;
+/* A second slot at the very start of a page, over the debugger's word. */
+static uint8_t *selftest2_rw;
+static uint8_t *selftest2_rx;
+
+static void selftest_slot(const char *when, const char *which,
+                          uint8_t *rw, uint8_t *rx)
+{
+    uint32_t code[2] = { 0xD2800540u, 0xD65F03C0u };   /* mov x0, #42; ret */
+    memcpy(rw, code, sizeof(code));
+    flush_idcache_range((uintptr_t)rx, (uintptr_t)rw, sizeof(code));
+    {
+        extern unsigned long long xemu_host_footprint_mib(void);
+        fprintf(stderr, "[tcg] selftest %s: %s calling %p (footprint %llu MiB)\n",
+                when, which, rx, xemu_host_footprint_mib());
+    }
+    fflush(stderr);
+    int r = ((int (*)(void))rx)();
+    fprintf(stderr, "[tcg] selftest %s: %s returned %d\n", when, which, r);
+    fflush(stderr);
+}
+
+void tcg_jit_selftest(const char *when)
+{
+    if (!selftest_rw) {
+        return;
+    }
+    selftest_slot(when, "far slot", selftest_rw, selftest_rx);
+    selftest_slot(when, "page-start slot", selftest2_rw, selftest2_rx);
+}
+
+/*
+ * The real prologue, entered the way cpu_tb_exec enters it, with the
+ * epilogue as its target so it returns at once. env is never touched on
+ * that path. This executes the first page of the buffer, which TCG
+ * overwrote from byte zero.
+ */
+void tcg_jit_selftest_prologue(const char *when)
+{
+    if (!tcg_code_gen_epilogue) {
+        fprintf(stderr, "[tcg] selftest %s: no prologue yet\n", when);
+        return;
+    }
+    fprintf(stderr, "[tcg] selftest %s: prologue calling %p -> %p\n", when,
+            (void *)tcg_qemu_tb_exec, tcg_code_gen_epilogue);
+    fflush(stderr);
+    uintptr_t r = tcg_qemu_tb_exec(NULL, tcg_code_gen_epilogue);
+    fprintf(stderr, "[tcg] selftest %s: prologue returned 0x%lx\n", when,
+            (unsigned long)r);
+    fflush(stderr);
+}
+
+static void *selftest_thread_fn(void *arg)
+{
+    const char *when = arg;
+    tcg_jit_selftest(when);
+    tcg_jit_selftest_prologue(when);
+    return NULL;
+}
+
+/* The same, from a thread that never issued the request. */
+void tcg_jit_selftest_thread(const char *when)
+{
+    pthread_t t;
+    if (pthread_create(&t, NULL, selftest_thread_fn, (void *)when) == 0) {
+        pthread_join(t, NULL);
+    }
+}
