+/* ------------------------------------------------------------------ */
+/* Zero-copy presentation                                               */
+/* ------------------------------------------------------------------ */
+
+/*
+ * VK_EXT_metal_objects, import direction. Declared here rather than
+ * through vulkan_metal.h so the file needs no platform define; the
+ * layout is the one from the header (sType, pNext, plane, mtlTexture).
+ */
+typedef struct {
+    VkStructureType sType;
+    const void *pNext;
+    VkImageAspectFlagBits plane;
+    void *mtlTexture;
+} XemuImportMetalTextureInfoEXT;
+
+static bool ensure_present_image(PGRAPHVkState *r)
+{
+    for (int i = 0; i < 4; i++) {
+        if (r->present_images[i].target == r->present_target &&
+            r->present_images[i].width == r->present_width &&
+            r->present_images[i].height == r->present_height) {
+            r->present_image = r->present_images[i].image;
+            return true;
+        }
+    }
+
+    /* A new texture, or a resized one: take the next slot over. */
+    int slot = r->present_images_next;
+    r->present_images_next = (slot + 1) % 4;
+    if (r->present_images[slot].image != VK_NULL_HANDLE) {
+        vkDestroyImage(r->device, r->present_images[slot].image, NULL);
+        if (r->present_images[slot].alloc) {
+            vmaFreeMemory(r->allocator, r->present_images[slot].alloc);
+        }
+        memset(&r->present_images[slot], 0, sizeof(r->present_images[slot]));
+    }
+
+    XemuImportMetalTextureInfoEXT import = {
+        .sType = VK_STRUCTURE_TYPE_IMPORT_METAL_TEXTURE_INFO_EXT,
+        .plane = VK_IMAGE_ASPECT_PLANE_0_BIT,
+        .mtlTexture = r->present_target,
+    };
+    VkImageCreateInfo ci = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &import,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .extent.width = r->present_width,
+        .extent.height = r->present_height,
+        .extent.depth = 1,
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .format = VK_FORMAT_B8G8R8A8_SRGB,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+    };
+    VkImage image = VK_NULL_HANDLE;
+    VmaAllocation alloc = NULL;
+    VkResult res = vkCreateImage(r->device, &ci, NULL, &image);
+    if (res != VK_SUCCESS) {
+        fprintf(stderr, "[vk] present: import of Metal texture refused (%d)\n",
+                (int)res);
+        return false;
+    }
+    /* An imported texture may or may not want memory bound; ask. */
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(r->device, image, &req);
+    if (req.size) {
+        /* vmaAllocateMemoryForImage refuses the AUTO usages; GPU_ONLY it is. */
+        VmaAllocationCreateInfo ai = { .usage = VMA_MEMORY_USAGE_GPU_ONLY };
+        res = vmaAllocateMemoryForImage(r->allocator, image, &ai, &alloc, NULL);
+        if (res == VK_SUCCESS) {
+            res = vmaBindImageMemory(r->allocator, alloc, image);
+        }
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "[vk] present: memory for imported image failed "
+                            "(%d)\n", (int)res);
+            vkDestroyImage(r->device, image, NULL);
+            return false;
+        }
+    }
+    fprintf(stderr, "[vk] present: imported Metal texture %p as %dx%d "
+                    "(memory requirement %llu bytes), slot %d\n",
+            r->present_target, r->present_width, r->present_height,
+            (unsigned long long)req.size, slot);
+    fflush(stderr);
+    r->present_images[slot].target = r->present_target;
+    r->present_images[slot].image = image;
+    r->present_images[slot].alloc = alloc;
+    r->present_images[slot].width = r->present_width;
+    r->present_images[slot].height = r->present_height;
+    r->present_image = image;
+    return true;
+}
+
+static SurfaceBinding *scanout_surface(NV2AState *d)
+{
+    VGADisplayParams vp;
+    d->vga.get_params(&d->vga, &vp);
+    SurfaceBinding *s = pgraph_vk_surface_get_within(d, d->pcrtc.start + vp.line_offset);
+    if (!s || !s->color || !s->width || !s->height) {
+        return NULL;
+    }
+    return s;
+}
+
+bool pgraph_vk_present_size(NV2AState *d, int *w, int *h)
+{
+    PGRAPHState *pg = &d->pgraph;
+    qemu_mutex_lock(&d->pfifo.lock);
+    SurfaceBinding *s = scanout_surface(d);
+    bool ok = s != NULL;
+    if (ok) {
+        unsigned sw = s->width, sh = s->height;
+        pgraph_apply_scaling_factor(pg, &sw, &sh);
+        *w = sw;
+        *h = sh;
+    }
+    qemu_mutex_unlock(&d->pfifo.lock);
+    return ok;
+}
+
+/* On the render thread, under the pgraph lock, like a download. */
+void pgraph_vk_process_pending_present(NV2AState *d)
+{
+    PGRAPHState *pg = &d->pgraph;
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    int result = 0;
+    static int shown;
+
+    SurfaceBinding *surface = scanout_surface(d);
+    if (surface) {
+        unsigned sw = surface->width, sh = surface->height;
+        pgraph_apply_scaling_factor(pg, &sw, &sh);
+        if ((int)sw != r->present_width || (int)sh != r->present_height) {
+            result = 0;          /* the host will resize and try again */
+        } else if (!ensure_present_image(r)) {
+            result = -1;         /* no import on this device: use the CPU path */
+        } else {
+            pgraph_vk_finish(pg, VK_FINISH_REASON_SURFACE_DOWN);
+            VkCommandBuffer cmd = pgraph_vk_begin_single_time_commands(pg);
+            pgraph_vk_transition_image_layout(
+                pg, cmd, surface->image, surface->host_fmt.vk_format,
+                VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+            pgraph_vk_transition_image_layout(
+                pg, cmd, r->present_image, VK_FORMAT_B8G8R8A8_SRGB,
+                VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+
+            bool bgra = surface->host_fmt.vk_format == VK_FORMAT_B8G8R8A8_UNORM ||
+                        surface->host_fmt.vk_format == VK_FORMAT_B8G8R8A8_SRGB;
+            if (bgra) {
+                /* Same bits, no conversion: the surface's sRGB values land
+                 * in the sRGB drawable untouched. */
+                VkImageCopy region = {
+                    .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                    .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                    .extent = { sw, sh, 1 },
+                };
+                vkCmdCopyImage(cmd, surface->image,
+                               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               r->present_image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+            } else {
+                VkImageBlit blit = {
+                    .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                    .srcOffsets = { { 0, 0, 0 }, { (int)sw, (int)sh, 1 } },
+                    .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                    .dstOffsets = { { 0, 0, 0 }, { (int)sw, (int)sh, 1 } },
+                };
+                vkCmdBlitImage(cmd, surface->image,
+                               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               r->present_image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit,
+                               VK_FILTER_NEAREST);
+            }
+            pgraph_vk_transition_image_layout(
+                pg, cmd, surface->image, surface->host_fmt.vk_format,
+                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+            pgraph_vk_end_single_time_commands(pg, cmd);
+            result = 1;
+            if (shown++ < 3) {
+                fprintf(stderr, "[vk] present: %s %ux%u surface format %d\n",
+                        bgra ? "copied" : "blitted", sw, sh,
+                        (int)surface->host_fmt.vk_format);
+                fflush(stderr);
+            }
+        }
+    }
+
+    r->present_result = result;
+    qatomic_set(&r->present_pending, false);
+    qemu_event_set(&r->present_complete);
+}
