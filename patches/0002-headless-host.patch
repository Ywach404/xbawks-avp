+/*
+ * Diagnostic: do the writable and executable views still show the same
+ * bytes? They are meant to be one set of pages seen twice. If they ever
+ * diverge, the code TCG writes is not the code that executes, which would
+ * look exactly like a CPU that never leaves its reset vector and never
+ * faults. Compares the start of the buffer, where the prologue lives.
+ */
+/*
+ * Diagnostic: a scratch slot the host may write code into and call. The
+ * last 64 bytes of the last region sit below the highwater mark, so TB
+ * allocation never reaches them. rx_base is the executable view of the
+ * buffer start, where the prologue lives.
+ */
+int tcg_splitwx_scratch(void **rw, void **rx, size_t *len, void **rx_base)
+{
+    void *start, *end;
+    if (!tcg_splitwx_diff || !region.start_aligned || !region.n) {
+        return 0;
+    }
+    tcg_region_bounds(region.n - 1, &start, &end);
+    *len = 64;
+    *rw = (char *)end - 64;
+    *rx = (char *)*rw + tcg_splitwx_diff;
+    *rx_base = (char *)region.start_aligned + tcg_splitwx_diff;
+    return 1;
+}
+
+int tcg_splitwx_views_match(size_t n, size_t *first_diff)
+{
+    if (!tcg_splitwx_diff || !region.start_aligned) {
+        return -1;
+    }
+    const uint8_t *rw = (const uint8_t *)region.start_aligned;
+    const uint8_t *rx = rw + tcg_splitwx_diff;
+    for (size_t i = 0; i < n; i++) {
+        if (rw[i] != rx[i]) {
+            if (first_diff) *first_diff = i;
+            return 0;
+        }
+    }
+    return 1;
+}
