diff --git a/ui/xemu-host-ios.m b/ui/xemu-host-ios.m
new file mode 100644
index 0000000..ae6eac2
--- /dev/null
+++ b/ui/xemu-host-ios.m
@@ -0,0 +1,869 @@
+/*
+ * xemu-host-ios.m -- the UIKit side of the house.
+ *
+ * Copyright (C) 2026 A. Cervantez
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * visionOS will install a bundle whose executable never calls
+ * UIApplicationMain, and it will not run it: the process is killed about a
+ * second in, with no crash report, no stdout, and a launch error that says
+ * only "the connection was invalidated". Measured 2026-10-25.
+ *
+ * So the app checks in properly here, and the emulator runs on a worker
+ * thread, which is the arrangement ui/xemu.c already used on macOS.
+ */
+
+#import <TargetConditionals.h>
+
+#if TARGET_OS_VISION || TARGET_OS_IOS
+
+#import <UIKit/UIKit.h>
+#import <GameController/GameController.h>
+/*
+ * Deliberately NOT <SDL3/SDL_main.h>. That header renames main() to
+ * SDL_main() and supplies its own, which on the iOS family runs SDL's
+ * UIApplicationMain path. The binary then carries both _main and
+ * _SDL_main, ours runs second inside SDL's app, and SDL_SetMainReady has
+ * no effect because SDL is already past that point. Measured 2026-10-26.
+ *
+ * UIKit entry stays ours; only the one declaration is needed.
+ */
+extern void SDL_SetMainReady(void);
+#include <pthread.h>
+#include <execinfo.h>
+#include <signal.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int xemu_host_run(int argc, char **argv);
+
+/*
+ * Where the app's own files are. There is no working directory on a
+ * headset worth the name, and the media is copied into the bundle at build
+ * time, so this is how the C side finds it.
+ */
+const char *xemu_host_bundle_path(void)
+{
+    static char cached[1024];
+    if (cached[0] == '\0') {
+        snprintf(cached, sizeof cached, "%s",
+                 NSBundle.mainBundle.bundlePath.fileSystemRepresentation);
+    }
+    return cached;
+}
+
+int           xemu_host_stage = 2;
+static int    g_argc;
+static char **g_argv;
+
+/*
+ * Before anything else. There is no console on a headset: devicectl's
+ * --console gives nothing for a detached launch, and a process that dies
+ * early leaves no crash report either. A file in Documents is the only
+ * channel that survives, and it has to be opened first or the interesting
+ * failures happen upstream of it.
+ */
+static void redirect_output_to_documents(void)
+{
+    NSArray<NSURL *> *docs =
+        [NSFileManager.defaultManager URLsForDirectory:NSDocumentDirectory
+                                             inDomains:NSUserDomainMask];
+    if (docs.count == 0) {
+        return;
+    }
+    NSURL *log = [docs.firstObject URLByAppendingPathComponent:@"host.log"];
+    const char *path = log.fileSystemRepresentation;
+
+    freopen(path, "w", stderr);
+    setvbuf(stderr, NULL, _IOLBF, 0);   /* line buffered: a crash keeps it */
+    dup2(fileno(stderr), fileno(stdout));
+
+    fprintf(stderr, "[host] log opened at %s\n", path);
+}
+
+/*
+ * A headset gives you nothing when a process dies: no console, no crash
+ * report, and a launch that simply stops producing output. Everything
+ * interesting so far has died that way. This turns "it vanished" into "it
+ * vanished here", written into the same log file as everything else.
+ *
+ * backtrace() in a signal handler is not strictly async-signal-safe, but
+ * the process is already dying and an imperfect trace beats none.
+ */
+static void crash_handler(int sig, siginfo_t *info, void *ctx)
+{
+    (void)ctx;
+
+    fprintf(stderr, "\n[host] ==== FATAL: signal %d (%s) ====\n",
+            sig, strsignal(sig));
+    if (info) {
+        fprintf(stderr, "[host] fault address %p, code %d\n",
+                info->si_addr, info->si_code);
+    }
+    fflush(stderr);
+
+    void *frames[64];
+    int n = backtrace(frames, 64);
+    fprintf(stderr, "[host] %d frames:\n", n);
+    fflush(stderr);
+    backtrace_symbols_fd(frames, n, fileno(stderr));
+
+    fsync(fileno(stderr));
+
+    /* Die the way we were going to. */
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+static void install_crash_handler(void)
+{
+    static const int sigs[] = { SIGSEGV, SIGBUS, SIGILL, SIGABRT,
+                                SIGTRAP, SIGFPE, SIGSYS };
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = crash_handler;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+
+    for (size_t i = 0; i < sizeof(sigs) / sizeof(sigs[0]); i++) {
+        sigaction(sigs[i], &sa, NULL);
+    }
+}
+
+
+/* ------------------------------------------------------------------ */
+/* Every thread's stack, on request                                     */
+/* ------------------------------------------------------------------ */
+
+#include <mach/mach.h>
+#include <dlfcn.h>
+
+/*
+ * A machine that is "running" with a vCPU parked on a lock is a question
+ * about every other thread, and the crash handler can only see its own.
+ * Suspend each thread in turn, read its registers, walk the frame pointer
+ * chain, and name what it finds. Reads go through vm_read_overwrite
+ * so a bad frame pointer is a short walk rather than a fault.
+ */
+static bool read_word(uint64_t at, uint64_t *out)
+{
+    vm_size_t got = 0;
+    kern_return_t kr = vm_read_overwrite(mach_task_self(), (vm_address_t)at,
+                                         sizeof(*out), (vm_address_t)out,
+                                         &got);
+    return kr == KERN_SUCCESS && got == sizeof(*out);
+}
+
+static void print_frame(int i, uint64_t addr)
+{
+    Dl_info info;
+    addr &= 0x0000007fffffffffULL;
+    if (dladdr((void *)addr, &info) && info.dli_sname) {
+        const char *img = strrchr(info.dli_fname, '/');
+        fprintf(stderr, "[host]     %2d  %s + %llu  (%s)\n", i, info.dli_sname,
+                (unsigned long long)(addr - (uint64_t)info.dli_saddr),
+                img ? img + 1 : info.dli_fname);
+    } else {
+        fprintf(stderr, "[host]     %2d  0x%llx\n", i, (unsigned long long)addr);
+    }
+}
+
+void xemu_host_dump_threads(const char *why)
+{
+    thread_act_array_t threads = NULL;
+    mach_msg_type_number_t count = 0;
+    if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS) {
+        fprintf(stderr, "[host] thread dump: task_threads failed\n");
+        return;
+    }
+    mach_port_t self = mach_thread_self();
+    fprintf(stderr, "[host] ==== %u threads (%s) ====\n", count, why);
+
+    for (mach_msg_type_number_t t = 0; t < count; t++) {
+        thread_t th = threads[t];
+        char name[64] = "";
+        pthread_t pt = pthread_from_mach_thread_np(th);
+        if (pt) {
+            pthread_getname_np(pt, name, sizeof(name));
+        }
+        if (th == self) {
+            fprintf(stderr, "[host]   thread %u '%s': this one (the sampler)\n",
+                    t, name);
+            continue;
+        }
+        if (thread_suspend(th) != KERN_SUCCESS) {
+            fprintf(stderr, "[host]   thread %u '%s': cannot suspend\n", t, name);
+            continue;
+        }
+        arm_thread_state64_t st;
+        mach_msg_type_number_t n = ARM_THREAD_STATE64_COUNT;
+        kern_return_t kr = thread_get_state(th, ARM_THREAD_STATE64,
+                                            (thread_state_t)&st, &n);
+        if (kr != KERN_SUCCESS) {
+            thread_resume(th);
+            fprintf(stderr, "[host]   thread %u '%s': no state\n", t, name);
+            continue;
+        }
+        uint64_t pc = arm_thread_state64_get_pc(st);
+        uint64_t lr = arm_thread_state64_get_lr(st);
+        uint64_t fp = arm_thread_state64_get_fp(st);
+
+        fprintf(stderr, "[host]   thread %u '%s':\n", t, name);
+        print_frame(0, pc);
+        print_frame(1, lr);
+        int i = 2;
+        for (; i < 28 && fp && (fp & 0xf) == 0; i++) {
+            uint64_t next = 0, ret = 0;
+            if (!read_word(fp, &next) || !read_word(fp + 8, &ret) || !ret) {
+                break;
+            }
+            print_frame(i, ret);
+            if (next <= fp) {
+                break;
+            }
+            fp = next;
+        }
+        thread_resume(th);
+    }
+    for (mach_msg_type_number_t t = 0; t < count; t++) {
+        mach_port_deallocate(mach_task_self(), threads[t]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)threads,
+                  count * sizeof(*threads));
+    mach_port_deallocate(mach_task_self(), self);
+    fprintf(stderr, "[host] ==== end of threads ====\n");
+    fflush(stderr);
+}
+
+/* ------------------------------------------------------------------ */
+/* What the kernel thinks of a page, and whether it will run code       */
+/* ------------------------------------------------------------------ */
+
+#include <libkern/OSCacheControl.h>
+
+void xemu_host_describe_page(const char *what, const void *addr)
+{
+    vm_address_t a = (vm_address_t)addr;
+    vm_size_t sz = 0;
+    natural_t depth = 1;
+    struct vm_region_submap_info_64 info;
+    mach_msg_type_number_t n = VM_REGION_SUBMAP_INFO_COUNT_64;
+    kern_return_t kr = vm_region_recurse_64(mach_task_self(), &a, &sz, &depth,
+                                            (vm_region_recurse_info_t)&info,
+                                            &n);
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr, "[host] page %s %p: vm_region failed %d\n", what, addr,
+                kr);
+        return;
+    }
+    fprintf(stderr, "[host] page %s %p: region 0x%lx+0x%lx prot %c%c%c max "
+                    "%c%c%c share %d tag %u resident %u dirty %u\n",
+            what, addr, (unsigned long)a, (unsigned long)sz,
+            (info.protection & VM_PROT_READ) ? 'r' : '-',
+            (info.protection & VM_PROT_WRITE) ? 'w' : '-',
+            (info.protection & VM_PROT_EXECUTE) ? 'x' : '-',
+            (info.max_protection & VM_PROT_READ) ? 'r' : '-',
+            (info.max_protection & VM_PROT_WRITE) ? 'w' : '-',
+            (info.max_protection & VM_PROT_EXECUTE) ? 'x' : '-',
+            info.share_mode, info.user_tag, info.pages_resident,
+            info.pages_dirtied);
+}
+
+static int probe_result = -1;
+static int (*probe_fn)(void);
+
+static void *exec_probe_thread(void *unused)
+{
+    (void)unused;
+    pthread_setname_np("exec_probe");
+    int r = probe_fn();
+    __atomic_store_n(&probe_result, r, __ATOMIC_SEQ_CST);
+    return NULL;
+}
+
+/*
+ * Write "mov x0, #42; ret" through the writable view, flush, and call it
+ * through the executable view from a helper thread. The helper is
+ * separate so a hang is a reported hang rather than the end of the log,
+ * and so the thread dump can show where it sits.
+ */
+void xemu_host_exec_probe(void *rw, void *rx)
+{
+    uint32_t code[2] = { 0xD2800540u, 0xD65F03C0u };
+    memcpy(rw, code, sizeof(code));
+    sys_dcache_flush(rw, sizeof(code));
+    sys_icache_invalidate(rx, sizeof(code));
+
+    if (memcmp(rx, code, sizeof(code)) != 0) {
+        fprintf(stderr, "[host] exec probe: rx view does not show the code\n");
+        return;
+    }
+
+    probe_fn = (int (*)(void))rx;
+    __atomic_store_n(&probe_result, -1, __ATOMIC_SEQ_CST);
+    pthread_t t;
+    if (pthread_create(&t, NULL, exec_probe_thread, NULL) != 0) {
+        fprintf(stderr, "[host] exec probe: no thread\n");
+        return;
+    }
+    pthread_detach(t);
+    for (int i = 0; i < 20; i++) {
+        usleep(100 * 1000);
+        int r = __atomic_load_n(&probe_result, __ATOMIC_SEQ_CST);
+        if (r != -1) {
+            fprintf(stderr, "[host] exec probe: returned %d after %d ms\n",
+                    r, (i + 1) * 100);
+            return;
+        }
+    }
+    fprintf(stderr, "[host] exec probe: HUNG, no return in 2 s\n");
+}
+
+/*
+ * Resident memory by VM tag, and every region over 64 MiB. The footprint
+ * jumped by gigabytes inside Vulkan init, and the tag says whose it is:
+ * malloc, IOKit (Metal), or a plain anonymous mapping.
+ */
+void xemu_host_dump_vm_regions(void)
+{
+    unsigned long long by_tag[256] = { 0 };
+    vm_address_t addr = 0;
+    unsigned long long total = 0;
+    fprintf(stderr, "[host] vm regions over 64 MiB:\n");
+    for (;;) {
+        vm_size_t size = 0;
+        natural_t depth = 1;
+        struct vm_region_submap_info_64 info;
+        mach_msg_type_number_t n = VM_REGION_SUBMAP_INFO_COUNT_64;
+        if (vm_region_recurse_64(mach_task_self(), &addr, &size, &depth,
+                                 (vm_region_recurse_info_t)&info, &n)
+            != KERN_SUCCESS) {
+            break;
+        }
+        unsigned long long resident =
+            (unsigned long long)info.pages_resident * vm_page_size;
+        by_tag[info.user_tag & 0xff] += resident;
+        total += resident;
+        if (resident >= (64ull << 20)) {
+            fprintf(stderr, "[host]   0x%lx +0x%lx tag %u prot %d/%d share %d "
+                            "resident %llu MiB\n",
+                    (unsigned long)addr, (unsigned long)size, info.user_tag,
+                    info.protection, info.max_protection, info.share_mode,
+                    resident >> 20);
+        }
+        addr += size;
+    }
+    fprintf(stderr, "[host] resident by tag (total %llu MiB):\n", total >> 20);
+    for (int t = 0; t < 256; t++) {
+        if (by_tag[t] >= (16ull << 20)) {
+            fprintf(stderr, "[host]   tag %3d: %llu MiB\n", t, by_tag[t] >> 20);
+        }
+    }
+    fflush(stderr);
+}
+
+static void log_normal_exit(void)
+{
+    fprintf(stderr, "[host] process exiting normally\n");
+    fflush(stderr);
+}
+
+static void *emulator_thread(void *unused)
+{
+    (void)unused;
+    fprintf(stderr, "[host] emulator thread starting\n");
+    int rc = xemu_host_run(g_argc, g_argv);
+    fprintf(stderr, "[host] emulator returned %d\n", rc);
+    return NULL;
+}
+
+/*
+ * visionOS will not call didFinishLaunching without a scene manifest, and a
+ * manifest naming a delegate class needs that class to exist. This one does
+ * nothing but put a window up, because something has to be on screen for
+ * the app to stay alive, and later it is where the compositor goes.
+ */
+#import "xemu-host-bridge.h"
+
+@interface XemuScreenViewController ()
+@property (nonatomic, strong) CADisplayLink *link;
+@property (nonatomic, assign) uint64_t ticks;
+@property (nonatomic, strong) UIImageView *screen;
+@property (nonatomic, assign) uint64_t frameSeq;
+@property (nonatomic, assign) uint64_t framesShown;
+@property (nonatomic, assign) uint16_t lastButtons;
+@property (nonatomic, assign) uint64_t padSamples;
+@end
+
+@implementation XemuScreenViewController
+
+- (void)viewDidLoad
+{
+    [super viewDidLoad];
+    fprintf(stderr, "[host] screen view loaded\n");
+    self.view.backgroundColor = UIColor.blackColor;
+
+    /*
+     * Lifecycle, with the tick count as a clock. Every thread's output
+     * stopped at once thirty seconds into a run, which is a suspend, and
+     * the log should say what preceded it.
+     */
+    NSArray *names = @[ UIApplicationDidEnterBackgroundNotification,
+                        UIApplicationWillEnterForegroundNotification,
+                        UIApplicationDidBecomeActiveNotification,
+                        UIApplicationWillResignActiveNotification,
+                        UISceneDidActivateNotification,
+                        UISceneWillDeactivateNotification,
+                        UISceneDidEnterBackgroundNotification,
+                        UISceneWillEnterForegroundNotification ];
+    for (NSNotificationName name in names) {
+        [NSNotificationCenter.defaultCenter
+            addObserverForName:name object:nil
+                         queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification *n) {
+            fprintf(stderr, "[host] lifecycle %s at tick %llu\n",
+                    n.name.UTF8String, (unsigned long long)self.ticks);
+            fflush(stderr);
+            /* Leaving: before the GPU goes. Returning: once active again. */
+            if ([n.name isEqualToString:UIApplicationWillResignActiveNotification]) {
+                xemu_host_set_background(true);
+            } else if ([n.name isEqualToString:UIApplicationDidBecomeActiveNotification]) {
+                xemu_host_set_background(false);
+            }
+        }];
+    }
+
+    /* The guest's frame, scaled to fit, over the black. */
+    self.screen = [[UIImageView alloc] initWithFrame:self.view.bounds];
+    self.screen.autoresizingMask = UIViewAutoresizingFlexibleWidth |
+                                   UIViewAutoresizingFlexibleHeight;
+    self.screen.contentMode = UIViewContentModeScaleAspectFit;
+    [self.view addSubview:self.screen];
+
+    /*
+     * Present something every frame.
+     *
+     * The process is being killed with an uncatchable signal: no handler
+     * fires, no abort, no clean exit. Memory is part of it, but the other
+     * suspect is a scene that never draws while a worker thread runs flat
+     * out. This gives the compositor a reason to believe the app is alive,
+     * and it ticks the log for the first second so the timeline shows
+     * whether the scene was still running when the process went.
+     */
+    /*
+     * Controllers come through GameController. A DualSense paired in
+     * Settings shows up as an extended gamepad; the state is read on
+     * every display tick and handed to the emulator's port 1 controller.
+     */
+    for (GCController *c in GCController.controllers) {
+        fprintf(stderr, "[host] controller already present: %s\n",
+                c.vendorName.UTF8String ?: "?");
+    }
+    [NSNotificationCenter.defaultCenter
+        addObserverForName:GCControllerDidConnectNotification object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification *n) {
+        GCController *c = n.object;
+        fprintf(stderr, "[host] controller connected: %s (extended %s)\n",
+                c.vendorName.UTF8String ?: "?",
+                c.extendedGamepad ? "yes" : "no");
+        if (c.extendedGamepad) {
+            /* No stick value has ever reached the app through either
+             * profile; ask the sticks themselves. */
+            c.extendedGamepad.leftThumbstick.valueChangedHandler =
+                ^(GCControllerDirectionPad *pad, float x, float y) {
+                static int n; if (n++ < 60) {
+                    fprintf(stderr, "[host] left stick %.2f,%.2f\n", x, y); fflush(stderr); }
+            };
+            c.extendedGamepad.rightThumbstick.valueChangedHandler =
+                ^(GCControllerDirectionPad *pad, float x, float y) {
+                static int n; if (n++ < 60) {
+                    fprintf(stderr, "[host] right stick %.2f,%.2f\n", x, y); fflush(stderr); }
+            };
+            c.extendedGamepad.dpad.valueChangedHandler =
+                ^(GCControllerDirectionPad *pad, float x, float y) {
+                static int n; if (n++ < 60) {
+                    fprintf(stderr, "[host] dpad %.2f,%.2f\n", x, y); fflush(stderr); }
+            };
+        }
+        /* Every element the device offers, so a wrong guess shows here. */
+        NSArray *keys = [c.physicalInputProfile.elements.allKeys
+                            sortedArrayUsingSelector:@selector(compare:)];
+        fprintf(stderr, "[host]   elements: %s\n",
+                [keys componentsJoinedByString:@", "].UTF8String);
+        fflush(stderr);
+        /*
+         * Every element change the framework delivers, as it delivers it.
+         * Polling can miss a short press; this cannot. If only Menu ever
+         * fires here, the system is keeping the rest.
+         */
+        __block int fired = 0;
+        c.physicalInputProfile.valueDidChangeHandler =
+            ^(GCPhysicalInputProfile *profile, GCControllerElement *element) {
+            if (fired++ < 400) {
+                NSString *name = element.aliases.anyObject ?: @"?";
+                float v = 0;
+                if ([element isKindOfClass:GCControllerButtonInput.class]) {
+                    v = ((GCControllerButtonInput *)element).value;
+                } else if ([element isKindOfClass:GCControllerAxisInput.class]) {
+                    v = ((GCControllerAxisInput *)element).value;
+                }
+                fprintf(stderr, "[host] element '%s' -> %.2f\n",
+                        name.UTF8String, v);
+                fflush(stderr);
+            }
+        };
+    }];
+    [NSNotificationCenter.defaultCenter
+        addObserverForName:GCControllerDidDisconnectNotification object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification *n) {
+        GCController *c = n.object;
+        fprintf(stderr, "[host] controller disconnected: %s\n",
+                c.vendorName.UTF8String ?: "?");
+        fflush(stderr);
+    }];
+    fflush(stderr);
+
+    self.link = [CADisplayLink displayLinkWithTarget:self
+                                            selector:@selector(tick:)];
+    [self.link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+}
+
+static void release_frame(void *info, const void *data, size_t size)
+{
+    (void)info; (void)size;
+    free((void *)data);
+}
+
+extern uint64_t xemu_host_frame_take(uint64_t last_seq, void **bgra,
+                                     int *w, int *h);
+extern void xemu_host_pad_set(uint16_t buttons, const int16_t axis[6]);
+
+static inline int16_t axis_of(float v)
+{
+    v = v < -1 ? -1 : v > 1 ? 1 : v;
+    return (int16_t)(v * 32767.0f);
+}
+
+/*
+ * Two kinds of controller reach the headset. A gamepad (DualSense, Xbox)
+ * carries the extended profile and maps onto the Duke one to one. The
+ * PSVR2 Sense controllers arrive as two separate devices with only the
+ * generic physical profile: a thumbstick, a trigger, a grip, two face
+ * buttons and a menu button each, and the vendor name says which hand.
+ * The right hand supplies A, B, the right stick, the right trigger, the
+ * grip as Black and Options as Start; the left supplies X, Y, the left
+ * stick, the left trigger, the grip as White and Menu as Back. Y up is
+ * positive in xemu's axis convention.
+ */
+- (void)readExtended:(GCExtendedGamepad *)g into:(uint16_t *)b axis:(int16_t *)axis
+{
+    if (g.buttonA.pressed)            *b |= 1 << 0;
+    if (g.buttonB.pressed)            *b |= 1 << 1;
+    if (g.buttonX.pressed)            *b |= 1 << 2;
+    if (g.buttonY.pressed)            *b |= 1 << 3;
+    if (g.dpad.left.pressed)          *b |= 1 << 4;
+    if (g.dpad.up.pressed)            *b |= 1 << 5;
+    if (g.dpad.right.pressed)         *b |= 1 << 6;
+    if (g.dpad.down.pressed)          *b |= 1 << 7;
+    if (g.buttonOptions.pressed)      *b |= 1 << 8;   /* back */
+    if (g.buttonMenu.pressed)         *b |= 1 << 9;   /* start */
+    if (g.leftShoulder.pressed)       *b |= 1 << 10;  /* white */
+    if (g.rightShoulder.pressed)      *b |= 1 << 11;  /* black */
+    if (g.leftThumbstickButton.pressed)  *b |= 1 << 12;
+    if (g.rightThumbstickButton.pressed) *b |= 1 << 13;
+    if (g.buttonHome.pressed)         *b |= 1 << 14;  /* guide */
+    axis[0] = axis_of(g.leftTrigger.value);
+    axis[1] = axis_of(g.rightTrigger.value);
+    axis[2] = axis_of(g.leftThumbstick.xAxis.value);
+    axis[3] = axis_of(g.leftThumbstick.yAxis.value);
+    axis[4] = axis_of(g.rightThumbstick.xAxis.value);
+    axis[5] = axis_of(g.rightThumbstick.yAxis.value);
+}
+
+- (void)readPhysical:(GCController *)c into:(uint16_t *)b axis:(int16_t *)axis
+{
+    GCPhysicalInputProfile *p = c.physicalInputProfile;
+    NSString *name = c.vendorName ?: @"";
+    BOOL right = [name containsString:@"(R)"];
+    BOOL left = [name containsString:@"(L)"];
+    if (!left && !right) {
+        right = YES;    /* an unknown single device: treat as the right hand */
+    }
+    NSDictionary<NSString *, GCControllerButtonInput *> *btn = p.buttons;
+    NSDictionary<NSString *, GCControllerDirectionPad *> *pads = p.dpads;
+
+    if (btn[GCInputButtonA].pressed)       *b |= 1 << 0;
+    if (btn[GCInputButtonB].pressed)       *b |= 1 << 1;
+    if (btn[GCInputButtonX].pressed)       *b |= 1 << 2;
+    if (btn[GCInputButtonY].pressed)       *b |= 1 << 3;
+    if (btn[GCInputButtonOptions].pressed) *b |= right ? 1 << 9 : 1 << 8;
+    if (btn[GCInputButtonMenu].pressed)    *b |= right ? 1 << 9 : 1 << 8;
+    if (btn[GCInputButtonHome].pressed)    *b |= 1 << 14;
+    if (btn[GCInputGripButton].pressed ||
+        btn[right ? GCInputRightShoulder : GCInputLeftShoulder].pressed) {
+        *b |= right ? 1 << 11 : 1 << 10;
+    }
+    if (btn[GCInputThumbstickButton].pressed ||
+        btn[right ? GCInputRightThumbstickButton
+                  : GCInputLeftThumbstickButton].pressed) {
+        *b |= right ? 1 << 13 : 1 << 12;
+    }
+    GCControllerButtonInput *trig = btn[GCInputTrigger]
+        ?: btn[right ? GCInputRightTrigger : GCInputLeftTrigger];
+    if (trig) {
+        axis[right ? 1 : 0] = axis_of(trig.value);
+    }
+    GCControllerDirectionPad *stick = pads[GCInputThumbstick]
+        ?: pads[right ? GCInputRightThumbstick : GCInputLeftThumbstick];
+    if (stick) {
+        axis[right ? 4 : 2] = axis_of(stick.xAxis.value);
+        axis[right ? 5 : 3] = axis_of(stick.yAxis.value);
+    }
+}
+
+/*
+ * Diagnostic: from the host, with no controller involved, press d-pad
+ * down for a quarter second every two seconds, and A once at the end.
+ * If the dashboard's highlight moves, the guest side of input is fine.
+ * Runs from the first shown frame for thirty seconds, then never again.
+ */
+- (BOOL)injectInto:(uint16_t *)b
+{
+    if (self.framesShown == 0 || true) {
+        return NO;   /* retired: the gaze rule explained it, see the app */
+    }
+    static uint64_t start;
+    if (!start) {
+        start = self.ticks;
+        fprintf(stderr, "[host] inject: starting at tick %llu\n",
+                (unsigned long long)start);
+        fflush(stderr);
+    }
+    uint64_t t = self.ticks - start;
+    if (t > 90 * 30) {
+        return NO;
+    }
+    uint64_t phase = t % 180;              /* two seconds at 90 Hz */
+    BOOL pressed = phase < 22;             /* a quarter second */
+    static BOOL was;
+    if (pressed != was) {
+        was = pressed;
+        fprintf(stderr, "[host] inject: %s at tick %llu\n",
+                pressed ? (t > 90 * 26 ? "A down" : "dpad down") : "release",
+                (unsigned long long)t);
+        fflush(stderr);
+    }
+    if (pressed) {
+        *b |= (t > 90 * 26) ? (1 << 0) : (1 << 7);
+    }
+    return YES;
+}
+
+- (void)readController
+{
+    uint16_t b = 0;
+    int16_t axis[6] = { 0 };
+    BOOL any = NO, haveLeft = NO, haveRight = NO;
+    if ([self injectInto:&b]) {
+        any = YES;
+    }
+    for (GCController *c in GCController.controllers) {
+        if (c.extendedGamepad) {
+            [self readExtended:c.extendedGamepad into:&b axis:axis];
+            haveLeft = haveRight = YES;
+        } else if (c.physicalInputProfile) {
+            [self readPhysical:c into:&b axis:axis];
+            NSString *name = c.vendorName ?: @"";
+            if ([name containsString:@"(L)"]) haveLeft = YES; else haveRight = YES;
+        } else {
+            continue;
+        }
+        any = YES;
+    }
+    if (!any) {
+        return;
+    }
+
+    /*
+     * One hand only: the dashboard and most menus navigate with the left
+     * stick and the d-pad, so a lone right controller lends its stick to
+     * the left side and to the d-pad, and a lone left controller lends
+     * its stick to the right. The moment the other hand connects each
+     * side is its own again.
+     */
+    if (haveRight && !haveLeft) {
+        axis[2] = axis[4];
+        axis[3] = axis[5];
+    } else if (haveLeft && !haveRight) {
+        axis[4] = axis[2];
+        axis[5] = axis[3];
+    }
+    if (!(haveLeft && haveRight)) {
+        const int16_t edge = 16000;
+        if (axis[2] < -edge) b |= 1 << 4;   /* d-pad left */
+        if (axis[3] >  edge) b |= 1 << 5;   /* up */
+        if (axis[2] >  edge) b |= 1 << 6;   /* right */
+        if (axis[3] < -edge) b |= 1 << 7;   /* down */
+    }
+    xemu_host_pad_set(b, axis);
+
+    /* Raw state once a second, so "no presses" and "presses not arriving"
+     * stop looking the same in the log. */
+    if (self.ticks % 450 == 0) {
+        fprintf(stderr, "[host] %lu controllers, current '%s'\n",
+                (unsigned long)GCController.controllers.count,
+                GCController.current.vendorName.UTF8String ?: "none");
+    }
+    if (self.ticks % 90 == 0) {
+        for (GCController *c in GCController.controllers) {
+            GCPhysicalInputProfile *p = c.physicalInputProfile;
+            fprintf(stderr, "[host] pad raw '%s': buttons %lu, A %d B %d X %d "
+                            "Y %d menu %d grip %.2f trigger %.2f stick %.2f,%.2f "
+                            "attached %d current %d\n",
+                    c.vendorName.UTF8String ?: "?",
+                    (unsigned long)p.buttons.count,
+                    p.buttons[GCInputButtonA].pressed,
+                    p.buttons[GCInputButtonB].pressed,
+                    p.buttons[GCInputButtonX].pressed,
+                    p.buttons[GCInputButtonY].pressed,
+                    p.buttons[GCInputButtonMenu].pressed,
+                    p.buttons[GCInputGripButton].value,
+                    p.buttons[GCInputTrigger].value,
+                    p.dpads[GCInputThumbstick].xAxis.value,
+                    p.dpads[GCInputThumbstick].yAxis.value,
+                    (int)c.isAttachedToDevice,
+                    (int)(GCController.current == c));
+        }
+        fflush(stderr);
+    }
+
+    self.padSamples++;
+    if (b != self.lastButtons) {
+        self.lastButtons = b;
+        fprintf(stderr, "[host] pad buttons 0x%04x\n", b);
+        fflush(stderr);
+    }
+}
+
+- (void)tick:(CADisplayLink *)link
+{
+    self.ticks++;
+    [self readController];
+
+    void *bgra = NULL;
+    int w = 0, h = 0;
+    uint64_t seq = xemu_host_frame_take(self.frameSeq, &bgra, &w, &h);
+    if (seq) {
+        self.frameSeq = seq;
+        /* x8r8g8b8 little endian in memory is BGRX, which this spells. */
+        CGDataProviderRef provider = CGDataProviderCreateWithData(
+            NULL, bgra, (size_t)w * 4 * h, release_frame);
+        CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
+        CGImageRef img = CGImageCreate(
+            w, h, 8, 32, (size_t)w * 4, cs,
+            kCGBitmapByteOrder32Little | kCGImageAlphaNoneSkipFirst,
+            provider, NULL, false, kCGRenderingIntentDefault);
+        self.screen.image = [UIImage imageWithCGImage:img];
+        CGImageRelease(img);
+        CGColorSpaceRelease(cs);
+        CGDataProviderRelease(provider);
+        self.framesShown++;
+        if (self.framesShown <= 3 || self.framesShown % 300 == 0) {
+            fprintf(stderr, "[host] shown frame %llu (seq %llu, %dx%d)\n",
+                    (unsigned long long)self.framesShown,
+                    (unsigned long long)seq, w, h);
+            fflush(stderr);
+        }
+    }
+
+    /* The strobe stays until the first real frame, so a dead machine still
+     * shows a live scene. */
+    if (self.framesShown == 0) {
+        CGFloat v = (self.ticks % 120) / 240.0;
+        self.view.backgroundColor = [UIColor colorWithRed:0 green:0 blue:v alpha:1];
+    } else if (self.framesShown == 1) {
+        self.view.backgroundColor = UIColor.blackColor;
+    }
+
+    if (self.ticks <= 3 || self.ticks % 300 == 0) {
+        fprintf(stderr, "[host] scene tick %llu\n",
+                (unsigned long long)self.ticks);
+        fflush(stderr);
+    }
+}
+
+@end
+
+@implementation XemuHostAppDelegate
+
+- (BOOL)application:(UIApplication *)application
+    didFinishLaunchingWithOptions:(NSDictionary *)options
+{
+    fprintf(stderr, "[host] didFinishLaunching\n");
+
+    /*
+     * Off the main thread. The emulator never returns while a machine is
+     * running, and blocking the main thread is what the watchdog kills an
+     * app for.
+     */
+    /*
+     * Bisect stage, so the one thing that stops the main run loop can be
+     * found by halving rather than guessing. Proven at stage 0: with no
+     * emulator at all the display link ticks and the app lives forever, so
+     * UIKit, the scene manifest and the window are all correct and the
+     * emulator is what does it.
+     *
+     *   0  no emulator
+     *   1  qemu_init, then stop
+     *   2  (unused)
+     *   3  everything
+     */
+    /* Set to 0 or 1 to bisect; 3 is the real thing. */
+    xemu_host_stage = 3;
+    fprintf(stderr, "[host] bisect stage %d\n", xemu_host_stage);
+
+    pthread_t t;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+    pthread_create(&t, &attr, emulator_thread, NULL);
+    pthread_detach(t);
+    pthread_attr_destroy(&attr);
+
+    return YES;
+}
+
+@end
+
+/*
+ * Everything that used to happen in main() before UIApplicationMain. The
+ * Swift App's init calls it, which is before UIKit does anything.
+ */
+void xemu_host_prepare(void)
+{
+    static char *argv0[] = { "XemuHost", NULL };
+    g_argc = 1;
+    g_argv = argv0;
+    /*
+     * SDL3 expects to own main() on the iOS family, and refuses to
+     * initialise otherwise with "did you include SDL_main.h in the
+     * file containing your main() function". UIKit owns main here, so
+     * tell SDL the job is already done.
+     *
+     * Without this the MCPX APU fails to initialise, and the guest CPU
+     * then spins forever: measured 2026-10-26.
+     */
+    SDL_SetMainReady();
+
+    redirect_output_to_documents();
+    install_crash_handler();
+    atexit(log_normal_exit);
+    fprintf(stderr, "[host] prepared, handing off to SwiftUI\n");
+    fflush(stderr);
+}
+
+#endif /* TARGET_OS_VISION || TARGET_OS_IOS */
