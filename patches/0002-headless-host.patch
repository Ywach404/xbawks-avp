+/*
+ * Which device is the guest reading? Every MMIO and port read lands here
+ * after aliases are resolved, so a per-region count answers "what is the
+ * guest polling" without first guessing which device to instrument. The
+ * second table keys on the absolute address as well, because the IDE
+ * ports are four regions that all answer to the name "ide", and because
+ * inside a 16 MB GPU BAR the region name says PFIFO when the question is
+ * which register.
+ *
+ * Written by the vCPU thread under the BQL, read by the host sampler
+ * without it. Entries are only ever appended, so a reader holding a stale
+ * count sees a smaller number, never a different device.
+ */
+XemuIoRegionStat xemu_io_regions[XEMU_IO_REGIONS];
+int xemu_io_num_regions;
+XemuIoAddrStat xemu_io_addrs[XEMU_IO_ADDRS];
+int xemu_io_num_addrs;
+unsigned long xemu_io_addr_overflow;
+
+static void xemu_io_note_read(MemoryRegion *mr, hwaddr addr)
+{
+    const char *name = mr->name ? mr->name : "(unnamed)";
+    int i;
+
+    for (i = 0; i < xemu_io_num_regions; i++) {
+        if (xemu_io_regions[i].name == name) {
+            break;
+        }
+    }
+    if (i == xemu_io_num_regions) {
+        if (i == XEMU_IO_REGIONS) {
+            return;
+        }
+        xemu_io_regions[i].name = name;
+        xemu_io_num_regions = i + 1;
+    }
+    xemu_io_regions[i].count++;
+
+    hwaddr abs = memory_region_to_absolute_addr(mr, addr);
+    for (i = 0; i < xemu_io_num_addrs; i++) {
+        if (xemu_io_addrs[i].addr == abs && xemu_io_addrs[i].name == name) {
+            break;
+        }
+    }
+    if (i == xemu_io_num_addrs) {
+        if (i == XEMU_IO_ADDRS) {
+            xemu_io_addr_overflow++;
+            return;
+        }
+        xemu_io_addrs[i].name = name;
+        xemu_io_addrs[i].addr = abs;
+        xemu_io_num_addrs = i + 1;
+    }
+    xemu_io_addrs[i].count++;
+}
+
