+ * fetch. What does work is a debugger writing to each page of an
+ * already-RX mapping, after which those pages execute for the life of the
+ * process, including after the debugger detaches.
+ *
+ * The request is a trap. The debugger reads x0 and x1, prepares that range
+ * and continues us. With nothing attached the trap is fatal, so it is
+ * gated on actually being traced.
+ */
+static bool debugger_is_attached(void)
+{
+    struct kinfo_proc info;
+    size_t len = sizeof(info);
+    int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid() };
+
+    info.kp_proc.p_flag = 0;
+    if (sysctl(mib, 4, &info, &len, NULL, 0) != 0) {
+        return false;
+    }
+    return (info.kp_proc.p_flag & P_TRACED) != 0;
+}
+
+/*
+ * Say which way the code buffer was obtained, and what the platform would
+ * allow today.
+ *
+ * The debugger path is 22 lines and the only one that works here as of
+ * 2026-11-01. The other two are Apple's own, and both are checked on every
+ * boot rather than only by the weekly SDK tripwire, so the app itself is
+ * the thing that notices the day the policy moves. A line reading ACCEPTED
+ * or RESOLVES means rerun probes/jit-probe on device: the attach may no
+ * longer be needed.
+ *
+ * It also catches the inverse. If this ever stops saying "debugger" on a
+ * build that used to work, the platform has closed rather than opened.
+ */
+static void log_jit_strategy(const char *chosen)
+{
+    bool map_jit = false;
+    void *probe = mmap(NULL, qemu_real_host_page_size(),
+                       PROT_READ | PROT_WRITE | PROT_EXEC,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT, -1, 0);
+    if (probe != MAP_FAILED) {
+        map_jit = true;
+        munmap(probe, qemu_real_host_page_size());
+    }
+    bool toggle = dlsym(RTLD_DEFAULT,
+                        "pthread_jit_write_protect_supported_np") != NULL;
+
+    fprintf(stderr, "[tcg] jit strategy: %s\n", chosen);
+    fprintf(stderr, "[tcg]   MAP_JIT: %s\n",
+            map_jit ? "ACCEPTED, first-party JIT may be available, rerun the probe"
+                    : "refused, as expected");
+    fprintf(stderr, "[tcg]   pthread_jit_write_protect_supported_np: %s\n",
+            toggle ? "RESOLVES, the platform has moved, rerun the probe"
+                   : "absent, as expected");
+    fflush(stderr);
+}
+
+static void prepare_jit_region(void *addr, size_t size)
+{
+    register void *x0 asm("x0") = addr;
+    register size_t x1 asm("x1") = size;
+
+    /* UTM's legacy JIT26 request: prepare x1 bytes at x0, then detach. */
+    asm volatile("brk #0x69" : : "r"(x0), "r"(x1) : "memory");
+}
+#endif
+
+/*
+ * Diagnostic: do the writable and executable views still show the same
+ * bytes? They are meant to be one set of pages seen twice. If they ever
+ * diverge, the code TCG writes is not the code that executes, which would
+ * look exactly like a CPU that never leaves its reset vector and never
+ * faults. Compares the start of the buffer, where the prologue lives.
+ */
+/*
+ * Diagnostic: a scratch slot the host may write code into and call. The
+ * last 64 bytes of the last region sit below the highwater mark, so TB
+ * allocation never reaches them. rx_base is the executable view of the
+ * buffer start, where the prologue lives.
+ */
+int tcg_splitwx_scratch(void **rw, void **rx, size_t *len, void **rx_base)
+{
+    void *start, *end;
+    if (!tcg_splitwx_diff || !region.start_aligned || !region.n) {
+        return 0;
+    }
+    tcg_region_bounds(region.n - 1, &start, &end);
+    *len = 64;
+    *rw = (char *)end - 64;
+    *rx = (char *)*rw + tcg_splitwx_diff;
+    *rx_base = (char *)region.start_aligned + tcg_splitwx_diff;
+    return 1;
+}
+
+int tcg_splitwx_views_match(size_t n, size_t *first_diff)
+{
+    if (!tcg_splitwx_diff || !region.start_aligned) {
+        return -1;
+    }
+    const uint8_t *rw = (const uint8_t *)region.start_aligned;
+    const uint8_t *rx = rw + tcg_splitwx_diff;
+    for (size_t i = 0; i < n; i++) {
+        if (rw[i] != rx[i]) {
+            if (first_diff) *first_diff = i;
+            return 0;
+        }
+    }
+    return 1;
+}
+
+#if (TARGET_OS_VISION || TARGET_OS_IOS) && defined(__aarch64__)
+#include "qemu/cacheflush.h"
+
+/*
+ * Diagnostic: run two instructions from the prepared buffer, and say so
+ * before doing it. A kill for executing a page the monitor rejects
+ * arrives as SIGKILL with nothing to catch, so the last of these lines in
+ * the log is the step that revoked execution. The slot is the last 64
+ * bytes below the guard page, which TB allocation never reaches.
+ */
+static uint8_t *selftest_rw;
+static uint8_t *selftest_rx;
+/* A second slot at the very start of a page, over the debugger's word. */
+static uint8_t *selftest2_rw;
+static uint8_t *selftest2_rx;
+
+static void selftest_slot(const char *when, const char *which,
+                          uint8_t *rw, uint8_t *rx)
+{
+    uint32_t code[2] = { 0xD2800540u, 0xD65F03C0u };   /* mov x0, #42; ret */
+    memcpy(rw, code, sizeof(code));
+    flush_idcache_range((uintptr_t)rx, (uintptr_t)rw, sizeof(code));
+    {
+        extern unsigned long long xemu_host_footprint_mib(void);
+        fprintf(stderr, "[tcg] selftest %s: %s calling %p (footprint %llu MiB)\n",
+                when, which, rx, xemu_host_footprint_mib());
+    }
+    fflush(stderr);
+    int r = ((int (*)(void))rx)();
+    fprintf(stderr, "[tcg] selftest %s: %s returned %d\n", when, which, r);
+    fflush(stderr);
+}
+
+void tcg_jit_selftest(const char *when)
+{
+    if (!selftest_rw) {
+        return;
+    }
+    selftest_slot(when, "far slot", selftest_rw, selftest_rx);
+    selftest_slot(when, "page-start slot", selftest2_rw, selftest2_rx);
+}
+
+/*
+ * The real prologue, entered the way cpu_tb_exec enters it, with the
+ * epilogue as its target so it returns at once. env is never touched on
+ * that path. This executes the first page of the buffer, which TCG
+ * overwrote from byte zero.
+ */
+void tcg_jit_selftest_prologue(const char *when)
+{
+    if (!tcg_code_gen_epilogue) {
+        fprintf(stderr, "[tcg] selftest %s: no prologue yet\n", when);
+        return;
+    }
+    fprintf(stderr, "[tcg] selftest %s: prologue calling %p -> %p\n", when,
+            (void *)tcg_qemu_tb_exec, tcg_code_gen_epilogue);
+    fflush(stderr);
+    uintptr_t r = tcg_qemu_tb_exec(NULL, tcg_code_gen_epilogue);
+    fprintf(stderr, "[tcg] selftest %s: prologue returned 0x%lx\n", when,
+            (unsigned long)r);
+    fflush(stderr);
+}
+
+static void *selftest_thread_fn(void *arg)
+{
+    const char *when = arg;
+    tcg_jit_selftest(when);
+    tcg_jit_selftest_prologue(when);
+    return NULL;
+}
+
+/* The same, from a thread that never issued the request. */
+void tcg_jit_selftest_thread(const char *when)
+{
+    pthread_t t;
+    if (pthread_create(&t, NULL, selftest_thread_fn, (void *)when) == 0) {
+        pthread_join(t, NULL);
+    }
+}
+#endif
+
