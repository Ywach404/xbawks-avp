+/*
+ * Where hardware interrupts land. A guest spinning in a loop is
+ * interrupted inside that loop a few thousand times a second, so the
+ * hottest interrupted address over a few seconds is the loop, with the
+ * registers it was holding. The host sampler reads the table.
+ */
+#ifndef CONFIG_USER_ONLY
+#include "system/memory.h"
+XemuIrqPc xemu_irq_pcs[XEMU_IRQ_PCS];
+int xemu_irq_num_pcs;
+#endif
+
+static void xemu_note_irq_pc(CPUX86State *env)
+{
+#ifndef CONFIG_USER_ONLY
+    uint32_t pc = (uint32_t)env->eip;
+    int i;
+    for (i = 0; i < xemu_irq_num_pcs; i++) {
+        if (xemu_irq_pcs[i].pc == pc) {
+            break;
+        }
+    }
+    if (i == xemu_irq_num_pcs) {
+        if (i == XEMU_IRQ_PCS) {
+            /* Full: recycle the coldest entry. */
+            int cold = 0;
+            for (int k = 1; k < XEMU_IRQ_PCS; k++) {
+                if (xemu_irq_pcs[k].count < xemu_irq_pcs[cold].count) {
+                    cold = k;
+                }
+            }
+            i = cold;
+            xemu_irq_pcs[i].count = 0;
+        } else {
+            xemu_irq_num_pcs = i + 1;
+        }
+        xemu_irq_pcs[i].pc = pc;
+    }
+    xemu_irq_pcs[i].count++;
+    for (int r = 0; r < 8; r++) {
+        xemu_irq_pcs[i].regs[r] = (uint32_t)env->regs[r];
+    }
+#endif
+}
+
 void do_interrupt_x86_hardirq(CPUX86State *env, int intno, int is_hw)
 {
+    if (is_hw) {
+        xemu_note_irq_pc(env);
+    }
     do_interrupt_all(env_archcpu(env), intno, 0, 0, 0, is_hw);
 }
 
