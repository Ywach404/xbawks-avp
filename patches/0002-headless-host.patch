+void xemu_host_set_background(bool background)
+{
+    qatomic_set(&g_background, background);
+    /*
+     * The scene activates while the emulator thread is still parked
+     * waiting for a disc choice, so there is no AIO context to schedule
+     * a bottom half on yet. Scheduling one anyway dereferences null and
+     * takes the process down before the picker is even drawn.
+     */
+    if (!qatomic_read(&g_qemu_ready)) {
+        return;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), pause_bh,
+                            (void *)(uintptr_t)background);
+}
