diff --git a/ui/xemu-host-app.swift b/ui/xemu-host-app.swift
new file mode 100644
index 0000000000..a8c6e0b859
--- /dev/null
+++ b/ui/xemu-host-app.swift
@@ -0,0 +1,230 @@
+// The entry point, and now the screen.
+//
+// Measured on 2026-10-29: a spatial controller (the PSVR2 Sense pair)
+// delivers buttons and sticks to an app only while an immersive space is
+// open, and only while the user is not looking at one of the app's
+// windows; gaze on a window turns the controller back into that window's
+// pointer. So there is no window. The app launches straight into a mixed
+// immersive space and the guest's frame is a plane in it, textured from
+// the same BGRA copies the sampler publishes. Everything else stays in
+// the Objective-C shell, reached through xemu-host-bridge.h.
+import SwiftUI
+import RealityKit
+import Metal
+
+@main struct XemuHostApp: App {
+    @UIApplicationDelegateAdaptor(XemuHostAppDelegate.self) var delegate
+
+    /// Reads the controllers on a display link. It is a view controller
+    /// because it was one when the frame lived in a window; its view is
+    /// never shown now and the display link does not care.
+    nonisolated(unsafe) static var ticker: XemuScreenViewController?
+
+    init() {
+        xemu_host_prepare()
+        let vc = XemuScreenViewController()
+        vc.loadViewIfNeeded()
+        XemuHostApp.ticker = vc
+    }
+
+    var body: some SwiftUI.Scene {
+        /*
+         * The default scene, and the only window: a small launcher that
+         * opens the space and dismisses itself. It exists so the app has
+         * something the system can bring back when its icon is tapped
+         * after the space was dismissed (found by the owner: without it
+         * the app could not be reopened), and it is gone while playing so
+         * there is nothing of the app's to look at.
+         */
+        WindowGroup(id: "launcher") {
+            LauncherView()
+        }
+        .defaultSize(width: 480, height: 240)
+
+        ImmersiveSpace(id: "screen") {
+            ScreenSpace()
+                .onAppear {
+                    fputs("[host] immersive space appeared\n", stderr); fflush(stderr)
+                }
+                .onDisappear {
+                    fputs("[host] immersive space disappeared\n", stderr); fflush(stderr)
+                }
+        }
+        .immersionStyle(selection: .constant(.mixed), in: .mixed)
+    }
+}
+
+struct LauncherView: View {
+    @Environment(\.openImmersiveSpace) private var openImmersive
+    @Environment(\.dismissWindow) private var dismissWindow
+    @State private var status = "opening the screen"
+
+    var body: some View {
+        VStack(spacing: 16) {
+            Text("XemuHost").font(.title2)
+            Text(status).foregroundStyle(.secondary)
+            Button("Resume") { Task { await open() } }
+        }
+        .padding(32)
+        .task { await open() }
+    }
+
+    @MainActor private func open() async {
+        let result = await openImmersive(id: "screen")
+        fputs("[host] launcher: immersive space \(result)\n", stderr); fflush(stderr)
+        switch result {
+        case .opened:
+            dismissWindow(id: "launcher")
+        default:
+            status = "could not open the screen (\(result)); try Resume"
+        }
+    }
+}
+
+/// A 4:3 screen two and a half metres ahead at eye height, two metres
+/// wide, fed thirty times a second from the published frame.
+struct ScreenSpace: View {
+    private let screen = GuestScreen()
+
+    var body: some View {
+        RealityView { content in
+            if let entity = screen.makeEntity() {
+                content.add(entity)
+            }
+            screen.start()
+        }
+    }
+}
+
+final class GuestScreen {
+    private var queue: TextureResource.DrawableQueue?
+    private var texture: TextureResource?
+    private var width = 0
+    private var height = 0
+    private var lastSeq: UInt64 = 0
+    private var task: Task<Void, Never>?
+    private var entity: ModelEntity?
+    private var shown: UInt64 = 0
+
+    func makeEntity() -> ModelEntity? {
+        do {
+            try rebuild(width: 640, height: 480)
+        } catch {
+            fputs("[host] screen: texture setup failed: \(error)\n", stderr)
+            return nil
+        }
+        var material = UnlitMaterial()
+        material.color = .init(texture: .init(texture!))
+        let mesh = MeshResource.generatePlane(width: 2.0, height: 1.5)
+        let e = ModelEntity(mesh: mesh, materials: [material])
+        e.position = [0, 1.4, -2.5]
+        entity = e
+        return e
+    }
+
+    /// A texture of the given size, backed by a drawable queue so each
+    /// frame is a copy into the next drawable rather than a new resource.
+    private func rebuild(width w: Int, height h: Int) throws {
+        /* The guest's pixels are sRGB; declared linear they come out with
+         * crushed gradients and lifted blacks. */
+        let desc = TextureResource.DrawableQueue.Descriptor(
+            pixelFormat: .bgra8Unorm_srgb, width: w, height: h,
+            usage: [.shaderRead, .shaderWrite], mipmapsMode: .none)
+        let q = try TextureResource.DrawableQueue(desc)
+        let black = UIImage(color: .black, size: CGSize(width: w, height: h)).cgImage!
+        let t = try TextureResource(image: black, options: .init(semantic: .color))
+        t.replace(withDrawables: q)
+        queue = q
+        texture = t
+        width = w
+        height = h
+        if let e = entity {
+            var material = UnlitMaterial()
+            material.color = .init(texture: .init(t))
+            e.model?.materials = [material]
+        }
+        fputs("[host] screen: \(w)x\(h) texture ready\n", stderr); fflush(stderr)
+    }
+
+    func start() {
+        task?.cancel()
+        task = Task.detached(priority: .userInitiated) { [weak self] in
+            xemu_host_set_metal_present(true)
+            var flips: Int32 = -1
+            var zeroCopy = true
+            while !Task.isCancelled {
+                guard let self else { return }
+                if zeroCopy {
+                    let now = xemu_host_guest_flips()
+                    if now != flips {
+                        flips = now
+                        let r = await self.presentFromGPU()
+                        if r < 0 {
+                            zeroCopy = false
+                            xemu_host_set_metal_present(false)
+                        }
+                    }
+                    try? await Task.sleep(nanoseconds: 2_000_000)
+                } else {
+                    await self.pump()
+                    try? await Task.sleep(nanoseconds: 33_000_000)
+                }
+            }
+        }
+    }
+
+    /// One frame from the renderer into the next drawable, no CPU in the
+    /// way. Rebuilds the queue when the guest changes its scan-out size.
+    @MainActor private func presentFromGPU() async -> Int32 {
+        var w: Int32 = 0, h: Int32 = 0
+        guard xemu_host_present_size(&w, &h), w > 0, h > 0 else { return 0 }
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return 0 }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return 0 }
+        let tex = Unmanaged.passUnretained(drawable.texture).toOpaque()
+        let r = xemu_host_present_frame(tex, w, h)
+        if r == 1 {
+            drawable.present()
+            shown += 1
+            if shown <= 3 || shown % 600 == 0 {
+                fputs("[host] screen: GPU frame \(shown) (\(w)x\(h))\n", stderr)
+                fflush(stderr)
+            }
+        }
+        return r
+    }
+
+    private func pump() {
+        var bgra: UnsafeMutableRawPointer?
+        var w: Int32 = 0, h: Int32 = 0
+        let seq = xemu_host_frame_take(lastSeq, &bgra, &w, &h)
+        guard seq != 0, let pixels = bgra else { return }
+        defer { free(pixels) }
+        lastSeq = seq
+        if Int(w) != width || Int(h) != height {
+            do { try rebuild(width: Int(w), height: Int(h)) } catch { return }
+        }
+        guard let q = queue, let drawable = try? q.nextDrawable() else { return }
+        let region = MTLRegionMake2D(0, 0, Int(w), Int(h))
+        drawable.texture.replace(region: region, mipmapLevel: 0,
+                                 withBytes: pixels, bytesPerRow: Int(w) * 4)
+        drawable.present()
+        shown += 1
+        if shown <= 3 || shown % 300 == 0 {
+            fputs("[host] screen: frame \(shown) (seq \(seq), \(w)x\(h))\n", stderr)
+            fflush(stderr)
+        }
+    }
+}
+
+private extension UIImage {
+    convenience init(color: UIColor, size: CGSize) {
+        let r = UIGraphicsImageRenderer(size: size)
+        let img = r.image { ctx in
+            color.setFill()
+            ctx.fill(CGRect(origin: .zero, size: size))
+        }
+        self.init(cgImage: img.cgImage!)
+    }
+}
