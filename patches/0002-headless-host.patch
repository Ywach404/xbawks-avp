+static void prepare_jit_region(void *addr, size_t size)
+{
+    register void *x0 asm("x0") = addr;
+    register size_t x1 asm("x1") = size;
+
+    /* UTM's legacy JIT26 request: prepare x1 bytes at x0, then detach. */
+    asm volatile("brk #0x69" : : "r"(x0), "r"(x1) : "memory");
+}
+#endif
